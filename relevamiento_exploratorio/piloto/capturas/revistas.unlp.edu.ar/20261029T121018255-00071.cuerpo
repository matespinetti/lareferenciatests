	<dc:source xml:lang="en">SADIO Electronic Journal of Informatics and Operations Research; Vol. 16 (2017): Special Issue dedicated to JAIIO 2016 (Jornadas Argentinas de Informática); 80-94</dc:source>
	<dc:source xml:lang="es">SADIO Electronic Journal of Informatics and Operations Research; Vol. 16 (2017): Special Issue dedicated to JAIIO 2016 (Jornadas Argentinas de Informática); 80-94</dc:source>
	<dc:source>1514-6774</dc:source>
	<dc:language>eng</dc:language>
