	<dc:source xml:lang="en">SADIO Electronic Journal of Informatics and Operations Research; Vol. 17 No. 2 (2018): Special Issue dedicated to JAIIO 2017; 66-82</dc:source>
	<dc:source xml:lang="es">SADIO Electronic Journal of Informatics and Operations Research; Vol. 17 Núm. 2 (2018): Special Issue dedicated to JAIIO 2017; 66-82</dc:source>
	<dc:source>1514-6774</dc:source>
