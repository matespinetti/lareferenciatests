               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Metodología para cuantificar accesibilidad y conveniencia de un sistema de transporte público masivo de pasajeros : aplicación al caso de la ciudad de Córdoba</mods:title>
               </mods:titleInfo>
