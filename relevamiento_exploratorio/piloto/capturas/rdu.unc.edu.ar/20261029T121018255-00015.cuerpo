   <dc:title>Ganglio Centinela Axilar en Cáncer de mama experiencia en 10 años.</dc:title>
   <dc:creator>Latreto, Franco</dc:creator>
   <dc:creator>Zayas, Sofía</dc:creator>
   <dc:creator>Clavijo, Juan Carlos</dc:creator>
   <dc:creator>Valfré, Roberto</dc:creator>
