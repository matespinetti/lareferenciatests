   <dc:title>Investigar en sociales : proyectos, políticas y desafíos</dc:title>
   <dc:title/>
   <dc:creator>Córdoba, Liliana, Comp.</dc:creator>
   <dc:creator>Pividori, María Josefina, Comp.</dc:creator>
   <dc:creator>Batthyány, Karina, pról.</dc:creator>
