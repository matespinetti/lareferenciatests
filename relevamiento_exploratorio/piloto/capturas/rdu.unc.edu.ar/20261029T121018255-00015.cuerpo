</oai_dc:dc></metadata></record><record><header><identifier>oai:rdu.unc.edu.ar:11086/554233</identifier><datestamp>2025-04-28T12:29:22Z</datestamp><setSpec>com_11086_16806</setSpec><setSpec>com_11086_165</setSpec><setSpec>col_11086_552625</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
   <dc:title>El desafío de encontrar estrategias motivadoras para los millennials en el proceso de enseñanza aprendizaje</dc:title>
   <dc:creator>Díaz, Cecilia Beatriz</dc:creator>
