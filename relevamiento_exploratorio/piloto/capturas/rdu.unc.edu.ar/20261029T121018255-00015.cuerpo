</oai_dc:dc></metadata></record><record><header><identifier>oai:rdu.unc.edu.ar:11086/3711</identifier><datestamp>2025-04-23T15:26:42Z</datestamp><setSpec>com_11086_2639</setSpec><setSpec>com_11086_334</setSpec><setSpec>com_11086_167</setSpec><setSpec>col_11086_3689</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
   <dc:title>La magnitud de cambio teórico y la propuesta de Laudan</dc:title>
   <dc:creator>Miguel, Hernán</dc:creator>
   <dc:creator>Paruelo, Jorge</dc:creator>
   <dc:creator>Pissinis, Guillermo</dc:creator>
   <dc:subject>Epistemología</dc:subject>
   <dc:subject>Historia de la ciencia</dc:subject>
   <dc:description>Fil: Miguel, Hernán. Universidad de Buenos Aires; Argentina.</dc:description>
   <dc:description>Fil: Paruelo, Jorge. Universidad de Buenos Aires; Argentina.</dc:description>
   <dc:description>Fil: Paruelo, Jorge. Consejo Nacional de Investigaciones Científicas y Técnicas. Sociedad Argentina de Análisis Filosófico; Argentina.</dc:description>
   <dc:description>Fil: Pissinis, Guillermo. Universidad de Buenos Aires; Argentina.</dc:description>
   <dc:description>En este trabajo exploraremos la articulación de tal graduación con las nociones de Laudan de resolución de problemas, progreso y tasa de progreso. Del análisis podremos concluir si tal graduación podría ser útil para enfrentar la posibilidad de comparar la magnitud de éxito en la resolución de problemas.</dc:description>
   <dc:description>Fil: Miguel, Hernán. Universidad de Buenos Aires; Argentina.</dc:description>
   <dc:description>Fil: Paruelo, Jorge. Universidad de Buenos Aires; Argentina.</dc:description>
   <dc:description>Fil: Paruelo, Jorge. Consejo Nacional de Investigaciones Científicas y Técnicas. Sociedad Argentina de Análisis Filosófico; Argentina.</dc:description>
   <dc:description>Fil: Pissinis, Guillermo. Universidad de Buenos Aires; Argentina.</dc:description>
   <dc:date>2016-09-02T18:53:26Z</dc:date>
   <dc:date>2016-09-02T18:53:26Z</dc:date>
