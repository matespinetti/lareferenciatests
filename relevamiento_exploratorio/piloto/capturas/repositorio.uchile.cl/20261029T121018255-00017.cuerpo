<dc:title>Creatividad en el torbellino: a propósito de un cuento de Allan Poe</dc:title>
<dc:creator>López Pérez, Ricardo</dc:creator>
<dc:date>2014-12-23T12:01:13Z</dc:date>
<dc:date>2014-12-23T12:01:13Z</dc:date>
<dc:date>2006</dc:date>
<dc:type>Artículo de revista</dc:type>
<dc:identifier>REVISTA CHILENA DE LITERATURA Abril 2006, Número 68, 227-240</dc:identifier>
<dc:identifier>https://repositorio.uchile.cl/handle/2250/129471</dc:identifier>
<dc:language>es</dc:language>
<dc:rights>Attribution-NonCommercial-NoDerivs 3.0 Chile</dc:rights>
