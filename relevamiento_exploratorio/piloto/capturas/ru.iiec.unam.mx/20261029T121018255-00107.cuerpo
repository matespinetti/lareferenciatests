    <metadata>
      <oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
        <dc:relation>http://ru.iiec.unam.mx/118/</dc:relation>
        <dc:title>Teoría económica dinámica y planificación</dc:title>
        <dc:creator>Ibarra Corrales, Jorge José</dc:creator>
        <dc:subject>C6 - Métodos matemáticos y programación</dc:subject>
        <dc:subject>C65 - Herramientas matemáticas diversas</dc:subject>
        <dc:subject>C67 - Modelos input-output</dc:subject>
        <dc:description>El trabajo teórico de José Ibarra, basado en un sólido conocimiento de la teoría económica desde la perspectiva de la economía política,crea un modelo matemático para reconstruir la formación histórica del mercado y determina sus limitaciones, de lo que surge la necesidad de la planificación en el desarrollo económico. A partir de los resultados, el autor se propone aplicar su modelo en la reconstrucción del desarrollo económico de alguna economía latinoamericana.</dc:description>
        <dc:publisher>Universidad Nacional Autónoma de México / Instituto de Investigaciones Económicas (IIEc)</dc:publisher>
        <dc:date>2001</dc:date>
        <dc:type>Libro</dc:type>
        <dc:type>PeerReviewed</dc:type>
        <dc:format>image/jpeg</dc:format>
        <dc:language>es</dc:language>
        <dc:identifier>http://ru.iiec.unam.mx/118/2/160TeoEcoDinYPlaTapa.jpg</dc:identifier>
        <dc:format>application/pdf</dc:format>
        <dc:language>es</dc:language>
        <dc:identifier>http://ru.iiec.unam.mx/118/1/TeoEcoDinYPla.pdf</dc:identifier>
        <dc:identifier>   Ibarra Corrales, Jorge José   (2001): Teoría económica dinámica y planificación.    Universidad Nacional Autónoma de México / Instituto de Investigaciones Económicas (IIEc), México, D.F..  ISBN 968-36-9321-0     </dc:identifier></oai_dc:dc></metadata></record>
