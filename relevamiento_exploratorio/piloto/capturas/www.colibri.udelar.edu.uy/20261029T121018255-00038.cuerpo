:"f1018b5e-1376-4ea1-a0f8-31dea653f03c","language":null,"value":"Biblioteca de la Facultad de Ingenieria","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"2f6f0a1e-b589-4b8a-b38e-d26f8807dd47","language":null,"value":"(598) 2714-2714 int 10236","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"d531997e-2971-4810-b074-fbd9c56053c3","language":null,"value":"https://www.fing.edu.uy/biblioteca","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"57bd56bb-0218-4741-b342-c116f42bf09e","language":null,"value":"La Facultad de Ingeniería de la Universidad de la República es la única institución pública de educación superior en ingeniería del Uruguay. Su objetivo es la formación de profesionales capacitados para afrontar las necesidades y demandas del sector productivo, así como contribuir al desarrollo de la sociedad. La Facultad de Ingeniería desarrolla y promueve la investigación en todos los niveles, abarcando las distintas áreas de la Ingeniería, con el objetivo de expandir la cultura y contribuir a la solución de los problemas de la sociedad. Dada la alta especificidad por área que tiene la ingeniería, la misma cuenta con difrentes Institutos que crean y llevan adelante sus propias líneas de investigación.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"d56ca807-6bef-4109-8b7b-645bfbba7921","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"d23e1bee-3621-4111-9e20-05c42a0ec2bc","language":null,"value":"https://hdl.handle.net/20.500.12008/22","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"d5ee7a88-ad0f-48b2-bab6-89a9df58fa89","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual  de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y  por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"21fdc4cd-15af-46dd-8c1a-8264c4f2728a","language":null,"value":"Facultad de Ingeniería","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722631,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/28811f51-7930-4df7-b2e6-6b648f79bb6d":{"data":{"archivedItemsCount":3108,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/28811f51-7930-4df7-b2e6-6b648f79bb6d/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/28811f51-7930-4df7-b2e6-6b648f79bb6d/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/28811f51-7930-4df7-b2e6-6b648f79bb6d/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/28811f51-7930-4df7-b2e6-6b648f79bb6d/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/28811f51-7930-4df7-b2e6-6b648f79bb6d/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/28811f51-7930-4df7-b2e6-6b648f79bb6d"}},"_name":"Facultad de Medicina","id":"28811f51-7930-4df7-b2e6-6b648f79bb6d","uuid":"28811f51-7930-4df7-b2e6-6b648f79bb6d","type":"community","metadata":{"comunidades.correo":[{"uuid":"2bfab014-75bb-45fd-9ab5-5434ef7162e3","language":null,"value":"prestamo@fmed.edu.uy","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"150a3124-bdcd-410a-9771-de2d9f6793a2","language":null,"value":"Avenida General Flores 2125, C.P. 11800, Montevideo - Uruguay","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"4154957e-1bc8-4945-8d02-dbb776d02b98","language":null,"value":"Biblioteca de la Facultad de Medicina","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"053ffef5-4299-4dd7-a656-8eb48f5f3597","language":null,"value":"(598-2) 924 3414 / int. 3466","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"8ad31686-8735-4b6b-b4b4-26bbc1ec619b","language":null,"value":"http://www.biname.fmed.edu.uy/","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"6c5465d6-8f64-4312-a1fd-8090d53c6bf1","language":null,"value":"La Facultad de Medicina de la Universidad de la República tiene como misión la formación, perfeccionamiento y desarrollo de recursos humanos de diversos perfiles profesionales para la promoción, cuidado y rehabilitación de la salud. Su oferta educativa cuenta con cursos de grado, postgrado y educación permanente. Las carreras que se imparten son: Doctor en Medicina, 18 carreras de la Escuela Universitaria de Tecnología Médica, Carreras de la Escuela de Parteras, Licenciatura en Biología Humana y la Licenciatura en Física Médica.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"cad76e3c-e321-4113-b0c1-807a2910b656","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"fabf2538-c019-46ec-91ed-9981fe1a8448","language":null,"value":"https://hdl.handle.net/20.500.12008/31","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"47d6a1bb-df23-4739-b520-dc49246d89a3","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual  de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y  por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"876e5317-5d49-4b9e-b224-f467d008318d","language":null,"value":"Facultad de Medicina","place":0,"