ority":null,"confidence":-1}],"comunidades.web":[{"uuid":"a9bfa3c5-d13f-453d-81de-3afd9aec15e2","language":null,"value":"http://www.bvsodon.org.uy/","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"8eedb36f-ae43-494e-96e9-74d3bc73fcd4","language":null,"value":"La Facultad de Odontología, tiene dentro de sus cometidos las tareas de enseñanza, investigación y extensión orientadas a promover la salud bucal de la población. Los títulos de grado y posgrado que imparte son: Doctor en Odontología, Asistente en Odontología, Laboratorista en Odontología, Higienista Dental.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"363663ea-c203-4e78-a13c-0012f93dc6de","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"bc3dbffb-2f97-4b6c-826c-a02d565001ce","language":null,"value":"https://hdl.handle.net/20.500.12008/33","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"086bb039-cd21-462a-ab5f-8fea88a2b641","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual  de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y  por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"da34f9be-1e9d-449e-9cbb-beddb3f4f48c","language":null,"value":"Facultad de Odontología","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722633,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/0ea48abc-4927-4197-b72e-b3b477286347":{"data":{"archivedItemsCount":3893,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/0ea48abc-4927-4197-b72e-b3b477286347/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/0ea48abc-4927-4197-b72e-b3b477286347/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/0ea48abc-4927-4197-b72e-b3b477286347/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/0ea48abc-4927-4197-b72e-b3b477286347/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/0ea48abc-4927-4197-b72e-b3b477286347/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/0ea48abc-4927-4197-b72e-b3b477286347"}},"_name":"Facultad de Psicología","id":"0ea48abc-4927-4197-b72e-b3b477286347","uuid":"0ea48abc-4927-4197-b72e-b3b477286347","type":"community","metadata":{"comunidades.correo":[{"uuid":"50c56b02-fd8c-45e2-bac1-f92e9c89a402","language":null,"value":"biblio@psico.edu.uy","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"4a17be28-5e1c-4a02-b089-5beb9ab70b2c","language":null,"value":"Tristán Narvaja 1674, C.P. 11200, Montevideo - Uruguay","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"a9a53a17-dc97-4d0b-9e72-cf8d41644035","language":null,"value":"Biblioteca de la Facultad de Psicología","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"b7542d5d-27ed-45b0-87a6-561907a9e5f6","language":null,"value":"(598-2) 400- 8555 / int. 253","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"08529ee2-7c2b-4d32-a30b-d323344ee8c4","language":null,"value":"https://biblioteca.psico.edu.uy/","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"0f57bccb-e519-409b-9e96-dfb84439ac22","language":null,"value":"La Facultad de Psicología, tiene dentro de sus cometidos principales responder a las necesidades y demandas sociales vinculadas a la salud psicológica de la población. Para lo cual, cuenta con diferentes áreas de investigación abocadas a las ramas básicas y aplicadas de la disciplina, que se articulan en torno a distitnos Centros de Investigación: Centro de Investigación en Psicología Clínica, Centro de Investigación Básica en Psicología, y Centro de Investigación en Psicología de la Salud Ocupacional, la Innovación y el Cambio Organizacional.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"22730da3-7b15-477c-95ea-6022c4a36618","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"84e49bcd-4f17-4d82-acf1-46d023b2e70f","language":null,"value":"https://hdl.handle.net/20.500.12008/35","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"f41a8f90-ea61-49df-aa3c-23e8614e31e0","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual  de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y  por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"52e227ed-06b7-40de-b6e1-d282d4444649","language":null,"value":"Facultad de Psicología","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722633,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/44d41236-47cc-4d4e-83df-a9fc7654f08a":{"data":{"archivedItemsCount":747,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/44d41236-47cc-4d4e-83df-a9fc7654f08a/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/44d41236-47cc-4d4e-83df-a9fc7654f08a/logo"},"subcommunities":{"href":"https://www.colibri.udelar.ed