Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"6b29eae1-aa03-4918-896f-c5d39f4d3cbb","language":null,"value":"Libros Udelar","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722636,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/1dff5387-6423-4407-8a7e-7bdf0b1f6514":{"data":{"archivedItemsCount":13,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/1dff5387-6423-4407-8a7e-7bdf0b1f6514/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/1dff5387-6423-4407-8a7e-7bdf0b1f6514/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/1dff5387-6423-4407-8a7e-7bdf0b1f6514/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/1dff5387-6423-4407-8a7e-7bdf0b1f6514/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/1dff5387-6423-4407-8a7e-7bdf0b1f6514/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/1dff5387-6423-4407-8a7e-7bdf0b1f6514"}},"_name":"Observatorio para la Igualdad de Género en la Udelar","id":"1dff5387-6423-4407-8a7e-7bdf0b1f6514","uuid":"1dff5387-6423-4407-8a7e-7bdf0b1f6514","type":"community","metadata":{"comunidades.correo":[{"uuid":"1e870f1f-6d53-4265-9d96-9238dba752f2","language":null,"value":"observatoriogenero@udelar.edu.uy","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"cfe243a0-2b25-4455-b72d-c81da3de70eb","language":null,"value":null,"place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"c4a77616-0aff-4bf1-a1ea-75337d47b83c","language":null,"value":"Observatorio para la Igualdad de Género en la Universidad de la República","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"8f4bcbf9-899c-4a74-8da1-49b330807556","language":null,"value":null,"place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"7fc978c2-f524-4ffe-9628-e879c47589b9","language":null,"value":null,"place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"5728731d-3ccb-4854-b87c-68bc049cf3e3","language":null,"value":"El Observatorio fue creado por la Resolución N° 43 del Consejo Directivo Central de la Universidad de la República el 26 de octubre de 2021, a iniciativa del Centro de Estudios Interdisciplinarios Feministas (CEIFem). Está integrado por CEIFem, Rectorado, Prorrectorado de Gestión, Dirección General de Planeamiento, Dirección General de Personal, Comisión Abierta de Equidad y Género y Red Temática de Género de la Udelar (esta última con un rol consultivo). Su objetivo es producir, analizar y proporcionar información sistemática sobre las desigualdades de género e interseccionales que se manifiestan en la Udelar, la forma en que se integra y transversaliza la perspectiva de género en las funciones universitarias sustantivas -enseñanza, investigación y extensión- así como en la gestión y en las políticas universitarias, con el fin último de contribuir a la superación de estas desigualdades.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"a9acb103-bae9-487f-b181-24e7b8de5f59","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"e74a390d-a494-41b7-ae9c-0b763070dda7","language":null,"value":"https://hdl.handle.net/20.500.12008/52216","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"2895699e-94e9-4109-8d8f-f925f13049e1","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"9968528b-b04e-4535-a11f-8258672ba55b","language":null,"value":"Observatorio para la Igualdad de Género en la Udelar","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722636,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/07cb3fd1-c49b-4656-bbd5-e451d7e28af5":{"data":{"archivedItemsCount":17,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/07cb3fd1-c49b-4656-bbd5-e451d7e28af5/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/07cb3fd1-c49b-4656-bbd5-e451d7e28af5/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/07cb3fd1-c49b-4656-bbd5-e451d7e28af5/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/07cb3fd1-c49b-4656-bbd5-e451d7e28af5/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/07cb3fd1-c49b-4656-bbd5-e451d7e28af5/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/07cb3fd1-c49b-4656-bbd5-e451d7e28af5"}},"_name":"Programa APEX","id":"07cb3fd1-c49b-4656-bbd5-e451d7e28af5","uuid":"07cb3fd1-c49b-4656-bbd5-e451d7e28af5","type":"community","metadata":{"comunidades.correo":[{"uuid":"f13cfe64-6e2b-43e0-ae4e-be0fb22b6b7e","language":null,"value":"info@apex.edu.uy","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"a6d51272-6b79-44eb-993b-dd89a03c46ab","language":null,"value":"Haití 1606, Montevideo, Uruguay","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"a1152a6f-7595-493d-b8d2-b16f1f82b7b6","language":null,"value":null,"place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"45af1ec7-42d5-4401-bde2-d43b883610cf","language":null,"value":"Tel:(598) 2315 24 74","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"7ae9a344-5717-41d0-bc3a-5936bd08f6d3","language":null,"value":"www.apex.edu.uy","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"a05ba8de-e0fb-4a6f-a181-0f52fd2bd83e","language":null,"value":"APEX (Aprendizaje y Extensión) es un Programa integral e interdisciplinario de proyección comunitaria, anclado en la zona oeste de Montevideo (límites del Municipio A). Procura la concurrencia conjunta, integrada y coordinada de los servicios universitarios al espacio comunitario, asociando las funciones universitarias (enseñanza, investigación y extensión) y la asistencia; trabajando en conjunto con instituciones y organizaciones (estatales, de la sociedad civil, vecinas y vecinos). Sus objetivos principales son promover, articular y guiar la inserción de la Universidad en el ámbito comunitario, como espacio educacional formal, aportando al mejoramiento de la calidad de vida de la población a través de la conjunción de las funciones universitarias.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"e20afa17-a90f-4eb9-8dd3-1547b933e492","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"6068be2e-6ee4-41c1-a64f-f042d64e3b2c","language":null,"value":"https://hdl.handle.net/20.500.12008/51725","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"b98edbac-590f-4185-9b32-d3da8f29a5e1","language":null,"value":"Programa APEX","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722637,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/f4972525-4266-48e3-bdcc-1b4395254d93":{"data":{"archivedItemsCount":490,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/f4972525-4266-48e3-bdcc-1b4395254d93/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/f4972525-4266-48e3-bdcc-1b4395254d93/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/f4972525-4266-48e3-bdcc-1b4395254d93/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/f4972525-4266-48e3-bdcc-1b4395254d93/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/f4972525-4266-48e3-bdcc-1b4395254d93/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/f4972525-4266-48e3-bdcc-1b4395254d93"}},"_name":"Prorrectorado de Enseñanza","id":"f4972525-4266-48e3-bdcc-1b4395254d93","uuid":"f4972525-4266-48e3-bdcc-1b4395254d93","type":"community","metadata":{"comunidades.correo":[{"uuid":"80d33aed-63b2-4af5-bbcd-a2a6b628ea0c","language":null,"value":"comunicacion@cse.edu.uy","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"bedfe7de-3955-4a3f-9641-9557148dbb1a","language":null,"value":"Campus Luisi Janicki «Pioneras Universitarias». Alberto Lasplaces 1620, Montevideo, Uruguay","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"089559d0-cdf5-4dea-9c8d-a02bdf15d47e","language":null,"value":"Comisión Sectorial de Enseñanza y Educación Permanente","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"f4c34622-8424-4f53-9008-864c5b48a094","language":null,"value":"(+598) 24008393","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"23b3173b-57cc-4ad9-ae07-ba84f8ee5b0e","language":null,"value":"http://www.cse.udelar.edu.uy","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"79ebdce4-410f-4f87-8ef9-8d4acc4bcb88","language":null,"value":"El Prorrectorado de Enseñanza es espacio central de Udelar donde están integradas las principales líneas universitarias vinculadas con la Enseñanza. Su órgano de Cogobierno es la Comisión Sectorial de Enseñanza y Educación Permanente (CSEEP, anterior CSE), creada en 1993. Tiene como finalidad la coordinación, estímulo y desarrollo de la actividad de enseñanza en la Universidad de la República (Udelar). Algunas de sus atribuciones, según consigna la Ordenanza, son: Asesorar al Consejo Directivo Central (CDC) sobre materia de políticas relacionadas con el desarrollo de la enseñanza, en particular los planes de estudios; promover iniciativas tendientes a fomentar la innovación educativa; impulsar y financiar proyectos (concursables y no concursables) que promuevan el mejoramiento de la enseñanza de grado y el acompañamiento de las generaciones que ingresan a la Udelar, incluida la Enseñanza en contextos de Privación de Libertad; impulsar la formación docente; promover la investigación en temas de educación universitaria; y la promoción, diseño, orientación y fortalecimiento de políticas vinculadas a la Educación Permanente. Establece relaciones de cooperación e intercambio con otras universidades; además, la CSEEP es la encargada de coordinar acciones con la Administración Nacional de Educación Pública (ANEP), con el objetivo de contribuir a la conformación de un sistema educativo nacional integrado. El prorrector/a de Enseñanza integra la delegación universitaria a la Comisión Mixta ANEP/UR, y es corresponsable de coordinar sus actividades.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"e02a46ea-69ef-4dcd-92f3-faaa74408727","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"4ec13e6a-6643-45a0-b294-254db5d63864","language":null,"value":"https://hdl.handle.net/20.500.12008/9230","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"101f2dc0-49f2-4f5f-beb0-bd02ec5d3b93","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"35f70142-d5a5-4cf2-8df0-e2eab46e04f6","language":null,"value":"Prorrectorado de Enseñanza","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722638,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/e7ba4b92-4379-41e3-9060-bde121a666a9":{"data":{"archivedItemsCount":20,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/e7ba4b92-4379-41e3-9060-bde121a666a9/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/e7ba4b92-4379-41e3-9060-bde121a666a9/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/e7ba4b92-4379-41e3-9060-bde121a666a9/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/e7ba4b92-4379-41e3-9060-bde121a666a9/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/e7ba4b92-4379-41e3-9060-bde121a666a9/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/e7ba4b92-4379-41e3-9060-bde121a666a9"}},"_name":"Prorrectorado de Gestión","id":"e7ba4b92-4379-41e3-9060-bde121a666a9","uuid":"e7ba4b92-4379-41e3-9060-bde121a666a9","type":"community","metadata":{"comunidades.correo":[{"uuid":"cd9115f9-cff5-4304-a8a3-38e6c0969610","language":null,"value":"prgestion@udelar.edu.uy","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"a9ef7d18-ce5f-4119-8c93-13741409b01f","language":null,"value":"Campus Luisi Janicki «Pioneras Universitarias». Alberto Lasplaces 1620, Montevideo, Uruguay","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"fd141e97-27d5-421b-89fd-861257d6e959","language":null,"value":"Prorrectorado de Gestión","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"b30324e6-ce25-4781-93c3-0a2a9dd11add","language":null,"value":"(+598) 24008393 int 12","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"70f8cc50-5a36-4e8d-8790-e9fd664b0efd","language":null,"value":"https://gestion.udelar.edu.uy/","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"ebf50a15-9983-4322-bf66-167b290036e3","language":null,"value":"El Prorrectorado de Gestión es un órgano del cogobierno universitario de la Universidad de la República (Udelar), creado en 1999 con el propósito de cumplir con la ordenanza de los cargos de prorrectores. Su función principal es ejecutar las políticas, estrategias y proyectos de gestión, procurando la coordinación y articulación entre los distintos ámbitos y servicios de la comunidad universitaria. En 2019, mediante una resolución del Consejo Directivo Central (CDC), el Prorrectorado modificó su denominación de \"Prorrectorado de Gestión Administrativa\" a \"Prorrectorado de Gestión\", con el fin de reflejar una concepción integral de la gestión universitaria. El Prorrector de Gestión preside el Consejo Delegado de Gestión (CDG), en el cual el CDC delega atribuciones vinculadas a la gestión, con el objetivo de contribuir al ágil funcionamiento del cogobierno y promover la mejora continua de los procesos organizacionales. Actualmente, el Prorrectorado organiza su trabajo en cuatro grandes ejes: Transformación Organizativa, Tecnologías de Gestión y Gobierno Abierto, Gestión de Campus y Escuela de Gobierno.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"9e36879c-ea42-471d-92bf-4703a2e39698","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"7612a964-8a1a-45b5-a69d-a68b5ad3a56e","language":null,"value":"https://hdl.handle.net/20.500.12008/51311","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"01247839-5d18-4187-895b-9f5432036cb5","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"2835fdf3-8866-49a9-85ba-17bce621d3b3","language":null,"value":"Prorrectorado de Gestión","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722638,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/search/top?size=50":{"data":{"type":{"value":"paginated-list"},"pageInfo":{"elementsPerPage":50,"totalElements":32,"totalPages":1,"currentPage":1},"_links":{"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/search/top?size=50"},"page":[{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/251567d5-daae-4040-b45a-e72349494aa5"},{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/8e72dee1-e756-4fe9-86c3-508c972c3026"},{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/66be399e-00fa-419b-bc3d-79e4ad23bfdc"},{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/46bd97ce-b6d5-4df8-a8ae