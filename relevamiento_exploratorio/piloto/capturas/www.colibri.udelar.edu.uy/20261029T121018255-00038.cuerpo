null,"confidence":-1}],"comunidades.telefono":[{"uuid":"558aa3c9-2f2d-481b-b072-91fd9b0464d4","language":null,"value":"(598-2) 411-1815","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"75271843-5470-497c-8fc0-fdfe92ab9c51","language":null,"value":"www.ccee.edu.uy","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"34f88316-fbd2-4cea-a479-4f88caab61fa","language":null,"value":"La Facultad de Ciencias Económicas y de Administración de la Universidad de la República, desarrolla la enseñanza, investigación y extensión en diferentes áreas temáticas que se articulan en torno a la Economía. Dentro de las carreras de grado que ofrece se encuentran: Contador Público, Licenciado en Administración, Licenciado en Economía, Licenciado en Estadística y Técnico en Administración.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"af7e00ad-346c-4960-98eb-3c491e6ef4a5","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"9a4bbd1f-ca50-4e5a-8fc3-2ecc432aaf4c","language":null,"value":"https://hdl.handle.net/20.500.12008/14","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"31f3ddef-05df-453c-81d6-32d5ee85291c","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual  de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y  por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"8156a2c4-e0ab-4bdd-8f01-8ae0f9df4623","language":null,"value":"Facultad de Ciencias Económicas y de Administración","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722627,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/7588e6ae-8576-409b-962e-f95a190e4bf4":{"data":{"archivedItemsCount":7750,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/7588e6ae-8576-409b-962e-f95a190e4bf4/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/7588e6ae-8576-409b-962e-f95a190e4bf4/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/7588e6ae-8576-409b-962e-f95a190e4bf4/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/7588e6ae-8576-409b-962e-f95a190e4bf4/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/7588e6ae-8576-409b-962e-f95a190e4bf4/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/7588e6ae-8576-409b-962e-f95a190e4bf4"}},"_name":"Facultad de Ciencias Sociales","id":"7588e6ae-8576-409b-962e-f95a190e4bf4","uuid":"7588e6ae-8576-409b-962e-f95a190e4bf4","type":"community","metadata":{"comunidades.correo":[{"uuid":"fc431c00-7037-41e8-b7fc-852bb3380a4e","language":null,"value":"biblioteca@cienciassociales.edu.uy","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"e97fe202-eb51-4eee-9dd7-3176210a0d87","language":null,"value":"Constituyente 1502 (subsuelo), C.P. 11200, Montevideo - Uruguay","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"211b7513-ddf8-437e-95dc-ecfacd88c570","language":null,"value":"Biblioteca de la Facultad de Ciencias Sociales","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"f1a44430-eef0-4ff7-a79c-8b2ad5813d1c","language":null,"value":"(598-2) 410-6729","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"9b5e44b4-6ddf-40b1-8420-22ec888a0b80","language":null,"value":"http://cienciassociales.edu.uy/biblioteca/","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"285680f6-3d80-4bca-83fe-6b3cce074126","language":null,"value":"La Facultad de Ciencias Sociales tiene como objetivo promover el desarrollo disciplinario e interdisiciplinario en el ámbito de las Ciencias Sociales, tanto a través de la investigación, como de la docencia de grado y posgrado. La estructura académica de la facultad se compone de seis departamentos y unidades académicas: Departamento de Ciencia Política, Departamento de Sociología, Departamento de Trabajo Social, Departamento de Economía, la Unidad Multidisciplinaria y la Unidad de Estudios Regionales (con sede en Salto). Estas unidades académicas tienen bajo su responsabilidad la investigación y el dictado de cursos de grado y posgrado. A nivel de cursos de grado, la facultad ofrece cinco licenciaturas: Ciencia Política, Sociología, Desarrollo y Trabajo Social, en Montevideo; y Ciencias Sociales y Trabajo Social en Regional Norte, Salto.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"ddbce17b-e8b2-4c9a-a7d7-6fc0334a2460","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"5911ac6a-ce81-4096-bc3f-efaee667af26","language":null,"value":"https://hdl.handle.net/20.500.12008/18","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"7e615c03-de41-4c0f-a231-84b29920d205","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual  de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y  por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"0c798ec3-6772-4778-8490-26c14ceaf60d","language":null,"value":"Facultad de Ciencias Sociales","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722627,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/098d160d-52c7-458b-8a33-beb18fd65be6":{"data":{"archivedItemsCount":1016,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/098d160d-52c7-458b-8a33-beb18fd65be6/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/098d160d-52c7-458b-8a33-beb18fd65be6/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/098d160d-52c7-458b-8a33-beb18fd65be6/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/098d160d-52c7-458b-8a33-beb18fd65be6/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/098d160d-52c7-458b-8a33-beb18fd65be6/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/098d160d-52c7-458b-8a33-beb18fd65be6"}},"_name":"Facultad de Derecho","id":"098d160d-52c7-458b-8a33-beb18fd65be6","uuid":"098d160d-52c7-458b-8a33-beb18fd65be6","type":"community","metadata":{"comunidades.correo":[{"uuid":"e0ae8cba-4613-41cf-8f17-be1d063d2ccc","language":null,"value":"biblioteca.direccion@fder.edu.uy","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"3ab7448f-b6d9-4996-b25a-6463718a971f","language":null,"value":"Av. 18 de Julio 1824, C.P. 11200, Montevideo - Uruguay","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"9b588132-dc7d-4efa-92f9-c664185ae64b","language":null,"value":"Biblioteca de la Facultad de Derecho","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"096351ce-ba44-4dc7-85fc-ec4ebe17b822","language":null,"value":"(598-2) 408-3311 / int. 152","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"01340f97-9acf-418d-8e80-5bedf201dda5","language":null,"value":"https://www.fder.edu.uy/biblioteca/estructura-y-staff","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"3edda34e-5703-4e02-afb5-591243a18c18","language":null,"value":"La Facultad de Derecho de la Universidad de la República creada en 1849, tiene como cometido principal ser garante del ordenamiento jurídico  y defender la importancia de las normas y el respeto del Derecho. En ella se dictan cinco carreras de grado y dos de posgrado: Abogacía, Notariado, Licenciatura en Relaciones Internacionales, Licenciatura en Relaciones Laborales y Traductorado Público, Maestría en Relaciones Internacionales y Maestría en Derecho Internacional Público.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"70d0b279-9d72-4cf2-8d0c-733e6908f31b","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"5ea7470c-10a1-4d2d-b157-096823f49585","language":null,"value":"https://hdl.handle.net/20.500.12008/4615","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"9065a0f7-da45-4ef2-999e-0bfc4035573d","language":null,"value":"Facultad de Derecho","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722628,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/db0a268d-0657-4978-a2ce-47602962b901":{"data":{"archivedItemsCount":1111,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/db0a268d-0657-4978-a2ce-47602962b901/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/db0a268d-0657-4978-a2ce-47602962b901/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/db0a268d-0657-4978-a2ce-47602962b901/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/db0a268d-0657-4978-a2ce-47602962b901/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/db0a268d-0657-4978-a2ce-47602962b901/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/db0a268d-0657-4978-a2ce-47602962b901"}},"_name":"Facultad de Enfermería","id":"db0a268d-0657-4978-a2ce-47602962b901","uuid":"db0a268d-0657-4978-a2ce-47602962b901","type":"community","metadata":{"comunidades.correo":[{"uuid":"e99c3caf-20c3-44df-85b1-365f9ba2e6bb","language":null,"value":"biblioteca@fenf.edu.uy","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"364af2be-2cd5-46ed-b61d-75685a45cf28","language":null,"value":"Av. Dr. Américo Ricaldoni s/n. Edificio Facultad de Enfermería. C.P. 11600, Montevideo - Uruguay","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"a4d9dcfe-ffc7-44c5-b12d-b16f62e9ebc4","language":null,"value":"Biblioteca de la Facultad de Enfermería","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"553ac916-3ea8-4341-acb4-f34e59f5437e","language":null,"value":"(598-2) 2487-0050 interno 630","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"3444c2d8-9a53-4789-aa1d-fe02816ef4cd","language":null,"value":"http://www.fenf.edu.uy","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"cab7ca76-4a00-4978-a547-337f6f90929f","language":null,"value":"La Facultad de Enfermería de la Universidad de la República es la única institución, a nivel público y de educación superior, responsable de la formación de enfermeros profesionales, en el país. Desarrolla las actividades de Enseñanza, Investigación y Extensión en el área de la Enfermería, descentralizadas en Montevideo, Salto, Rivera y Rocha. Su estructura académica la conforman los Departamentos de Educación, Materno-Infantil, Niño, Niña y Adolescente, Adulto y Anciano, Enfermería Comunitaria, Enfermería en Salud Mental, y Administración. Otorga los siguientes títulos de grado: Licenciado en Enfermería, y Auxiliar de Enfermería, las siguientes Maestrías: Atención a la Salud en el Primer Nivel, Salud Mental, y Gestión de Servicios de Salud. Ofrece capacitación en áreas específicas a través de un Programa de Especialidades y desarrolla un Programa de Educación Permanente. Actualmente inició el Programa de Doctorado en Ciencias de la Salud.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"a22db2f1-1a91-4605-ad69-4ec5d6dd5d50","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"f627eb98-908b-4cc8-9c69-456a139e2636","language":null,"value":"https://hdl.handle.net/20.500.12008/20","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"df9b1dad-e9ca-429c-b984-5b36bf69721d","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual  de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y  por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"466d376e-4649-4529-a74f-957a51491d53","language":null,"value":"Facultad de Enfermería","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722629,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/db7cb94d-ace7-4ffe-b235-601cc45246e8":{"data":{"archivedItemsCount":980,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/db7cb94d-ace7-4ffe-b235-601cc45246e8/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/ap