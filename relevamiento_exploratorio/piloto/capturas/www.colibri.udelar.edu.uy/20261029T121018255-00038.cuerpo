integral de la investigación en todas las áreas de conocimiento en la Universidad de la República. Para ello, implementa diversos programas que apuntan al fortalecimiento y estímulo de la investigación en el ámbito universitario.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"e7d4b33f-b88e-4d52-9b47-2e1d2c9857eb","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"fa61629b-ba3c-494a-9329-04a4832d1415","language":null,"value":"https://hdl.handle.net/20.500.12008/41","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"b68b458c-0cb8-4e95-9cdc-94d414042ef7","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual  de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y  por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"2aa3a1ae-7dc8-4f45-a285-9ade4a796f98","language":null,"value":"Comisión Sectorial de Investigación Científica","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722622,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/f1de19bf-63a3-4af8-b929-9ecb4e030054":{"data":{"archivedItemsCount":8664,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/f1de19bf-63a3-4af8-b929-9ecb4e030054/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/f1de19bf-63a3-4af8-b929-9ecb4e030054/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/f1de19bf-63a3-4af8-b929-9ecb4e030054/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/f1de19bf-63a3-4af8-b929-9ecb4e030054/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/f1de19bf-63a3-4af8-b929-9ecb4e030054/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/f1de19bf-63a3-4af8-b929-9ecb4e030054"}},"_name":"Convenios","id":"f1de19bf-63a3-4af8-b929-9ecb4e030054","uuid":"f1de19bf-63a3-4af8-b929-9ecb4e030054","type":"community","metadata":{"comunidades.correo":[{"uuid":"273529a1-2a4a-40b0-b169-72774933f911","language":null,"value":null,"place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"a263e141-d107-4874-ac54-4eae41a8b1fa","language":null,"value":null,"place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"28ee0991-eb00-4681-9bbc-daee7eaab71f","language":null,"value":"\u003Cb> Ver información de contacto en cada Sub Comunidad \u003C/b>","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"61eea574-fa0f-456c-a021-69dd64dbd94b","language":null,"value":null,"place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"2c1913d4-4fef-4316-ad7b-7aef07da12aa","language":null,"value":null,"place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"68f5b728-1f93-4bd6-bec1-e914ef45c24b","language":null,"value":"Esta comunidad reúne los convenios de cooperación que suscribe la Universidad de la República con diferentes organizaciones nacionales e internacionales. También incluye los convenios que realizan las diferentes fundaciones asociadas a la Udelar. Fundación Dr. Eduardo Acevedo, Fundación para el apoyo de las Ciencias Económicas, Fundación Julio Ricaldoni, Centro de Ensayos de Software, Fundación Manuel Pérez, Fundación Dr. Manuel Quintela, Fundación de Ediciones de la Facultad de Medicina, Fundación de apoyo a la Facultad de Odontología, FUNDAQUIM, Fundación Marco Podestá, Asociación Pro Fundación para las Ciencias Sociales, Fundación Desarrollo Regional Salto Grande, Asociación Civil Fundación Universitaria Regional Norte, Fundación para el Desarrollo de las Ciencias Básicas. Los convenios de cooperación nacionales e internacionales son gestionados por el Servicio de Relaciones Internacionales. Los convenios que suscriben las fundaciones son ingresados al repositorio por la Biblioteca de cada Facultad o Servicio.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"c022ab8a-0f2c-4212-8685-a0832d543ad1","language":null,"value":"Reúne los convenios de cooperación que suscribe la Universidad de la República con diferentes organizaciones nacionales e internacionales. Así como los convenios suscriptos por las fundaciones asociadas a la Udelar.","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"d4897247-4bec-4984-ab0b-19c3cfa48535","language":null,"value":"https://hdl.handle.net/20.500.12008/33170","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"78ef0da9-44f6-4893-8c5e-4844c6f2ffd9","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"3fb3000b-029d-42ef-95cf-159efb06559e","language":null,"value":"Convenios","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722622,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/545dc16e-ab9d-4e75-9659-9e5022d6ba24":{"data":{"archivedItemsCount":56,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communiti