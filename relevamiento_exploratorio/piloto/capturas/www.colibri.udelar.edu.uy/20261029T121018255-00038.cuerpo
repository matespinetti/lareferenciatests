d5-daae-4040-b45a-e72349494aa5/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/251567d5-daae-4040-b45a-e72349494aa5/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/251567d5-daae-4040-b45a-e72349494aa5/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/251567d5-daae-4040-b45a-e72349494aa5/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/251567d5-daae-4040-b45a-e72349494aa5/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/251567d5-daae-4040-b45a-e72349494aa5"}},"_name":"Biblioteca Accesible","id":"251567d5-daae-4040-b45a-e72349494aa5","uuid":"251567d5-daae-4040-b45a-e72349494aa5","type":"community","metadata":{"comunidades.correo":[{"uuid":"a250fc8a-c28e-470f-8d01-417e4aec1c26","language":null,"value":null,"place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"9e93d37c-272f-4ac2-828c-36bfc6acfb3b","language":null,"value":"José Enrique Rodó 1854, Montevideo - Uruguay","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"8bc788d4-f4e6-47db-b0c6-1f5927825ebd","language":null,"value":"Programa de Entornos Virtuales de Aprendizaje. Comisión Sectorial de Enseñanza. Universidad de la República. (Colecciones de Primaria y Secundaria)","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"60d8422d-700f-44e3-9a4d-a7acc344db84","language":null,"value":"(598) 24080912 - 24081917 - 24018438 - 24026913","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"2b9ed18d-ad44-4858-a87b-1e01160f1021","language":null,"value":"https://www.bibliotecaaccesible.ei.udelar.edu.uy/","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"079e4ce1-fcf2-4367-b614-db7d10177195","language":null,"value":"La Biblioteca Digital Accesible surge de una alianza entre la Unión Nacional de Ciegos del Uruguay (UNCU) y la Universidad de la República (UDELAR ), con el objetivo de desarrollar la primera Biblioteca Digital Accesible en el marco del Tratado de Marrakech. Esta alianza se orienta a favorecer el acceso en formatos accesibles a los textos de estudio por parte de personas con discapacidad visual. La Biblioteca Digital Accesible está enmarcada en el Tratado de Marrakech, que exige, con estatus de ley, facilitar el acceso a las obras autorales en formatos como el Braille, letra grande y audiolibros para personas ciegas, con discapacidad visual o con otras dificultades para acceder al texto impreso. Al momento ya cuenta con la ratificación de 31 países de los cuales Uruguay fue el primer país Latinoamericano en ratificarlo.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"80008b20-3b0f-4711-82ae-7d42db9efbd6","language":null,"value":"Recursos Accesibles","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"2b4cb13b-1222-4165-b094-3b4963564202","language":null,"value":"https://hdl.handle.net/20.500.12008/9313","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"35b2fe8a-0b2f-4c78-99dc-a5fed93642e3","language":null,"value":"Material elaborado en el marco de la excepción al derecho de autor prevista en el inciso 12 del artículo 45 de la Ley 9.739, por lo que es de uso exclusivo para personas ciegas o con otras dificultades de acceso al texto escrito. Queda prohibida su distribución y puesta a disposición a personas que no tengan la referida discapacidad.","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"2963db0b-e124-4ea8-9196-f65114b8e3c0","language":null,"value":"Biblioteca Accesible","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722620,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/8e72dee1-e756-4fe9-86c3-508c972c3026":{"data":{"archivedItemsCount":132,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/8e72dee1-e756-4fe9-86c3-508c972c3026/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/8e72dee1-e756-4fe9-86c3-508c972c3026/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/8e72dee1-e756-4fe9-86c3-508c972c3026/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/8e72dee1-e756-4fe9-86c3-508c972c3026/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/8e72dee1-e756-4fe9-86c3-508c972c3026/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/8e72dee1-e756-4fe9-86c3-508c972c3026"}},"_name":"CENUR  Noreste","id":"8e72dee1-e756-4fe9-86c3-508c972c3026","uuid":"8e72dee1-e756-4fe9-86c3-508c972c3026","type":"community","metadata":{"comunidades.correo":[{"uuid":"6a08798d-c308-435e-9d90-4ebc690d114b","language":null,"value":"biblioteca@cur.edu.uy (Sede Rivera)\u003Cbr> biblioteca@cut.edu.uy (Sede Tacuarembó)","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"c3572d13-9b0a-4533-9851-cdca20ff4bf7","language":null,"value":"Ruta 5, Km 495 Rivera, Uruguay (Sede Rivera)\u003Cbr>Ruta 5, Km 386 Tacuarembó, Uruguay (Sede Tacuarembó)","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"92a1e1ab-5953-4dcd-9b89-7ab10fde8548","language":null,"value":"Centro Universitario Regional del Noreste","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"165e77bc-7db2-48ab-a029-5a0d9b47ba34","language":null,"value":"4626626313 int. 221-222 (Sede Rivera)\u003Cbr>4633 3485, Internos 275 y 278 (Sede Tacuarembó)","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"dfe89e98-6ebd-425c-bc25-1089ab3aaab3","language":null,"value":"https://biblioteca.noreste.udelar.edu.uy","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"acdd6810-61a2-46f9-9b8c-38f5446edf8c","language":null,"value":"El Centro Universitario Regional del Noreste (CENUR) fue creado en octubre del 2019 en el marco del proceso de descentralización y regionalización llevado adelante por la Universidad de la República. Se trata de una estructura de carácter regional, que incluye diversas sedes: Tacuarembó, Rivera y Cerro Largo. En todas ellas se realizan las tres funciones universitarias: enseñanza, investigación y extensión; concentrando carreras diversas, algunas ellas únicas en el país, grupos académicos de investigación y actividades de vinculación con la sociedad.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"6544f2d2-1c0f-449c-870e-0941c604a911","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"4c4229a3-e0ec-4ab5-a2c6-24adb3462cab","language":null,"value":"https://hdl.handle.net/20.500.12008/29057","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"eccbd6de-54c0-479c-9908-68e104398dfe","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"88cf029a-609e-4094-974c-030409dfabac","language":null,"value":"CENUR  Noreste","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722621,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/66be399e-00fa-419b-bc3d-79e4ad23bfdc":{"data":{"archivedItemsCount":203,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/66be399e-00fa-419b-bc3d-79e4ad23bfdc/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/66be399e-00fa-419b-bc3d-79e4ad23bfdc/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/66be399e-00fa-419b-bc3d-79e4ad23bfdc/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/66be399e-00fa-419b-bc3d-79e4ad23bfdc/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/66be399e-00fa-419b-bc3d-79e4ad23bfdc/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/66be399e-00fa-419b-bc3d-79e4ad23bfdc"}},"_name":"CENUR Este","id":"66be399e-00fa-419b-bc3d-79e4ad23bfdc","uuid":"66be399e-00fa-419b-bc3d-79e4ad23bfdc","type":"community","metadata":{"comunidades.correo":[{"uuid":"792590f6-50ab-4c2d-aecb-e170f3443793","language":null,"value":"Sede Maldonado: biblioteca@cure.edu.uy","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"bd641263-f44a-4451-ac13-811fd46e1fd3","language":null,"value":"Sede Maldonado: Av. Cachimba del Rey entre Bvar. Artigas y Av. Aparicio Saravia. Sede Rocha: Ruta nacional Nº9 intersección con ruta Nº15. Sede Treinta y Tres: Ruta 8 Km. 282 (","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"0265b9db-202b-49ee-9bff-5b5209eb5095","language":null,"value":"Centro Universitario Regional del Este","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"3cf1bf52-84a4-44ff-869d-c21ab6ce1e5e","language":null,"value":"Sede Maldonado: 4225 5326. Sede Rocha: 4472 7001. Sede Treinta y Tres: 4453 0597","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"d5e53bd4-db7b-4a4d-9ea5-f5d8fb509204","language":null,"value":null,"place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"6da1da2e-10a6-4a37-a7f9-5d1a763f4cdf","language":null,"value":"El Centro Universitario Regional del Este (CURE) nace como el resultado del proceso de descentralización realizado por la Udelar para responder a las necesidades y particularidades del interior del país. Su tarea es promover  las actividades de enseñanza, investigación, y extensión. El CURE cuenta con sedes en los departamentos de Maldonado, Rocha, Treinta y Tres y Lavalleja. Estos cuatro departamentos dan forma al Centro Universitario Regional del Este, siguiendo criterios de regionalización establecidos por la Udelar","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"c68b3c1f-c738-471f-b2c6-c9c76c2670b1","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"11222f69-0761-455a-b4f6-f570863e9532","language":null,"value":"https://hdl.handle.net/20.500.12008/31316","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"0a8122b4-98d2-410c-bfb6-d0e98ee05910","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual  de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y  por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"2fb0f7fc-abfb-4ba6-8dde-7d42e130a0f6","language":null,"value":"CENUR Este","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722621,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/46bd97ce-b6d5-4df8-a8ae-533da98f0589":{"data":{"archivedItemsCount":57,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/46bd97ce-b6d5-4df8-a8ae-533da98f0589/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/46bd97ce-b6d5-4df8-a8ae-533da98f0589/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/46bd97ce-b6d5-4df8-a8ae-533da98f0589/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/46bd97ce-b6d5-4df8-a8ae-533da98f0589/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/46bd97ce-b6d5-4df8-a8ae-533da98f0589/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/46bd97ce-b6d5-4df8-a8ae-533da98f0589"}},"_name":"CENUR Litoral Norte","id":"46bd97ce-b6d5-4df8-a8ae-533da98f0589","uuid":"46bd97ce-b6d5-4df8-a8ae-533da98f0589","type":"community","metadata":{"comunidades.correo":[{"uuid":"6e78ba3d-76dd-4269-99a3-89d0f17d6fe1","language":null,"value":"bibliocup@cup.edu.uy  (Sede Paysandú) \u003Cbr> biblioteca@unorte.edu.uy (Sede Salto)","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"59bd0b90-d7c3-4d53-bfb4-26d7c5e46690","language":null,"value":"Florida 1065, Paysandú, Uruguay (Sede Paysandú) \u003Cbr>Gral. Rivera 1350. Salto, Uruguay  (Sede Salto)","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"9390056d-9861-423d-9632-9172cf642a4e","language":null,"value":"CENUR LITORAL NORTE","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"2f6f2f9b-bd96-494e-ab59-0103d80c8148","language":null,"value":"47222291- 47238342 interno 102 (Sede Paysandú) \u003Cbr> 47334816 int. 123 (Sede Salto)","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"027b5173-8d37-4a9f-85db-f84d16fdad11","language":null,"value":null,"place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"35aee055-ae32-44b9-acb9-53615e9058be","language":null,"value":"El Centro Universitario Litoral Norte de la Universidad de la República (Cenur Litoral Norte Udelar) se crea en el año 2013, en el marco del proceso de descentralización y regionalización llevado adelante por la Universidad de la República.\nEstá constituido por dos sedes y dos casas universitarias: el Centro Universitario Local Salto y el Centro Universitario Local Paysandú, la Casa Universitaria Artigas y la Casa Universitaria Río Negro.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"689567ee-0c86-4f46-b7da-b766e8708b5f","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"17caf798-aa00-4d3a-863c-cd5aedc28f98","language":null,"value":"https://hdl.handle.net/20.500.12008/4625","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"6c1b1519-644c-4273-ae8f-5a6d4a2ce580","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual  de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y  por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"ec4f8649-84a2-40f4-89ae-2280666abd42","language":null,"value":"CENUR Litoral Norte","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722622,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/a4732836-6923-4d14-b001-52f99e13f364":{"data":{"archivedItemsCount":394,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/a4732836-6923-4d14-b001-52f99e13f364/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/comm