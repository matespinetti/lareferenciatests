ciaturas de Historia, Filosofía, Lingüística, Letras, Antropología, Ciencias de la Educación, y Turismo, ésta última con un carácter binacional.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"6c33e070-4128-43b7-821e-a67fe7362200","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"f33e5087-18dd-4ddd-9f4f-085ceb8b2a6c","language":null,"value":"https://hdl.handle.net/20.500.12008/4314","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"4b6bf31c-5876-45fa-a22a-e840a8d820f9","language":null,"value":"Facultad de Humanidades y Ciencias de la Educación","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722630,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/03c8c24f-9bb9-4114-9db8-541289f65a85":{"data":{"archivedItemsCount":648,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/03c8c24f-9bb9-4114-9db8-541289f65a85/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/03c8c24f-9bb9-4114-9db8-541289f65a85/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/03c8c24f-9bb9-4114-9db8-541289f65a85/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/03c8c24f-9bb9-4114-9db8-541289f65a85/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/03c8c24f-9bb9-4114-9db8-541289f65a85/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/03c8c24f-9bb9-4114-9db8-541289f65a85"}},"_name":"Facultad de Información y Comunicación","id":"03c8c24f-9bb9-4114-9db8-541289f65a85","uuid":"03c8c24f-9bb9-4114-9db8-541289f65a85","type":"community","metadata":