],"dc.identifier.uri":[{"uuid":"e3896f21-f0f7-463b-a617-a743f3fcee74","language":null,"value":"https://hdl.handle.net/20.500.12008/52329","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"4390ddcb-b800-4381-8706-824b8d77fccf","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"07ee43ff-2165-488b-9bc8-44a0624928a6","language":null,"value":"Documentos Institucionales de la Udelar","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722623,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/4215bdd6-a314-4c3e-aa85-a7953825e8b1":{"data":{"archivedItemsCount":51,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/4215bdd6-a314-4c3e-aa85-a7953825e8b1/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/4215bdd6-a314-4c3e-aa85-a7953825e8b1/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/4215bdd6-a314-4c3e-aa85-a7953825e8b1/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/4215bdd6-a314-4c3e-aa85-a7953825e8b1/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/4215bdd6-a314-4c3e-aa85-a7953825e8b1/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/4215bdd6-a314-4c3e-aa85-a7953825e8b1"}},"_name":"Escuela de Nutrición","id":"4215bdd6-a314-4c3e-aa85-a7953825e8b1","uuid":"4215bdd6-a314-4c3e-aa85-a7953825e8b1","type":"community","metadata":{"comunidades.correo":[{"uuid":"c8b8fa5e-45da-4f17-8e18-b24f13c16b58","language":null,"value":"biblioteca@nutricion.edu.uy","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"6156a433-ac98-478a-9dcf-fa8168518c1a","language":null,"value":"Campus Parque Batlle. Av. Américo Ricaldoni, piso 0","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"26c06a68-dd91-4126-b585-3c421ab44326","language":null,"value":"Biblioteca de la Escuela de Nutrición","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"2ad7d762-6a9a-48ba-93e5-11955147d382","language":null,"value":"(598) 24861323","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"f3a7a449-3ab4-445b-8d10-58843f36c97a","language":null,"value":"http://nutricion.edu.uy/","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"e698f79c-cfb5-4b24-addc-1bd4ff011701","language":null,"value":"La Escuela de Nutrición es un Servicio de la Universidad de la República que tiene por finalidad la formación a nivel de grado del Licenciado en Nutrición, del Técnico Operador de Alimentos y de otras carreras y programas de formación terciaria que oportunamente se aprueben y del posgrado en todos sus niveles. Le compete cumplir con los fines enunciados en la Ley Orgánica de la Universidad en relación con la seguridad alimentaria y nutricional de la población del país, promoviendo el derecho a recibir una alimentación adecuada en calidad y cantidad.  Para ello forma profesionales solventes y ciudadanos responsables que en su práctica presten servicios de calidad en todos los niveles de atención, en la producción e industrialización de alimentos, con impacto tanto a nivel institucional y de la sociedad. Se constituye como un espacio abierto que propicie la formación y el aprendizaje a lo largo de la vida profesional,  buscando la consistencia de todas sus actividades con la ética, la excelencia académica  y el compromiso social.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"949089ba-3e20-4fc4-a2c8-01ccb23bbb19","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"be25c101-b1ec-4246-b41c-d314951482bb","language":null,"value":"https://hdl.handle.net/20.500.12008/9211","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"93492df3-0bc1-4bdd-adb2-a90de9d02571","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual  de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y  por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"f67914c6-2921-4379-b91e-44154db29eea","language":null,"value":"Escuela de Nutrición","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722623,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/a6a83c1f-1bdd-4da7-8461-4d8aafe03419":{"data":{"archivedItemsCount":41,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/a6a83c1f-1bdd-4da7-8461-4d8aafe03419/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/a6a83c1f-1bdd-4da7-8461-4d8aafe03419/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/a6a83c1f-1bdd-4da7-8461-4d8aafe03419/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/a6a83c1f-1bdd-4da7-8461-4d8aafe03419/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/a6a83c1f-1bdd-4da7-8461-4d8aafe03419/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/a6a83c1f-1bdd-4da7-8461-4d8aafe03419"}},"_name":"Espacio Interdisciplinario","id":"a6a83c1f-1bdd-4da7-8461-4d8aafe03419","uuid":"a6a83c1f-1bdd-4da7-8461-4d8aafe03419","type":"community","metadata":{"comunidades.correo":[{"uuid":"c5e9612e-9918-4ea2-bbd1-86eef35a5a92","language":null,"value":"ei@ei.udelar.edu.uy","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"462211d6-8f69-4e43-bf39-776ed9833eb4","language":null,"value":"José E. Rodó 1843 esq.E.Frugoni, C.P. 11200 Montevideo - Uruguay","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"1b79469d-7cb5-4066-8ee0-e8c5508fbd50","language":null,"value":"Biblioteca del Espacio Interdisciplinario","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"2711ea76-3348-43a9-819b-f60df0c02a54","language":null,"value":"(598-2) 408-9010","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"e25ee20d-cb42-4b89-adbd-09c97452bb7b","language":null,"value":"http://www.ei.udelar.edu.uy","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"1be82a10-678c-41ff-b5a5-29c70f31ba3e","language":null,"value":"El Espacio Interdisciplinario (EI) es un servicio destinado a albergar y promover las actividades interdisciplinarias en la Universidad de la República. Creado en 2007 por el Consejo Directivo Central, tiene entre sus objetivos principales contribuir a la construcción de estrategias de trabajo universitario que promuevan el abordaje integral de fenómenos y problemas cuya naturaleza desborda los ámbitos disciplinares. Este objetivo se asume respecto de las tres funciones universitarias de enseñanza, investigación y extensión.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"b4b89dc2-5563-48f8-ab01-188b819a1743","language":null,"value":"","place