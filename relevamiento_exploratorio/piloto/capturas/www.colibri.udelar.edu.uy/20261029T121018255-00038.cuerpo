c.description.abstract":[{"uuid":"c141a00e-efe8-4ccb-acf0-d57bbed91dbe","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"3fde0aac-2cd4-4094-8877-470055e58275","language":null,"value":"https://hdl.handle.net/20.500.12008/37","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"f5aa1ebd-3bfb-4cc5-8203-7f2d6131fa9c","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual  de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y  por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"eb9d2dd3-5d61-40ab-a9c5-4ce12d52d7ba","language":null,"value":"Facultad de Química","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722634,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/a0779b95-43a9-4932-b116-866282e49a57":{"data":{"archivedItemsCount":2746,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/a0779b95-43a9-4932-b116-866282e49a57/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/a0779b95-43a9-4932-b116-866282e49a57/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/a0779b95-43a9-4932-b116-866282e49a57/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/a0779b95-43a9-4932-b116-866282e49a57/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/a0779b95-43a9-4932-b116-866282e49a57/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/a0779b95-43a9-4932-b116-866282e49a57"}},"_name":"Facultad de Veterinaria","id":"a0779b95-43a9-4932-b116-866282e49a57","uuid":"a0779b95-43a9-4932-b116-866282e49a57","type":"community","metadata":{"comunidades.correo":[{"uuid":"94d0f7e5-8a17-4aa4-aa92-a155f5102e54","language":null,"value":"biblioteca@fvet.edu.uy","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"da7ae947-330a-4cf8-9837-d1f52ebf1a5a","language":null,"value":"Ruta 8 km. 18, C.P. 13000, Montevideo - Uruguay","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"cfb58c22-86c4-4592-93de-36506c720c76","language":null,"value":"Biblioteca de la Facultad de Veterinaria","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"49344133-4d54-4dde-a5fb-fed2b78492d6","language":null,"value":"(598-2) 1903-3003","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"5c00ec61-b784-40dd-a04d-8546cb9bac39","language":null,"value":"https://www.fvet.edu.uy/ensenanza/biblioteca/","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"754d9d86-6b2b-40f4-9bfe-9299c9b1cf3d","language":null,"value":"La Facultad de Veterinaria de la Universidad de la República tiene dentro de sus cometidos, crear y difundir el conocimiento en las áreas de la salud animal, especialmente las vinculadas con la salud humana, y la de  formar profesionales competentes para actuar en el campo de las ciencias veterinarias. La facultad otorga los siguientes títulos de grado y postgrado:\r\nDoctor en Ciencias Veterinarias, Asistente en Veterinaria, Ingeniería en Alimentos, Maestría en Nutrición de Rumiantes, Maestría en Producción Animal, Maestría en Reproducción Animal y la Maestría en Salud Animal.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"e6cdb306-47d5-4720-bb38-4be404080e46","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"047be01b-