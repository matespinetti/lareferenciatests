5f5802e/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/346e660b-b31f-4295-b67b-706665f5802e"}},"_name":"Facultad de Agronomía","id":"346e660b-b31f-4295-b67b-706665f5802e","uuid":"346e660b-b31f-4295-b67b-706665f5802e","type":"community","metadata":{"comunidades.correo":[{"uuid":"7d94c053-54f6-4f48-8ed9-7251fe03ed9d","language":null,"value":"biblioteca@fagro.edu.uy","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"1fe2a1c2-3b6f-4191-ab33-90af852d72a2","language":null,"value":"Garzón 780, C.P. 12900 Montevideo - Uruguay","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"5d9ab0ad-c4d9-4167-a623-8d576abed866","language":null,"value":"Biblioteca de la Facultad de Agronomía","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"f6a55486-2c65-48c8-bac1-e64744da33cf","language":null,"value":"2 3566940 int. 136","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"7c8a0791-7fb3-446a-9b09-846a44bc4ca9","language":null,"value":"http://biblioteca.fagro.edu.uy/","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"1213671a-4fa1-471a-a87b-bc6537f071a9","language":null,"value":"La Facultad de Agronomía es una institución pública con liderazgo nacional y reconocimiento regional en educación terciaria y superior en Ciencias Agrarias. Contribuye al desarrollo sostenible del país, basada en la integración de la enseñanza con la investigación, la innovación y la extensión. Su misión se orienta al desarrollo del país formando profesionales con espíritu crítico, compromiso social y sólida base científico-tecnológica en Ciencias Agrarias. También coopera con otras instituciones y organizaciones con responsabilidad de trabajo en este campo para la formación de los cuadros técnicos del Sistema Nacional de Enseñanza, Investigación, Innovación y Extensión.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"d7e38ee1-59ff-49c3-a5b0-ce200257c514","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"790f56fd-8d0f-4f6c-9516-67c486615b9f","language":null,"value":"https://hdl.handle.net/20.500.12008/6","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"133b098e-1c3e-4bf6-8205-7f1d2c7b7787","language":null,"value":"Facultad de Agronomía","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722625,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/e1053892-82b2-4afe-b686-8ea0fc6c5ba7":{"data":{"archivedItemsCount":1678,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/e1053892-82b2-4afe-b686-8ea0fc6c5ba7/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/e1053892-82b2-4afe-b686-8ea0fc6c5ba7/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/e1053892-82b2-4afe-b686-8ea0fc6c5ba7/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/e1053892-82b2-4afe-b686-8ea0fc6c5ba7/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/e1053892-82b2-4afe-b686-8ea0fc6c5ba7/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/e1053892-82b2-4afe-b686-8ea0fc6c5ba7"}},"_name":"Facultad de Arquitectura, Diseño y Urbanismo","id":"e1053892-82b2-4afe-b686-8ea0fc6c5ba7","uuid":"e1053892-82b2-4afe-b686-8ea0fc6c5ba7","type":"community","metadata":{"comunidades.correo":[{"uuid":"a55ee9aa-13c4-4d1b-b8d0-413f1009e2b9","language":null,"value":"biblioteca@fadu.edu.uy","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"77e1a127-0001-43a9-88c7-c4f48bbac230","language":null,"value":"Br. Artigas 1031, C.P. 11200 Montevideo - Uruguay","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"3c835e67-71af-46d6-bf13-13784afdf847","language":null,"value":"Biblioteca de la Facultad de Arquitectura, Diseño y Urbanismo","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"01617da1-5e30-4532-a852-8637c0e94947","language":null,"value":"(598-2) 400-1106/08","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"921a8f4e-00d6-4042-856b-d540776e5a3e","language":null,"value":"https://www.fadu.edu.uy/biblioteca-central/","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"e3e281d8-8bef-453f-92ff-26f29594fd4a","language":null,"value":"La Facultad de Arquitectura, Diseño y Urbanismo (FADU), conocida como Facultad de Arquitectura hasta el 2015, desarrolla distintas propuestas de titulación a nivel de grado y  posgrado, entre ellas se encuentran:  Arquitectura, Licenciatura en Diseño de Comunicación Visual, Licenciatura en Diseño del Paisaje, Licenciatura en Diseño Integrado, Licenciatura en Diseño Industrial. Diploma de Especialización en Intervención en el Patrimonio Arquitectónico, Diploma de Especialización en Investigación Proyectual, Diploma de Especialización en Proyecto de Mobiliario, Diploma de Especialización en Proyecto de Paisaje. Diploma de Especialización en Proyecto de Estructuras, Diploma en Construcción de Obras de Arquitectura , Maestría en Arquitectura, Maestría en Ordenamiento Territorial y Desarrollo Urbano, Maestría en Construcción de Obras de Arquitectura y Doctorado en Arquitectura.\r\n.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"7bd50e1f-d5b1-4f7d-9b08-ca1eb7c8f633","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"20c97420-892c-4e67-a000-81b30996f254","language":null,"value":"https://hdl.handle.net/20.500.12008/4694","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"5a2f2ac6-0253-4e00-9ee9-bdccc60b7419","language":null,"value":"Las obras depositadas en el Repositorio se rigen por la Ordenanza de los Derechos de la Propiedad Intelectual  de la Universidad De La República. (Res. Nº 91 de C.D.C. de 8/III/1994 – D.O. 7/IV/1994) y  por la Ordenanza del Repositorio Abierto de la Universidad de la República (Res. Nº 16 de C.D.C. de 07/10/2014).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"ac5dad71-6a2f-44b1-8182-e8a2ba4254ab","language":null,"value":"Facultad de Arquitectura, Diseño y Urbanismo","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793268722625,"msToLive":900000,"requestUUIDs":["client/68b5f2ec-e99c-4bcb-a9d0-ac44db23bb65"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://www.colibri.udelar.edu.uy/server/api/core/communities/0bd0be50-1d40-4ced-8bfc-dbd70e73ad11":{"data":{"archivedItemsCount":68,"_links":{"collections":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/0bd0be50-1d40-4ced-8bfc-dbd70e73ad11/collections"},"logo":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/0bd0be50-1d40-4ced-8bfc-dbd70e73ad11/logo"},"subcommunities":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/0bd0be50-1d40-4ced-8bfc-dbd70e73ad11/subcommunities"},"parentCommunity":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/0bd0be50-1d40-4ced-8bfc-dbd70e73ad11/parentCommunity"},"adminGroup":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/0bd0be50-1d40-4ced-8bfc-dbd70e73ad11/adminGroup"},"self":{"href":"https://www.colibri.udelar.edu.uy/server/api/core/communities/0bd0be50-1d40-4ced-8bfc-dbd70e73ad11"}},"_name":"Facultad de Artes","id":"0bd0be50-1d40-4ced-8bfc-dbd70e73ad11","uuid":"0bd0be50-1d40-4ced-8bfc-dbd70e73ad11","type":"community","metadata":{"comunidades.correo":[{"uuid":"13b41bcf-5c71-4600-978b-39749390fa68","language":null,"value":"biblioteca@artes.udelar.edu.uy","place":0,"authority":null,"confidence":-1}],"comunidades.direccion":[{"uuid":"b4ff8963-a2d9-4267-b865-8f55bc256836","language":null,"value":"18 de Julio 1772. Planta baja","place":0,"authority":null,"confidence":-1}],"comunidades.nombrecompleto":[{"uuid":"dc355bc4-d7ca-4bda-a9fd-fc2616d891dc","language":null,"value":"Biblioteca de la Facultad de Artes","place":0,"authority":null,"confidence":-1}],"comunidades.telefono":[{"uuid":"91c4b1d5-ce49-4a5b-9beb-ec245f863ca9","language":null,"value":"(598) 2403 6440 / 2403 6441 internos 223 / 226","place":0,"authority":null,"confidence":-1}],"comunidades.web":[{"uuid":"233e2d2f-1274-4ea6-b39a-fdda93860cf2","language":null,"value":"https://www.artes.udelar.edu.uy/biblioteca/","place":0,"authority":null,"confidence":-1}],"dc.description":[{"uuid":"ca64940e-8943-4bb5-9a65-bd2166e2174d","language":null,"value":"La Facultad de Artes es el servicio académico que tiene por fin el desarrollo de las artes en el contexto universitario, a través de las tres funciones (enseñanza, investigación y extensión), en intersección con los múltiples lenguajes que involucra lo artístico.\r\nUna de sus principales características es que surge a partir de la convergencia de servicios existentes y desarrollo de las instituciones, conjugando así las artes visuales, la música, y la danza como parte de las artes escénicas.\r\nEstá estructurada académicamente en los Institutos de Bellas Artes, de Música y de Artes Escénicas.","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"bc6d1670-e576-4a46-8167-3f0b8143c137","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"04f87b60-2c52-44be-a1a8-07c6205528e9","language":null,"value":"https://hdl.handle.net/20.500.12008/37793","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"05cba8e1-d63b-429b-8df4-1772b4410a8f","language":null,"value":"Las obras depositadas en el 