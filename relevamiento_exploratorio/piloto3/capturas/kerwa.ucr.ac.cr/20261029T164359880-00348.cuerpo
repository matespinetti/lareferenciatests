-4111-931e-a3581259d4fb/relationships"},"version":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/a0eca249-57ed-4111-931e-a3581259d4fb/version"},"templateItemOf":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/a0eca249-57ed-4111-931e-a3581259d4fb/templateItemOf"},"thumbnail":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/a0eca249-57ed-4111-931e-a3581259d4fb/thumbnail"},"submitter":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/a0eca249-57ed-4111-931e-a3581259d4fb/submitter"},"self":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/a0eca249-57ed-4111-931e-a3581259d4fb"}},"_name":"Occurrence of cryptosporidium sp. in fresh produce from the metropolitan area of Costa Rica: an update","id":"a0eca249-57ed-4111-931e-a3581259d4fb","uuid":"a0eca249-57ed-4111-931e-a3581259d4fb","type":"item","metadata":{"dc.creator":[{"uuid":"b6242148-1614-4c5b-b23a-2bf96ffbe7fb","language":null,"value":"Murillo Salas, Nelly","place":0,"authority":null,"confidence":-1},{"uuid":"c14c1f5a-dc70-4f56-8f9b-9775e9774865","language":null,"value":"Alvarado Ocampo, Johan","place":1,"authority":null,"confidence":-1},{"uuid":"53041240-4d0a-4f34-b6f8-e17625779059","language":null,"value":"Abrahams Sandí, Elizabeth","place":2,"authority":null,"confidence":-1},{"uuid":"ea4257b7-a2ed-4df2-9e37-cd4f15abbb24","language":null,"value":"Retana Moreira, Lissette","place":3,"authority":null,"confidence":-1},{"uuid":"0822e271-187d-439c-b403-51f072c7af0b","language":null,"value":"Chaves Ulate, Carolina","place":4,"authority":null,"confidence":-1}],"dc.date.accessioned":[{"uuid":"cf8f0b68-9b08-4ac0-844d-b5270e1bd401","language":null,"value":"2026-10-28T20:23:27Z","place":0,"authority":null,"confidence":-1}],"dc.date.issued":[{"uuid":"65d2084e-9d61-46d8-99e8-46174f89ba58","language":null,"value":"2026","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"1c47fae6-3dc0-4f11-8676-d0ae0ee512c1","language":null,"value":"Foodborne diseases represent a major global public health problem, causing significant morbidity and mortality, and substantial economic losses. Fruits and vegetables are considered among the main vehicles for transmission of infectious agents like bacteria, viruses, fungi and parasites, including Cryptosporidium sp. This protozoan parasite comprises many species that infect a wide range of hosts, is environmentally and geographically ubiquitous and has become one of the leading causes of diarrheal disease; in immunocompromised hosts, the infection can result in a chronic, life-threatening disease. Considering the importance of fruit and vegetable consumption in the daily diet and the need to ensure their safety, the aim of the study was to evaluate the presence of Cryptosporidium sp. in strawberries, lettuce and cilantro marketed in the Metropolitan Area of Costa Rica and to assess the degree of faecal contamination in these foods. For this purpose, 96 samples were analysed using parasitological and molecular methods that included a nested PCR to amplify Cryptosporidium sp. gp60 gene. Moreover, the presence of total and thermotolerant coliforms and Escherichia coli was also determined by culture methods and counts, for further identification using the VITEK system. Direct examination of wet mount and Ziehl-Neelsen stains revealed five Cryptosporidium sp. positive samples by microscopy and 22 positive samples by PCR; the identified species was Cryptosporidium parvum. Cilantro samples presented the highest counts of total, and thermotolerant coliforms and E. coli was identified in14 samples among 82 samples subjected to bacteriological analyses. The detection of C. parvum in raw vegetables and fruits from different provinces in Costa Rica, particularly using molecular techniques, demonstrates the need to strengthen surveillance and control in the production and marketing of these foods, to improve risk assessment and its relevance to public health.","place":0,"authority":null,"confidence":-1}],"dc.description.procedence":[{"uuid":"9b7e22a4-ff59-4b90-aadd-dea3c3f060d6","language":null,"value":"Vicerrectoría de Docencia::Salud::Facultad de Microbiología","place":0,"authority":"ucr:FMi","confidence":600},{"uuid":"419ec200-f156-4e30-97f3-2e7e7dff5ee0","language":null,"value":"Vicerrectoría de Investigación::Unidades de Investigación::Ciencias de la Salud::Centro de Investigación en Enfermedades Tropicales (CIET)","place":1,"authority":"ucr:UI-S-2","confidence":600}],"dc.description.sponsorship":[{"uuid":"80a09200-2cc5-4392-91ff-080e1a34fc2c","language":null,"value":"Centro de Investigación en Enfermedades Tropicales/[803-C3128]/CIET/Costa Rica","place":0,"authority":null,"confidence":-1}],"dc.identifier.citation":[{"uuid":"03562cbe-aa62-4fb4-8d1c-4bd634a5310e","language":null,"value":"https://www.sciencedirect.com/journal/journal-of-food-protection","place":0,"authority":null,"confidence":-1}],"dc.identifier.codproyecto":[{"uuid":"7524e8cf-ae6c-49c6-92fd-f7c8a448ee00","language":null,"value":"803-C3128","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"93c1e4e6-ab5f-4df9-be1c-95d25834ef72","language":null,"value":"https://hdl.handle.net/10669/105340","place":0,"authority":null,"confidence":-1}],"dc.language.iso":[{"uuid":"1632a06a-780c-49ca-ad78-3dd1da43245e","language":null,"value":"eng","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"a979f641-3ce6-4630-a9fb-044cc6b7eba5","language":null,"value":"acceso abierto","place":0,"authority":null,"confidence":-1}],"dc.source":[{"uuid":"b93be5cb-1107-4f68-88b7-9bc45fcd7c8e","language":null,"value":"Journal of Food Protection","place":0,"authority":null,"confidence":-1}],"dc.subject":[{"uuid":"6e5af395-0173-4123-ba58-789a1c6fe3b9","language":null,"value":"Cryptosporidium sp.","place":0,"authority":null,"confidence":-1},{"uuid":"e471065e-2ce3-4daa-bfee-feaa320887d3","language":null,"value":"fresh produce","place":1,"authority":null,"confidence":-1},{"uuid":"4cfa64cd-021d-405b-9a9f-18fc886d5df1","language":null,"value":"coliforms","place":2,"authority":null,"confidence":-1},{"uuid":"071d0ce4-2381-4361-b7d5-c665fd191317","language":null,"value":"Metropolitan Area","place":3,"authority":null,"confidence":-1},{"uuid":"22de1666-2bb1-4c15-a459-592936aa29af","language":null,"value":"PCR","place":4,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"b3dc7ae6-ac0d-4f39-89ea-22ce128b0f67","language":null,"value":"Occurrence of cryptosporidium sp. in fresh produce from the metropolitan area of Costa Rica: an update","place":0,"authority":null,"confidence":-1}],"dc.type":[{"uuid":"95b6077d-84a0-498a-b051-d1d73265d319","language":null,"value":"artículo preliminar","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793292828131,"msToLive":900000,"requestUUIDs":["client/f9b9b344-8697-4028-a67f-101decbd6798"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://repositorio.ucr.ac.cr/server/api/discover/search/objects?dsoType=ITEM&sort=dc.date.accessioned,DESC&size=5":{"data":{"type":{"value":"discovery-objects"},"page":[{"type":{"value":"searchresult"},"hitHighlights":{},"_links":{"indexableObject":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/bf7056bb-1ae6-4aac-957d-fbf39499ba2b"}},"_embedded":{"indexableObject":{"id":"bf7056bb-1ae6-4aac-957d-fbf39499ba2b","uuid":"bf7056bb-1ae6-4aac-957d-fbf39499ba2b","name":"Exploring the neighborhood of thermotolerant free-living amoebae in Costa Rican natural water reservoirs as a preliminary One Health approach in the field","handle":"10669/105344","metadata":{"dc.creator":[{"value":"Alvarado Ocampo, Johan","language":null,"authority":null,"confidence":-1,"place":0},{"value":"Castro Gutiérrez, Víctor","language":null,"authority":null,"confidence":-1,"place":1},{"value":"Ruiz Campos, Marco","language":null,"authority":null,"confidence":-1,"place":2},{"value":"Chaves Monge, Frida","language":null,"authority":null,"confidence":-1,"place":3},{"value":"Silva Mena, Kevin","language":null,"authority":null,"confidence":-1,"place":4},{"value":"Córdoba Gamboa, Leonel","language":null,"authority":null,"confidence":-1,"place":5},{"value":"Abrahams Sandí, Elizabeth","language":null,"authority":null,"confidence":-1,"place":6},{"value":"Retana Moreira, Lissette","language":null,"authority":null,"confidence":-1,"place":7}],"dc.date.accessioned":[{"value":"2026-10-28T22:18:49Z","language":null,"authority":null,"confidence":-1,"place":0}],"dc.date.issued":[{"value":"2026","language":null,"authority":null,"confidence":-1,"place":0}],"dc.description.abstract":[{"value":"Free-living amoebae (FLA) of the Vahlkampfiidae family are widely distributed in nature, occupying aquatic and terrestrial habitats. The group includes thermophilic amphizoic organisms such as Naegleria fowleri. This study aims to describe natural recreational freshwaters in terms of the presence of thermotolerant vahlkampfiids, sediment microbial communities and climatic/land use features.  Water samples were collected from 24 locations from Costa Rica. DNA was extracted from FLA cultivated at 42 °C and molecular identification using family and N. fowleri species-specific primers for conventional PCR was performed. DNA extractions of sediment samples were also performed for a microbial metabarcoding characterization approach through 16S rRNA V3-V4 region and 18S rRNA V4 region gene amplicons sequencing. A geographic information system was used to locate each sampling site in its respective climatic subregion and to establish a land use coverage buffer around it. Results revealed 20 positive locations for vahlkampfiids; the sites predominantly featured forest cover and were in climatic subregions with significant rainfall patterns. All locations were negative for N. fowleri; however, identification by sequencing detected a predominance of Tetramitus spp., followed by Vahlkampfia sp. and Neovahlkampfia sp. Sediment metabarcoding showed mainly metazoans, microalgae and Proteobacteria in these benthic ecosystems. Even when N. fowleri was not found, our exploration showed that these aquatic environments of close human contact allow the presence of thermotolerant vahlkampfiids and might be surrounded by microbial communities of interest for future research regarding ecological interactions and public health risks.","language":null,"authority":null,"confidence":-1,"place":0}],"dc.description.procedence":[{"value":"Vicerrectoría de Docencia::Salud::Facultad de Microbiología","language":null,"authority":"ucr:FMi","confidence":600,"place":0},{"value":"Vicerrectoría de Investigación::Unidades de Investigación::Ciencias de la Salud::Centro de Investigación en Enfermedades Tropicales (CIET)","language":null,"authority":"ucr:UI-S-2","confidence":600,"place":1},{"value":"Vicerrectoría de Investigación::Unidades de Investigación::Ciencias Básicas::Centro en Investigación en Contaminación Ambiental (CICA)","language":null,"authority":"ucr:UI-CB-13","confidence":600,"place":2}],"dc.description.sponsorship":[{"value":"Centro de Investigación en Enfermedades Tropicales/[803-C3513]/CIET/Costa Rica","language":null,"authority":null,"confidence":-1,"place":0}],"dc.identifier.citation":[{"value":"www.frontiersin.org/journals/microbiology","language":null,"authority":null,"confidence":-1,"place":0}],"dc.identifier.doi":[{"value":"803-C3513","language":null,"authority":null,"confidence":-1,"place":0}],"dc.identifier.uri":[{"value":"https://hdl.handle.net/10669/105344","language":null,"authority":null,"confidence":-1,"place":0}],"dc.language.iso":[{"value":"eng","language":null,"authority":null,"confidence":-1,"place":0}],"dc.rights":[{"value":"acceso abierto","language":null,"authority":null,"confidence":-1,"place":0}],"dc.source":[{"value":"Frontiers in Microbiology","language":null,"authority":null,"confidence":-1,"place":0}],"dc.subject":[{"value":"Vahlkampfiidae","language":null,"authority":null,"confidence":-1,"place":0},{"value":"Naegleria","language":null,"authority":null,"confidence":-1,"place":1},{"value":"climate","language":null,"authority":null,"confidence":-1,"place":2},{"value":"land use","language":null,"authority":null,"confidence":-1,"place":3},{"value":"metabarcoding.","language":null,"authority":null,"confidence":-1,"place":4}],"dc.title":[{"value":"Exploring the neighborhood of thermotolerant free-living amoebae in Costa Rican natural water reservoirs as a preliminary One Health approach in the field","language":null,"authority":null,"confidence":-1,"place":0}],"dc.type":[{"value":"artículo preliminar","language":null,"authority":null,"confidence":-1,"place":0}]},"inArchive":true,"discoverable":true,"withdrawn":false,"lastModified":"2026-10-29T03:05:27.905777Z","entityType":null,"type":"item","uniqueType":"core.item","_links":{"accessStatus":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/bf7056bb-1ae6-4aac-957d-fbf39499ba2b/accessStatus"},"bundles":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/bf7056bb-1ae6-4aac-957d-fbf39499ba2b/bundles"},"identifiers":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/bf7056bb-1ae6-4aac-957d-fbf39499ba2b/identifiers"},"mappedCollections":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/bf7056bb-1ae6-4aac-957d-fbf39499ba2b/mappedCollections"},"owningCollection":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/bf7056bb-1ae6-4aac-957d-fbf39499ba2b/owningCollection"},"relationships":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/bf7056bb-1ae6-4aac-957d-fbf39499ba2b/relationships"},"version":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/bf7056bb-1ae6-4aac-957d-fbf39499ba2b/version"},"templateItemOf":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/bf7056bb-1ae6-4aac-957d-fbf39499ba2b/templateItemOf"},"thumbnail":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/bf7056bb-1ae6-4aac-957d-fbf39499ba2b/thumbnail"},"submitter":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/bf7056bb-1ae6-4aac-957d-fbf39499ba2b/submitter"},"self":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/bf7056bb-1ae6-4aac-957d-fbf39499ba2b"}},"_embedded":{"thumbnail":{"id":"1ed117ff-8ec5-4737-ad63-10f696211ca0","uuid":"1ed117ff-8ec5-4737-ad63-10f696211ca0","name":"Revised manuscript 2003349_10.18.26.pdf.jpg","handle":null,"metadata":{"dc.description":[{"value":"Generated Thumbnail","language":null,"authority":null,"confidence":-1,"place":0}],"dc.source":[{"value":"Written by FormatFilter org.dspace.app.mediafilter.PDFBoxThumbnail on 2026-10-29T03:05:27Z (GMT).","language":null,"authority":null,"confidence":-1,"place":0}],"dc.title":[{"value":"Revised manuscript 2003349_10.18.26.pdf.jpg","language":null,"authority":null,"confidence":-1,"place":0}]},"bundleName":"THUMBNAIL","sizeBytes":6074,"checkSum":{"checkSumAlgorithm":"MD5","value":"8641745faa8f56fcd80a7bab869d36d4"},"sequenceId":4,"type":"bitstream","uniqueType":"core.bitstream","_links":{"content":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/1ed117ff-8ec5-4737-ad63-10f696211ca0/content"},"bundle":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/1ed117ff-8ec5-4737-ad63-10f696211ca0/bundle"},"accessStatus":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/1ed117ff-8ec5-4737-ad63-10f696211ca0/accessStatus"},"format":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/1ed117ff-8ec5-4737-ad63-10f696211ca0/format"},"thumbnail":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/1ed117ff-8ec5-4737-ad63-10f696211ca0/thumbnail"},"self":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/1ed117ff-8ec5-4737-ad63-10f696211ca0"}}}}}}},{"type":{"value":"searchresult"},"hitHighlights":{},"_links":{"indexableObject":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/28aa27f5-bd6e-4d30-bd7e-f950e531e9a9"}},"_embedded":{"indexableObject":{"id":"28aa27f5-bd6e-4d30-bd7e-f950e531e9a9","uuid":"28aa27f5-bd6e-4d30-bd7e-f950e531e9a9","name":"Dolarización financiera y rentabilidad bancaria en Costa Rica: un análisis empírico del impacto de la especialización en productos en dólares con enfoque econométrico y regulatorio","handle":"10669/105343","metadata":{"dc.contributor.advisor":[{"value":"Cantillo Simón, Miguel","language":null,"authority":null,"confidence":-1,"place":0}],"dc.creator":[{"value":"Abarca Chinchilla, Óscar Eduardo","language":null,"authority":null,"confidence":-1,"place":0},{"value":"Astorga Hernández, Édgar Eduardo","language":null,"authority":null,"confidence":-1,"place":1},{"value":"Castillo Castro, César Augusto","language":null,"authority":null,"confidence":-1,"place":2}],"dc.date.accessioned":[{"value":"2026-10-28T21:21:20Z","language":null,"authority":null,"confidence":-1,"place":0}],"dc.date.issued":[{"value":"2026","language":null,"authority":null,"confidence":-1,"place":0}],"dc.description.abstract":[{"value":"Esta investigación analiza la relación entre el grado de especialización en productos financieros denominados en dólares y la rentabilidad de los bancos comerciales costarricenses entre enero del 2008 y diciembre del 2025. Combina un análisis descriptivo, la estimación de un panel dinámico de coeficientes heterogéneos con dependencia transversal mediante el enfoque Common Correlated Effects Mean Group (CCEMG) de Chudik y Pesaran (2015) —complementada con ejercicios de robustez de efectos fijos dinámicos y errores estándar de Driscoll y Kraay (1998)— y una discusión regulatoria comparada. Como variable dependiente se utiliza un ROE ajustado que aísla el efecto contable de la revaluación cambiaria. La evidencia descriptiva muestra una diferenciación estructural persistente entre bancos públicos y privados, con posiciones cambiarias y carteras en dólares mayores en estos últimos. Los resultados econométricos indican que la dolarización de la cartera no es un determinante significativo del ROE a nivel sistémico; la rentabilidad se explica consistentemente por la persistencia del ROE, la capitalización y la eficiencia operativa, destacando la diversificación de ingresos como el determinante de mayor impacto positivo. Además, un aumento de 1 p.p. en la tasa de depreciación mensual del colón reduce el ROE operativo en 0.18 p.p., aun tras aislar la revaluación contable. Así, el crédito en dólares opera más como instrumento de captación y fidelización de clientes que como fuente de rédito: la banca privada asume riesgos cambiarios y crediticios significativos sin una contraprestación clara en el retorno ajustado por riesgo. A la luz de la experiencia de Turquía, Uruguay y Ecuador, ello refuerza la necesidad de fortalecer el marco prudencial costarricense, en particular la prueba de tensión BUST aplicada por la SUGEF.","language":null,"authority":null,"confidence":-1,"place":0},{"value":"This research analyzes the relationship between the degree of specialization in U.S. dollardenominated financial products and the profitability of Costa Rican commercial banks from January 2008 to December 2025. It combines a descriptive analysis, the estimation of a dynamic heterogeneous-coefficient panel with cross-sectional dependence using the Common Correlated Effects Mean Group (CCEMG) approach of Chudik and Pesaran (2015) —complemented by robustness exercises with dynamic fixed effects and Driscoll and Kraay (1998) standard errors— and a comparative regulatory discussion. The dependent variable is an adjusted ROE that isolates the accounting effect of exchange rate revaluation. The descriptive evidence shows a persistent structural differentiation between public and private banks, with larger foreign exchange positions and dollar portfolios in the latter. The econometric results indicate that loan portfolio dollarization is not a significant determinant of ROE at the systemic level; profitability is consistently explained by ROE persistence, capitalization, and operating efficiency, with income diversification standing out as the determinant with the largest positive impact. Moreover, a 1 p.p. increase in the monthly depreciation rate of the colón lowers operating ROE by 0.18 p.p., even after isolating the accounting revaluation. Dollar lending thus operates more as an instrument for customer acquisition and retention than as a source of return: private banks assume significant foreign exchange and credit risks without a clear counterpart in risk-adjusted returns. In light of the experience of Turkey, Uruguay, and Ecuador, this reinforces the need to strengthen the Costa Rican prudential framework, particularly the BUST stress test applied by SUGEF.","language":null,"authority":null,"confidence":-1,"place":1}],"dc.description.procedence":[{"value":"Vicerrectoría de Docencia::Ciencias Sociales::Facultad de Ciencias Económicas::Escuela de Economía","language":null,"authority":"ucr:FCE3","confidence":600,"place":0},{"value":"Vicerrectoría de Investigación::Sistema de Estudios de Posgrado::Ciencias Sociales::Maestría Profesional en Finanzas y Riesgo","language":null,"authority":"ucr:SEP-CS-98","confidence":600,"place":1}],"dc.identifier.uri":[{"value":"https://hdl.handle.net/10669/105343","language":null,"authority":null,"confidence":-1,"place":0}],"dc.language.iso":[{"value":"spa","language":null,"authority":null,"confidence":-1,"place":0}],"dc.rights":[{"value":"acceso abierto","language":null,"authority":null,"confidence":-1,"place":0}],"dc.source":[{"value":"San José, Costa Rica: Universidad de Costa Rica.","language":null,"authority":null,"confidence":-1,"place":0}],"dc.subject":[{"value":"Dolarización financiera","language":null,"authority":null,"confidence":-1,"place":0},{"value":"Rentabilidad bancaria","language":null,"authority":null,"confidence":-1,"place":1},{"value":"Riesgo cambiario","language":null,"authority":null,"confidence":-1,"place":2},{"value":"Descalce cambiario","language":null,"authority":null,"confidence":-1,"place":3},{"value":"Panel dinámico heterogéneo","language":null,"authority":null,"confidence":-1,"place":4},{"value":"Regulación prudencial","language":null,"authority":null,"confidence":-1,"place":5},{"value":"Costa Rica","language":null,"authority":null,"confidence":-1,"place":6},{"value":"Financial dollarization","language":null,"authority":null,"confidence":-1,"place":7},{"value":"Bank profitability","language":null,"authority":null,"confidence":-1,"place":8},{"value":"Foreign exchange risk","language":null,"authority":null,"confidence":-1,"place":9},{"value":"Currency mismatch","language":null,"authority":null,"confidence":-1,"place":10},{"value":"Heterogeneous dynamic panel","language":null,"authority":null,"confidence":-1,"place":11},{"value":"Common Correlated Effects Mean Group (CCEMG)","language":null,"authority":null,"confidence":-1,"place":12},{"value":"Prudential regulation","language":null,"authority":null,"confidence":-1,"place":13}],"dc.title":[{"value":"Dolarización financiera y rentabilidad bancaria en Costa Rica: un análisis empírico del impacto de la especialización en productos en dólares con enfoque econométrico y regulatorio","language":null,"authority":null,"confidence":-1,"place":0}],"dc.type":[{"value":"tesis de maestría","language":null,"authority":null,"confidence":-1,"place":0}]},"inArchive":true,"discoverable":true,"withdrawn":false,"lastModified":"2026-10-29T03:01:05.853382Z","entityType":null,"type":"item","uniqueType":"core.item","_links":{"accessStatus":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/28aa27f5-bd6e-4d30-bd7e-f950e531e9a9/accessStatus"},"bundles":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/28aa27f5-bd6e-4d30-bd7e-f950e531e9a9/bundles"},"identifiers":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/28aa27f5-bd6e-4d30-bd7e-f950e531e9a9/identifiers"},"mappedCollections":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/28aa27f5-bd6e-4d30-bd7e-f950e531e9a9/mappedCollections"},"owningCollection":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/28aa27f5-bd6e-4d30-bd7e-f950e531e9a9/owningCollection"},"relationships":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/28aa27f5-bd6e-4d30-bd7e-f950e531e9a9/relationships"},"version":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/28aa27f5-bd6e-4d30-bd7e-f950e531e9a9/version"},"templateItemOf":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/28aa27f5-bd6e-4d30-bd7e-f950e531e9a9/templateItemOf"},"thumbnail":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/28aa27f5-bd6e-4d30-bd7e-f950e531e9a9/thumbnail"},"submitter":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/28aa27f5-bd6e-4d30-bd7e-f950e531e9a9/submitter"},"self":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/28aa27f5-bd6e-4d30-bd7e-f950e531e9a9"}},"_embedded":{"thumbnail":{"id":"24aefd14-3e50-4343-b1b7-d497bebc0f48","uuid":"24aefd14-3e50-4343-b1b7-d497bebc0f48","name":"Dolarización financiera y rentabilidad bancaria en Costa Rica.pdf.jpg","handle":null,"metadata":{"dc.description":[{"value":"Generated Thumbnail","language":null,"authority":null,"confidence":-1,"place":0}],"dc.source":[{"value":"Written by FormatFilter org.dspace.app.mediafilter.PDFBoxThumbnail on 2026-10-29T03:01:05Z (GMT).","language":null,"authority":null,"confidence":-1,"place":0}],"dc.title":[{"value":"Dolarización financiera y rentabilidad bancaria en Costa Rica.pdf.jpg","language":null,"authority":null,"confidence":-1,"place":0}]},"bundleName":"THUMBNAIL","sizeBytes":3065,"checkSum":{"checkSumAlgorithm":"MD5","value":"cf54608c0ae277d4e44e1457ba036dbb"},"sequenceId":4,"type":"bitstream","uniqueType":"core.bitstream","_links":{"content":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/24aefd14-3e50-4343-b1b7-d497bebc0f48/content"},"bundle":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/24aefd14-3e50-4343-b1b7-d497bebc0f48/bundle"},"accessStatus":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/24aefd14-3e50-4343-b1b7-d497bebc0f48/accessStatus"},"format":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/24aefd14-3e50-4343-b1b7-d497bebc0f48/format"},"thumbnail":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/24aefd14-3e50-4343-b1b7-d497bebc0f48/thumbnail"},"self":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/24aefd14-3e50-4343-b1b7-d497bebc0f48"}}}}}}},{"type":{"value":"searchresult"},"hitHighlights":{},"_links":{"indexableObject":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/251bc755-84ba-4d84-ad41-6e8139d0c3df"}},"_embedded":{"indexableObject":{"id":"251bc755-84ba-4d84-ad41-6e8139d0c3df","uuid":"251bc755-84ba-4d84-ad41-6e8139d0c3df","name":"La transgresión del límite (πεῖρας) como problema fundamental del filosofar en el poema de Parménides","handle":"10669/105342","metadata":{"dc.contributor.advisor":[{"value":"Fallas López, Luis Alberto","language":null,"authority":null,"confidence":-1,"place":0}],"dc.creator":[{"value":"Mata Quintero, Luis Enrique","language":null,"authority":null,"confidence":-1,"place":0}],"dc.date.accessioned":[{"value":"2026-10-28T21:17:14Z","language":null,"authority":null,"confidence":-1,"place":0}],"dc.date.issued":[{"value":"2026","language":null,"authority":null,"confidence":-1,"place":0}],"dc.description.abstract":[{"value":"Esta investigación aborda el problema de la transgresión del límite (πεῖρας) como eje interpretativo de la filosofía de Parménides, proponiendo una lectura que integra los aspectos poéticos, religiosos y filosóficos del Poema. Frente a la tendencia de la tradición interpretativa a centrarse exclusivamente en la noción de límite, este estudio sostiene que el pensamiento parmenídeo no solo lo establece, sino que también piensa la posibilidad de su exceso, es decir, la inclinación del filosofar mismo a transgredir dichos límites. \n\nEl trabajo parte de la hipótesis de que el filosofar en Parménides implica, de manera constitutiva, una condición transgresora del pensar, aunque la idea de transgresión no debe entenderse de manera unívoca, pues si bien el pensar tiende al exceso, no todo exceso es ilegítimo. La investigación distingue entre exceso —como impulso hacia lo desconocido y apertura del pensar— y transgresión —como quiebre ilegítimo de los límites de lo posible— , y muestra que la tensión entre ambos constituye el núcleo de la experiencia filosófica. \n\nPara fundamentar esta tesis, se examina el contexto pre-parmenídeo del problema, desde la épica de Homero y Hesíodo hasta los filósofos milesios, pitagóricos, Jenófanes y Heráclito, donde el límite se concibe como la distancia entre lo humano y lo divino. A partir de este trasfondo, en el segundo capítulo se ofrece una relectura del Proemio como una metáfora del ingreso a la filosofía, en la que el κοῦρος simboliza el tránsito del mortal hacia un ámbito reservado a los dioses. El viaje descrito por el Poema se interpreta como una experiencia limítrofe en la que el pensamiento, movido por el exceso, arriesga incurrir en la transgresión. En el tercer capítulo, el estudio se centra en la revelación de la Diosa, mostrando que el conocimiento verdadero posee un carácter excesivo para los mortales: el νοεῖν que capta el ἐόν trasciende la condición humana y exige una transformación del pensamiento. A través del análisis de los fragmentos B 1, 2, 3, 6 y 7, se concluye que Parménides no se limita a fijar los límites del pensar, sino que invita a explorarlos, asumiendo el riesgo inherente de la transgresión. \n\nDe este modo, la tesis demuestra que la filosofía parmenídea surge de una tensión fundamental entre el límite y su transgresión, entre la necesidad de contener el pensar y la inclinación inevitable a desbordarlo. Pensar el límite implica, en Parménides, rozar lo inalcanzable, y es precisamente en ese gesto donde el filosofar se revela como una forma de exceso constitutivo del pensamiento mismo.","language":null,"authority":null,"confidence":-1,"place":0},{"value":"This research addresses the problem of the transgression of the limit (πεῖρας) as the central interpretive focus of Parmenides’ philosophy, proposing a reading that integrates the poetic, religious, and philosophical dimensions of the Poem. In contrast to the interpretative tradition’s tendency to focus exclusively on the notion of the limit, this study argues that Parmenidean thought not only establishes it, but also reflects on the possibility of its excess— that is, on philosophy’s own inclination to transgress such boundaries. \n\nThe work begins from the hypothesis that philosophizing in Parmenides inherently entails a transgressive condition of thought, although the idea of transgression should not be understood univocally: while thought tends toward excess, not every excess is illegitimate. The research distinguishes between excess—as an impulse toward the unknown and an opening of thought—and transgression—as the illegitimate crossing of the limits of what is possible—and shows that the tension between the two constitutes the core of the philosophical experience. \n\nTo substantiate this thesis, the pre-Parmenidean context of the problem is examined, from the epic poetry of Homer and Hesiod to the Milesian philosophers, Pythagoreans, Xenophanes, and Heraclitus, where the limit is conceived as the distance between the human and the divine. Against this background, the second chapter offers a reinterpretation of the Proem as a metaphor for the initiation into philosophy, in which the κοῦρος symbolizes the mortal’s passage into a realm reserved for the gods. The journey described in the Poem is interpreted as a liminal experience in which thought, driven by excess, risks falling into transgression. The third chapter focuses on the revelation of the Goddess, showing that true knowledge possesses an excessive character for mortals: the νοεῖν that grasps the ἐόν transcends the human condition and demands a transformation of thought. Through an analysis of fragments B 1, 2, 3, 6, and 7, the study concludes that Parmenides does not merely establish the limits of thought but invites us to explore them, embracing the inherent risk of transgression. \n\nThus, the thesis demonstrates that Parmenidean philosophy arises from a fundamental tension between the limit and its transgression, between the need to contain thought and its inevitable inclination to overflow. To think about the limit, in Parmenides, is to touch the unreachable, and it is precisely in this gesture that philosophy reveals itself as a constitutive excess of thought itself.","language":null,"authority":null,"confidence":-1,"place":1}],"dc.description.procedence":[{"value":"Vicerrectoría de Investigación::Sistema de Estudios de Posgrado::Artes y Letras::Maestría Académica en Filosofía","language":null,"authority":"ucr:SEP-AL-9","confidence":600,"place":0}],"dc.identifier.uri":[{"value":"https://hdl.handle.net/10669/105342","language":null,"authority":null,"confidence":-1,"place":0}],"dc.language.iso":[{"value":"spa","language":null,"authority":null,"confidence":-1,"place":0}],"dc.rights":[{"value":"acceso abierto","language":null,"authority":null,"confidence":-1,"place":0}],"dc.source":[{"value":"San José, Costa Rica: Universidad de Costa Rica.","language":null,"authority":null,"confidence":-1,"place":0}],"dc.subject":[{"value":"Filosofía","language":null,"authority":null,"confidence":-1,"place":0},{"value":"Parménides","language":null,"authority":null,"confidence":-1,"place":1},{"value":"Transgresión del límite","language":null,"authority":null,"confidence":-1,"place":2},{"value":"Exceso","language":null,"authority":null,"confidence":-1,"place":3},{"value":"Conocimiento","language":null,"authority":null,"confidence":-1,"place":4},{"value":"Ontología","language":null,"authority":null,"confidence":-1,"place":5},{"value":"Philosophy","language":null,"authority":null,"confidence":-1,"place":6},{"value":"Transgression of the limit","language":null,"authority":null,"confidence":-1,"place":7},{"value":"Excess","language":null,"authority":null,"confidence":-1,"place":8},{"value":"Knowledge","language":null,"authority":null,"confidence":-1,"place":9},{"value":"Ontology","language":null,"authority":null,"confidence":-1,"place":10}],"dc.title":[{"value":"La transgresión del límite (πεῖρας) como problema fundamental del filosofar en el poema de Parménides","language":null,"authority":null,"confidence":-1,"place":0}],"dc.type":[{"value":"tesis de maestría","language":null,"authority":null,"confidence":-1,"place":0}]},"inArchive":true,"discoverable":true,"withdrawn":false,"lastModified":"2026-10-29T03:01:00.538511Z","entityType":null,"type":"item","uniqueType":"core.item","_links":{"accessStatus":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/251bc755-84ba-4d84-ad41-6e8139d0c3df/accessStatus"},"bundles":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/251bc755-84ba-4d84-ad41-6e8139d0c3df/bundles"},"identifiers":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/251bc755-84ba-4d84-ad41-6e8139d0c3df/identifiers"},"mappedCollections":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/251bc755-84ba-4d84-ad41-6e8139d0c3df/mappedCollections"},"owningCollection":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/251bc755-84ba-4d84-ad41-6e8139d0c3df/owningCollection"},"relationships":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/251bc755-84ba-4d84-ad41-6e8139d0c3df/relationships"},"version":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/251bc755-84ba-4d84-ad41-6e8139d0c3df/version"},"templateItemOf":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/251bc755-84ba-4d84-ad41-6e8139d0c3df/templateItemOf"},"thumbnail":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/251bc755-84ba-4d84-ad41-6e8139d0c3df/thumbnail"},"submitter":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/251bc755-84ba-4d84-ad41-6e8139d0c3df/submitter"},"self":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/251bc755-84ba-4d84-ad41-6e8139d0c3df"}},"_embedded":{"thumbnail":{"id":"d76c423e-7571-4453-9b6b-d095d4abd009","uuid":"d76c423e-7571-4453-9b6b-d095d4abd009","name":"Tesis Luis Enrique Mata Quintero.pdf.jpg","handle":null,"metadata":{"dc.description":[{"value":"Generated Thumbnail","language":null,"authority":null,"confidence":-1,"place":0}],"dc.source":[{"value":"Written by FormatFilter org.dspace.app.mediafilter.PDFBoxThumbnail on 2026-10-29T03:01:00Z (GMT).","language":null,"authority":null,"confidence":-1,"place":0}],"dc.title":[{"value":"Tesis Luis Enrique Mata Quintero.pdf.jpg","language":null,"authority":null,"confidence":-1,"place":0}]},"bundleName":"THUMBNAIL","sizeBytes":2671,"checkSum":{"checkSumAlgorithm":"MD5","value":"ce14d94f469afb07776132c9d21e7318"},"sequenceId":4,"type":"bitstream","uniqueType":"core.bitstream","_links":{"content":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/d76c423e-7571-4453-9b6b-d095d4abd009/content"},"bundle":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/d76c423e-7571-4453-9b6b-d095d4abd009/bundle"},"accessStatus":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/d76c423e-7571-4453-9b6b-d095d4abd009/accessStatus"},"format":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/d76c423e-7571-4453-9b6b-d095d4abd009/format"},"thumbnail":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/d76c423e-7571-4453-9b6b-d095d4abd009/thumbnail"},"self":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/d76c423e-7571-4453-9b6b-d095d4abd009"}}}}}}},{"type":{"value":"searchresult"},"hitHighlights":{},"_links":{"indexableObject":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/766d4068-f6de-4a41-a76d-a88fd2ede4d7"}},"_embedded":{"indexableObject":{"id":"766d4068-f6de-4a41-a76d-a88fd2ede4d7","uuid":"766d4068-f6de-4a41-a76d-a88fd2ede4d7","name":"Generación de una base hidrográfica ottocodificada y estimación de un potencial de crecidas a partir de índices geomorfométicos en el sistema de drenaje del río Damas. San José y Cartago, Costa Rica","handle":"10669/105341","metadata":{"dc.contributor.advisor":[{"value":"Quesada Román, Adolfo","language":null,"authority":null,"confidence":-1,"place":0}],"dc.creator":[{"value":"Villavicencio Rojas, Herberth","language":null,"authority":null,"confidence":-1,"place":0}],"dc.date.accessioned":[{"value":"2026-10-28T21:15:39Z","language":null,"authority":null,"confidence":-1,"place":0}],"dc.date.issued":[{"value":"2026","language":null,"authority":null,"confidence":-1,"place":0}],"dc.description.abstract":[{"value":"La investigación tuvo como objetivo desarrollar una Base Hidrográfica Ottocodificada (BHO) para el sistema de drenaje del río Damas, ubicado en los cantones de Desamparados, La Unión y Curridabat, Costa Rica. El estudio surge ante la necesidad de contar con una cartografía hidrográfica oficial, precisa y jerarquizada que contribuya al ordenamiento territorial, la gestión integrada de los recursos hídricos y la reducción del riesgo de inundaciones. Actualmente, Costa Rica carece de una delimitación oficial de cuencas hidrográficas de alta resolución, lo que genera inconsistencias entre los distintos productos cartográficos utilizados por las instituciones públicas. Para atender esta problemática, se implementó el método de Otto Pfafstetter, una metodología de codificación hidrográfica reconocida internacionalmente por permitir la identificación única y jerárquica de las unidades de drenaje.\n\nLa unidad de análisis fue el sistema de drenaje del río Damas, de aproximadamente 25,8 km², caracterizado por una importante urbanización y una alta recurrencia de eventos de inundación. A partir de ortofotos y datos altimétricos oficiales se generó un Modelo Digital de Elevación de alta resolución, que permitió calcular direcciones y acumulaciones de flujo, delimitar las Áreas de Contribución Hidrográfica (ACH) e identificar los trechos de drenaje, elementos esenciales para construir una Base Hidrográfica Ottocodificada (BHO). La aplicación de la metodología de ottocodificación permitió establecer dos niveles de jerarquización hidrográfica, asignando códigos únicos a cada ACH y a cada trecho de drenaje, manteniendo una relación uno a uno entre ambos elementos. Además, se comprobó la posibilidad de integrar el sistema del río Damas dentro de sistemas hidrográficos mayores, garantizando la consistencia y escalabilidad de la codificación.\n\nParalelamente, se realizó una caracterización geomorfométrica de todas las unidades hidrográficas delimitadas. Se calcularon índices asociados a la forma de las cuencas, las características de la red de drenaje y las condiciones del relieve. Entre los principales indicadores utilizados se encuentran el índice de compacidad de Gravelius, el factor de forma de Horton, la razón de bifurcación, el tiempo de concentración, las pendientes medias, el Stream Power Index (SPI), el Topographic Wetness Index (TWI), así como los índices NDWI y MNDWI derivados de imágenes Sentinel 2.\n\nCon base en estos indicadores se construyó una metodología multicriterio para clasificar cada ACH según su potencial de crecidas en categorías alta, media o baja. Los resultados evidenciaron que las zonas con mayor potencial de crecidas se concentran principalmente en las partes bajas y medias del sistema hidrográfico, coincidiendo con áreas urbanas densamente pobladas y con sectores históricamente afectados por inundaciones reportadas por la Comisión Nacional de Emergencias y la Municipalidad de Desamparados.\n\nSe demostró que la combinación de una Base Hidrográfica Ottocodificada con indicadores geomorfométricos constituye una herramienta robusta para identificar áreas prioritarias de monitoreo, inversión e intervención en materia de gestión del riesgo. Asimismo, facilita la integración de información geoespacial procedente de diferentes instituciones mediante un sistema de referencia hidrográfico único.","language":null,"authority":null,"confidence":-1,"place":0},{"value":"This research develops a methodology for generating an Otto-coded Hydrographic Database (OHD) applied to the Damas River drainage system, located in “Área Metropolitana”, Costa Rica, using Otto Pfafstetter's hydrographic coding method. The study arose from the lack of official, high-resolution watershed mapping to strengthen territorial planning, integrated water resource management, and flood risk management. \n\nThe methodology combined spatial analysis techniques, geographic information systems, the construction of a high-resolution Digital Elevation Model (DEM), the delineation of Hydrographic Contribution Areas (HCAs), the generation of drainage reaches, and the application of the Otto-coding methodology. Additionally, geomorphometric indices related to basin shape, drainage network, and topography were calculated, including time of concentration, bifurcation ratio, slope, Stream Power Index (SPI), Topographic Wetness Index (TWI), and Normalized Difference Water Index (NDWI), as well as their respective modified variant (NDWI) and (MNDWI), to estimate flood potential in each hydrographic unit. \n\nThe results allowed for the generation of a Basin Hydrographic Hierarchy (BHO) for the Damas River drainage system, achieving two levels of hydrographic hierarchy with unique and unrepeatable codes for each watershed and its respective drainage reach. Furthermore, the conservation of codes was demonstrated when integrating the system with larger hydrographic units, confirming the method's ability to represent the topology of the drainage network and facilitate its integration at different scales of analysis. \n\nGeomorphometric analysis identified areas with high, medium, and low flood potential. The most susceptible areas were located primarily in the lower and middle parts of the basin, where the largest urban concentrations coincide with sites historically affected by flooding. The study concludes that Ottocodification is an effective tool for land-use planning, risk management, and the integration of geospatial information, allowing for the correlation of multiple variables through a single, scalable hydrographic reference.","language":null,"authority":null,"confidence":-1,"place":1}],"dc.description.procedence":[{"value":"Vicerrectoría de Investigación::Sistema de Estudios de Posgrado::Ciencias Sociales::Maestría Académica en Geografía","language":null,"authority":"ucr:SEP-CS-47","confidence":600,"place":0}],"dc.identifier.uri":[{"value":"https://hdl.handle.net/10669/105341","language":null,"authority":null,"confidence":-1,"place":0}],"dc.language.iso":[{"value":"spa","language":null,"authority":null,"confidence":-1,"place":0}],"dc.rights":[{"value":"acceso restringido","language":null,"authority":null,"confidence":-1,"place":0}],"dc.rights.uri":[{"value":"http://creativecommons.org/licenses/by-nc-nd/3.0/cr/","language":null,"authority":null,"confidence":-1,"place":0}],"dc.source":[{"value":"San José, Costa Rica: Universidad de Costa Rica.","language":null,"authority":null,"confidence":-1,"place":0}],"dc.subject":[{"value":"Geomorfometría","language":null,"authority":null,"confidence":-1,"place":0},{"value":"Ottocodificación","language":null,"authority":null,"confidence":-1,"place":1},{"value":"Base Hidrográfica Ottocodificada","language":null,"authority":null,"confidence":-1,"place":2},{"value":"Sistema de drenaje del río Damas","language":null,"authority":null,"confidence":-1,"place":3},{"value":"Desamparados","language":null,"authority":null,"confidence":-1,"place":4},{"value":"San José","language":null,"authority":null,"confidence":-1,"place":5},{"value":"Cartago","language":null,"authority":null,"confidence":-1,"place":6},{"value":"Costa Rica","language":null,"authority":null,"confidence":-1,"place":7},{"value":"Potencial de crecidas","language":null,"authority":null,"confidence":-1,"place":8},{"value":"Cuencas hidrográficas","language":null,"authority":null,"confidence":-1,"place":9},{"value":"Hidrografía","language":null,"authority":null,"confidence":-1,"place":10},{"value":"Áreas de Contribución Hidrográfica","language":null,"authority":null,"confidence":-1,"place":11},{"value":"Trechos de drenaje","language":null,"authority":null,"confidence":-1,"place":12},{"value":"Modelo Digital de Elevación","language":null,"authority":null,"confidence":-1,"place":13},{"value":"HydroSHEDS","language":null,"authority":null,"confidence":-1,"place":14},{"value":"HydroBID","language":null,"authority":null,"confidence":-1,"place":15},{"value":"Hydrography90m","language":null,"authority":null,"confidence":-1,"place":16},{"value":"MERIT Hydro DEM","language":null,"authority":null,"confidence":-1,"place":17},{"value":"SRTM","language":null,"authority":null,"confidence":-1,"place":18},{"value":"Otto Pfafstetter","language":null,"authority":null,"confidence":-1,"place":19},{"value":"Ottocodification","language":null,"authority":null,"confidence":-1,"place":20},{"value":"Otto-coded Hydrographic Base","language":null,"authority":null,"confidence":-1,"place":21},{"value":"Geomorphometry","language":null,"authority":null,"confidence":-1,"place":22},{"value":"Watersheds","language":null,"authority":null,"confidence":-1,"place":23},{"value":"Flood potential","language":null,"authority":null,"confidence":-1,"place":24},{"value":"Risk management","language":null,"authority":null,"confidence":-1,"place":25}],"dc.title":[{"value":"Generación de una base hidrográfica ottocodificada y estimación de un potencial de crecidas a partir de índices geomorfométicos en el sistema de drenaje del río Damas. San José y Cartago, Costa Rica","language":null,"authority":null,"confidence":-1,"place":0}],"dc.type":[{"value":"tesis de maestría","language":null,"authority":null,"confidence":-1,"place":0}]},"inArchive":true,"discoverable":true,"withdrawn":false,"lastModified":"2026-10-29T03:02:47.967421Z","entityType":null,"type":"item","uniqueType":"core.item","_links":{"accessStatus":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/766d4068-f6de-4a41-a76d-a88fd2ede4d7/accessStatus"},"bundles":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/766d4068-f6de-4a41-a76d-a88fd2ede4d7/bundles"},"identifiers":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/766d4068-f6de-4a41-a76d-a88fd2ede4d7/identifiers"},"mappedCollections":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/766d4068-f6de-4a41-a76d-a88fd2ede4d7/mappedCollections"},"owningCollection":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/766d4068-f6de-4a41-a76d-a88fd2ede4d7/owningCollection"},"relationships":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/766d4068-f6de-4a41-a76d-a88fd2ede4d7/relationships"},"version":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/766d4068-f6de-4a41-a76d-a88fd2ede4d7/version"},"templateItemOf":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/766d4068-f6de-4a41-a76d-a88fd2ede4d7/templateItemOf"},"thumbnail":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/766d4068-f6de-4a41-a76d-a88fd2ede4d7/thumbnail"},"submitter":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/766d4068-f6de-4a41-a76d-a88fd2ede4d7/submitter"},"self":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/766d4068-f6de-4a41-a76d-a88fd2ede4d7"}},"_embedded":{"thumbnail":{"id":"ea4f467e-6d67-4a0e-9888-1cd0496023a7","uuid":"ea4f467e-6d67-4a0e-9888-1cd0496023a7","name":"DOCUMENTO_FINAL_V6_FORMATO_SEP_RESPALDO_aqr_HVR.pdf.jpg","handle":null,"metadata":{"dc.description":[{"value":"Generated Thumbnail","language":null,"authority":null,"confidence":-1,"place":0}],"dc.source":[{"value":"Written by FormatFilter org.dspace.app.mediafilter.PDFBoxThumbnail on 2026-10-29T03:02:47Z (GMT).","language":null,"authority":null,"confidence":-1,"place":0}],"dc.title":[{"value":"DOCUMENTO_FINAL_V6_FORMATO_SEP_RESPALDO_aqr_HVR.pdf.jpg","language":null,"authority":null,"confidence":-1,"place":0}]},"bundleName":"THUMBNAIL","sizeBytes":3020,"checkSum":{"checkSumAlgorithm":"MD5","value":"9a7dc15b045bf2aa9888f917b65c180c"},"sequenceId":5,"type":"bitstream","uniqueType":"core.bitstream","_links":{"content":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/ea4f467e-6d67-4a0e-9888-1cd0496023a7/content"},"bundle":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/ea4f467e-6d67-4a0e-9888-1cd0496023a7/bundle"},"accessStatus":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/ea4f467e-6d67-4a0e-9888-1cd0496023a7/accessStatus"},"format":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/ea4f467e-6d67-4a0e-9888-1cd0496023a7/format"},"thumbnail":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/ea4f467e-6d67-4a0e-9888-1cd0496023a7/thumbnail"},"self":{"href":"https://repositorio.ucr.ac.cr/server/api/core/bitstreams/ea4f467e-6d67-4a0e-9888-1cd0496023a7"}}}}}}},{"type":{"value":"searchresult"},"hitHighlights":{},"_links":{"indexableObject":{"href":"https://repositorio.ucr.ac.cr/server/api/core/items/a0eca249-57ed-4111-931e-a3581259d4fb"}},"_embedded":{"indexableObject":{"id":"a0eca249-57ed-4111-931e-a3581259d4fb","uuid":"a0eca249-57ed-4111-931e-a3581259d4fb","name":"Occurrence of cryptosporidium sp. in fresh produce from the metropolitan area of Costa Rica: an update","handle":"10669/105340","metadata":{"dc.creator":[{"value":"Murillo Salas, Nelly","language":null,"authority":null,"confidence":-1,"place":0},{"value":"Alvarado Ocampo, Johan","language":null,"authority":null,"confidence":-1,"place":1},{"value":"Abrahams Sandí, Elizabeth","language":null,"authority":null,"confidence":-1,"place":2},{"value":"Retana Moreira, Lissette","language":null,"authority":null,"confidence":-1,"place":3},{"value":"Chaves Ulate, Carolina","language":null,"authority":null,"confidence":-1,"place":4}],"dc.date.accessioned":[{"value":"2026-10-28T20:23:27Z","language":null,"authority":null,"confidence":-1,"place":0}],"dc.date.issued":[{"value":"2026","language":null,"authority":null,"confidence":-1,"place":0}],"dc.description.abstract":[{"value":"Foodborne diseases represent a major global public health problem, causing significant morbidity and mortality, and substantial economic losses. Fruits and vegetables are considered among the main vehicles for transmission of infectious agents like bacteria, viruses, fungi and parasites, including Cryptosporidium sp. This protozoan parasite comprises many species that infect a wide range of hosts, is environmentally and geographically ubiquitous and has become one of the leading causes of diarrheal disease; in immunocompromised hosts, the infection can result in a chronic, life-threatening disease. Considering the importance of fruit and vegetable consumption in the daily diet and the need to ensure their safety, the aim of the study was to evaluate the presence of Cryptosporidium sp. in strawberries, lettuce and cilantro marketed in the Metropolitan Area of Costa Rica and to assess the degree of faecal contamination in these foods. For this purpose, 96 samples were analysed using parasitological and molecular methods that included a nested PCR to amplify Cryptosporidium sp. gp60 gene. Moreover, the presence of total and thermotolerant coliforms and Escherichia coli was also determined by culture methods and counts, for further identification using the VITEK system. Direct examination of wet mount and Ziehl-Neelsen stains revealed five Cryptosporidium sp. positive samples by microscopy and 22 positive samples by PCR; the identified species was Cryptosporidium parvum. Cilantro samples presented the highest counts of total, and thermotolerant coliforms and E. coli was identified in14 samples among 82 samples subjected to bacteriological analyses. The detection of C. parvum in raw vegetables and fruits from different provinces in Costa Rica, particularly using molecular techniques, demonstrates the need to strengthen surveillance and control in the production and marketing of these foods, to improve risk assessment and its relevance to public health.","language":null,"authority":null,"confidence":-1,"place":0}],"dc.description.procedence":[{"value":"Vicerrectoría de Docencia::Salud::Facultad de Microbiología","language":null,"authority":"ucr:FMi","confidence":600,"place":0},{"value":"Vicerrectoría de Investigación::Unidades de Investigación::Ciencias de la Salud::Centro de Investigación en Enfermedades Tropicales (CIET)","language":null,"authority":"ucr:UI-S-2","confidence":600,"place":1}],"dc.description.sponsorship":[{"value":"Centro de Investigación en Enfermedades Tropicales/[803-C3128]/CIET/Costa Rica","language":null,"authority":null,"confidence":-1,"place":0}],"dc.identifier.citation":[{"value":"https://www.sciencedirect.com/journal/journal-of-food-protection","language":null,"authority":null,"confidence":-1,"place":0}],"dc.identifier.codproyecto":[{"value":"803-C3128","language":null,"authority":null,"confidence":-1,"place":0}],"dc.identifier.uri":[{"value":"https://hdl.handle.net/10669/105340","language":null,"authority":null,"confidence":-1,"place":0}],"dc.language.iso":[{"value":"eng","language":null,"authority":null,"confidence":-1,"place":0}],"dc.rights":[{"value":"acceso abierto","language":null,"authority":null,"confidence":-1,"place":0}],"dc.source":[{"value":"Journal of Food Protection","language":null,"authority":null,"confidence":-1,"place":0}],"dc.subject":[{"value":"Cryptosporidium sp.","language":null,"authority":null,"confidence":-1,"place":0},{"value":"fresh produce","language":null,"authority":null,"confidence":-1,"place":1},{"value":"coliforms","language":null,"authority":null,"confidence":-1,"place":2},{"value":"Metropolitan Area","language":null,"authority":null,"confidence":-1,"place":3},{"value":"PCR","language":null,"a