go":{"href":"https://repositorio.ucr.ac.cr/server/api/core/communities/e6ed79ce-2809-4d3e-b3e9-fbb20f96b286/logo"},"subcommunities":{"href":"https://repositorio.ucr.ac.cr/server/api/core/communities/e6ed79ce-2809-4d3e-b3e9-fbb20f96b286/subcommunities"},"parentCommunity":{"href":"https://repositorio.ucr.ac.cr/server/api/core/communities/e6ed79ce-2809-4d3e-b3e9-fbb20f96b286/parentCommunity"},"adminGroup":{"href":"https://repositorio.ucr.ac.cr/server/api/core/communities/e6ed79ce-2809-4d3e-b3e9-fbb20f96b286/adminGroup"},"self":{"href":"https://repositorio.ucr.ac.cr/server/api/core/communities/e6ed79ce-2809-4d3e-b3e9-fbb20f96b286"}},"_name":"Acción Social","id":"e6ed79ce-2809-4d3e-b3e9-fbb20f96b286","uuid":"e6ed79ce-2809-4d3e-b3e9-fbb20f96b286","type":"community","metadata":{"dc.description":[{"uuid":"76096b7f-fa21-474d-b4bb-8d241b500f8d","language":null,"value":"Este es un espacio para los productos de acción social de la Universidad de Costa Rica. Estos productos pueden estar asociados a proyectos de trabajo comunal universitario, extensión docente, extensión cultural e iniciativas estudiantiles.","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"9b245f97-6894-4de9-a127-6870e2429421","language":null,"value":"https://hdl.handle.net/10669/9013","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"69faf2d5-0983-487b-9265-78427d391668","language":null,"value":"Acción Social","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793292827699,"msToLive":900000,"requestUUIDs":["client/7f2ab39e-a7ba-4415-b8cf-fbb3da8aeb99"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://repositorio.ucr.ac.cr/server/api/core/communities/04b1bb39-512a-47ab-8f1d-ec669b65b6aa":{"data":{"archivedItemsCount":-1,"_links":{"collections":{"href":"https://repositorio.ucr.ac.cr/server/api/core/communities/04b1bb39-512a-47ab-8f1d-ec669b65b6aa/collections"},"logo":{"href":"https://repositorio.ucr.ac.cr/server/api/core/communities/04b1bb39-512a-47ab-8f1d-ec669b65b6aa/logo"},"subcommunities":{"href":"https://repositorio.ucr.ac.cr/server/api/core/communities/04b1bb39-512a-47ab-8f1d-ec669b65b6aa/subcommunities"},"parentCommunity":{"href":"https://repositorio.ucr.ac.cr/server/api/core/communities/04b1bb39-512a-47ab-8f1d-ec669b65b6aa/parentCommunity"},"adminGroup":{"href":"https://repositorio.ucr.ac.cr/server/api/core/communities/04b1bb39-512a-47ab-8f1d-ec669b65b6aa/adminGroup"},"self":{"href":"https://repositorio.ucr.ac.cr/server/api/core/communities/04b1bb39-512a-47ab-8f1d-ec669b65b6aa"}},"_name":"Docencia","id":"04b1bb39-512a-47ab-8f1d-ec669b65b6aa","uuid":"04b1bb39-512a-47ab-8f1d-ec669b65b6aa","type":"community","metadata":{"dc.description":[{"uuid":"b99bddfa-4149-4512-89d7-21881a26f707","language":null,"value":"\u003Cp>Espacio dedicado a recursos educativos y material didáctico.\u003C/p>\n\u003Cstrong>¿Cómo buscar? \u003C/strong>\n\u003Cul>\n\u003Cli> De clic en la barra de búsqueda y digite la palabra que desea buscar. De esta forma buscará en los campos título, palabras clave y resumen.\n\u003Cli>Use texto entre comillas \"\" para buscar palabras exactas.\u003C/li>\n\u003Cli>No incluya caracteres especiales en las búsquedas de frases (.,-:()[]¿'?). Las búsquedas con caracteres especiales pueden dar resultados diferentes.\u003C/li>\n\u003Cli>Utilice el nombre del metadato para buscar en un campo específico. Por ejemplo, dc.creator: Bárbara Ocampo para buscar en el campo de autor. Puede ver los nombres de los campos en el registro completo de cada ítem.\u003C/li>\n\u003C/ul>","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"6045085f-f29e-4d7d-acb9-fc9272173388","language":null,"value":"","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"c6263c1c-0646-4aa5-87ba-3925ffaeeec7","language":null,"value":"https://hdl.handle.net/10669/15619","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"af524c78-dcd0-4b46-880b-f3a5ff06bcaf","language":null,"value":"Docencia","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793292827700,"msToLive":900000,"requestUUIDs":["client/7f2ab39e-a7ba-4415-b8cf-fbb3da8aeb99"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://repositorio.ucr.ac.cr/server/api/core/communities/e346547f-e6b9-4ad2-835a-6a56196a8c58":{"data":{"archivedItemsCount":-1,"_links":{"collections":{"href":"https://repositorio.ucr.ac.cr/server/api/core/communities/e346547f-e6b9-4ad2-835a-6a56196a8c58/collections"},"logo":{"href":"https://repositorio.ucr.ac.cr/server/api/core/communities/e346547f-e6b9-4ad2-835a-6a56196a8c58/logo"},"subcommunities":{"href":"https://repositorio.ucr.ac.cr/server/api/core/communities/e346547f-e6b9-4ad2-835a-6a56196a8c58/subcommunities"},"parentCommunity":{"href":"https://repositorio.ucr.ac.cr/server/api/core/communities/e346547f-e6b9-4ad2-835a-6a56196a8c58/parentCommunity"},"adminGroup":{"href":"https://repositorio.ucr.ac.cr/server/api/core/communities/e346547f-e6b9-4ad2-835a-6a56196a8c58/adminGroup"},"self":{"href":"https://repositorio.ucr.ac.cr/server/api/core/communities/e346547f-e6b9-4ad2-835a-6a56196a8c58"}},"_name":"Entidades","id":"e346547f-e6b9-4ad2-835a-6a56196a8c58","uuid":"e346547f-e6b9-4ad2-835a-6a56196a8c58","type":"community","metadata":{"dc.identifier.uri":[{"uuid":"45c5c291-0e01-4f0b-bd11-bd666b98dd5f","language":null,"value":"https://hdl.handle.net/10669/104189","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"d8fee68b-9ff9-4232-9af4-bcc4a6e437c2","language":null,"value":"Entidades","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793292827701,"msToLive":900000,"requestUUIDs":["client/7f2ab39e-a7ba-4415-b8cf-fbb3da8aeb99"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://repositorio.ucr.ac.cr/server/api/core/communities/c2676b7b-63c3-4851-b018-90ce8570916b":{"data":{"archivedItemsCount":-1,"_links":{"collections":{