   <dc:description>UCR::Vicerrectoría de Docencia::Ciencias Agroalimentarias::Facultad de Ciencias Agroalimentarias::Escuela de Agronomía</dc:description>
   <dc:date>2026-01-09T15:53:32Z</dc:date>
   <dc:date>2025-12-09</dc:date>
