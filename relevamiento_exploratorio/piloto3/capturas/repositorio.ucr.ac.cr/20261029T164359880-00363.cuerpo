   <dc:title>El temor al fracaso, una barrera para el aprendizaje</dc:title>
   <dc:creator>Campos Retana, Roy Alberto</dc:creator>
   <dc:subject>aprendizaje</dc:subject>
   <dc:subject>obstáculos</dc:subject>
