		  	 <article class="obj_article_details">

		
	<h1 class="page_title">
		Practical Assessment Scheme to Service Selection for SOC­based Applications
	</h1>

	
	<div class="row">
		<div class="main_entry">

							<section class="item authors">
					<h2 class="pkp_screen_reader">Autores/as</h2>
					<ul class="authors">
