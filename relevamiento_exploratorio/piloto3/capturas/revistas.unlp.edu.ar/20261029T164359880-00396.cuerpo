	<dc:source xml:lang="en">SADIO Electronic Journal of Informatics and Operations Research; Vol. 19 No. 1 (2020): Edición Especial sobre los 10 años del Congreso Argentino de AgroInformática; 5-32</dc:source>
	<dc:source xml:lang="es">SADIO Electronic Journal of Informatics and Operations Research; Vol. 19 Núm. 1 (2020): Edición Especial sobre los 10 años del Congreso Argentino de AgroInformática; 5-32</dc:source>
	<dc:source>1514-6774</dc:source>
	<dc:language>spa</dc:language>
