	<dc:source xml:lang="es">SADIO Electronic Journal of Informatics and Operations Research; Vol. 24 Núm. 1 (2025): Edición Especial dedicada a las 53 JAIIO:  ASAID - ASSE - CAIS - SACS - SIIIO; e065</dc:source>
	<dc:source>1514-6774</dc:source>
	<dc:language>spa</dc:language>
	<dc:relation>https://revistas.unlp.edu.ar/ejs/article/view/18818/18766</dc:relation>
