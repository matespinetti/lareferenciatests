	<dc:format>application/pdf</dc:format>
	<dc:identifier>https://revistas.unlp.edu.ar/ejs/article/view/20420</dc:identifier>
	<dc:identifier>10.24215/15146774e089</dc:identifier>
	<dc:source xml:lang="en">SADIO Electronic Journal of Informatics and Operations Research; Vol. 25 No. 1 (2026): EJS - Special Edition dedicated to the 54 JAIIO: ASAID-ASQC-ASSE-JUI-SACS-SAIV-SIIIO; e089</dc:source>
	<dc:source xml:lang="es">SADIO Electronic Journal of Informatics and Operations Research; Vol. 25 Núm. 1 (2026): EJS - Edición Especial dedicada a las 54 JAIIO: ASAID-ASQC-ASSE-JUI-SACS-SAIV-SIIIO; e089</dc:source>
