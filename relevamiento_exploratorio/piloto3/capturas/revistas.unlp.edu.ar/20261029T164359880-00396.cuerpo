	<dc:source xml:lang="es">SADIO Electronic Journal of Informatics and Operations Research; Vol. 25 Núm. 1 (2026): EJS - Edición Especial dedicada a las 54 JAIIO: ASAID-ASQC-ASSE-JUI-SACS-SAIV-SIIIO; e092</dc:source>
	<dc:source>1514-6774</dc:source>
	<dc:language>eng</dc:language>
	<dc:relation>https://revistas.unlp.edu.ar/ejs/article/view/20426/21340</dc:relation>
