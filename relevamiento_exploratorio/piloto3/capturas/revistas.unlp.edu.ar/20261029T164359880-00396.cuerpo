	<dc:title xml:lang="en">Editorial Note</dc:title>
	<dc:title xml:lang="es">Nota editorial</dc:title>
	<dc:creator xml:lang="en">Pons, Claudia</dc:creator>
	<dc:creator xml:lang="en">Fernández, Alejandro</dc:creator>
