	<dc:source xml:lang="en">SADIO Electronic Journal of Informatics and Operations Research; Vol. 22 No. 3 (2023): DECISIONING 2022 - Special Issue; e013</dc:source>
	<dc:source xml:lang="es">SADIO Electronic Journal of Informatics and Operations Research; Vol. 22 Núm. 3 (2023): DECISIONING 2022 - Special Issue; e013</dc:source>
