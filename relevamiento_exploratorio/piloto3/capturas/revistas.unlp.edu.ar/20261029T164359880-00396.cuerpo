	<dc:identifier>10.24215/15146774e016</dc:identifier>
	<dc:source xml:lang="en">SADIO Electronic Journal of Informatics and Operations Research; Vol. 22 No. 3 (2023): DECISIONING 2022 - Special Issue; e016</dc:source>
	<dc:source xml:lang="es">SADIO Electronic Journal of Informatics and Operations Research; Vol. 22 Núm. 3 (2023): DECISIONING 2022 - Special Issue; e016</dc:source>
	<dc:source>1514-6774</dc:source>
	<dc:language>eng</dc:language>
	<dc:relation>https://revistas.unlp.edu.ar/ejs/article/view/17713/17279</dc:relation>
