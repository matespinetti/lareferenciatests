<div class="row justify-content-between" id="footer-row">
<div class="col-xs-12 col-md-4">
<div class="row">
<div class="col-xs-12"><img alt="logo" id="footer_logo" src="..." /></div>

<div class="col-xs-12" id="footer-content"><span>Sistema Universitario de Bibliotecas</span><br />
<span>Av. Hidalgo N° 935</span><br />
<span>Col. Centro Guadalajara, Jalisco, México</span><br />
<span>C.P. 44100</span><br />
<span>Teléfono: (01 33)31 34 22 77 Ext. 11959, 11924, 11914</span><br />
<span>Correo: bibliotecadigital@udg.mx</span></div>
</div>
</div>

<div class="col-xs-12 col-md-3">
<div class="row">
<div class="col-xs-12" id="footer_rs"><a class="footer_rs_icon" href="#"><img alt="" src="..." /> </a></div>

<div class="col-xs-12">
<div id="footer_rs">&nbsp;</div>

<div id="footer_menu">&nbsp;</div>
</div>
</div>
</div>

<div class="col-xs-12 col-md-5"><iframe allowfullscreen="" height="300" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3732.817065324012!2d-103.36075522308374!3d20.67702019976351!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8428b1e2b1d41f9f%3A0x3ec09c00593b6e5e!2sSistema%20Universitario%20de%20Bibliotecas%20de%20la%20Universidad%20de%20Guadalajara!5e0!3m2!1ses-419!2smx!4v1702329425300!5m2!1ses-419!2smx" style="border:0;" width="400"></iframe></div>

<div class="col-xs-12 text-center" id="footer-right"><span>© Universidad de Guadalajara. Vicerrectoría Ejecutiva. Sistema Universitario de Bibliotecas. 2006 - 2026.</span></div>
</div>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script><script>
    $(function () {
        $.getJSON('/api/footer_icon')
            .done(function (response) {
                let data = response[0];
                $('#footer_logo').attr('src', data.link_image);
            })
            .fail(function (error) {
                console.log(error);
            });

        $.getJSON('/api/rs_links')
            .done(function (response) {
                $content = ""
                $.each(response, function (index, value) {
                    $content += '<a href="' + value.link_url + '" class="footer_rs_icon" target="_BLANK"><img src="' + value.link_image + '" alt=""></a>';
                });
                $('#footer_rs').html($content);
            })
            .fail(function (error) {
                console.log(error);
            });

        let
            menu = $('.menu.menu--main.nav.navbar-nav').clone(),
            footerMenu = '<ul id="footer-main-menu"></ul>';
        menu.addClass('footer-menu').removeClass('.menu').removeClass('menu--main').removeClass('nav').removeClass('navbar-nav');
        $.each(menu.find('li'), function (index, value) {
            if (menu.find('li:eq("' + index + '")').find('.dropdown-menu').length > 0) {
                menu.find('li:eq("' + index + '")').find('.dropdown-menu').addClass('footer-dropdown-menu');
            }
        });
        $('#footer_menu').html(footerMenu);
        $('#footer-main-menu').html(menu.html());
    });
</script></div>
          </div>

