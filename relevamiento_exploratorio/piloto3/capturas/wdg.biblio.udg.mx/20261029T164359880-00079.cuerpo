<script>
$(function(){
  $('.dropdown-menu>li>a').each(function(index,value){
    let href=value.getAttribute('href');
    if(href != null && href.includes('https://')){
      value.setAttribute('target','_BLANK');
    }
  });

  const menuItems = [
    { name: "Recursos informativos", color: "#C40000" },
    { name: "Repositorio Institucional", color: "#177509" },
    { name: "Catálogo en Línea", color: "#0068FF" },
    { name: "Herramientas", color: "#EEB292" },
    { name: "Servicios bibliotecarios", color: "#8109B5" }
  ];
  $('.menu>li.expanded.dropdown>a').each(function(index,value){
    let menuIndex = menuItems.findIndex((item) => (item.name).trim().toLowerCase() == (value.textContent).trim().toLowerCase() );
    if(menuIndex > -1){
      var dropdown = value.parentNode.querySelector('ul.dropdown-menu');
      dropdown.style.backgroundColor = menuItems[menuIndex].color+"CC";
    }
  });
  
});
</script>
