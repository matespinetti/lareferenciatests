   <dc:type>Artículo de investigación</dc:type>
   <dc:type>http://purl.org/coar/resource_type/c_2df8fbb1</dc:type>
   <dc:type>https://purl.org/redcol/resource_type/ART</dc:type>
   <dc:type>http://purl.org/coar/version/c_970fb48d4fbd8a85</dc:type>
