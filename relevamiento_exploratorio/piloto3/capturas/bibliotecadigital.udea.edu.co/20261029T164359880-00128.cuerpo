   <dc:subject>Anafilaxia</dc:subject>
   <dc:subject>Anaphylaxis</dc:subject>
   <dc:subject>Hipersensibilidad a los Alimentos</dc:subject>
   <dc:subject>Food Hypersensitivity</dc:subject>
   <dc:subject>Alergia a Medicamentos</dc:subject>
   <dc:subject>Drug Hypersensitivity</dc:subject>
   <dc:subject>Triptasas</dc:subject>
   <dc:subject>Tryptases</dc:subject>
   <dc:subject>Epinefrina</dc:subject>
   <dc:subject>Epinephrine</dc:subject>
   <dc:subject>https://id.nlm.nih.gov/mesh/D006967</dc:subject>
