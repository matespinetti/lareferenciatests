   <dc:title>Entropies and Fisher information matrix for extended beta distribution</dc:title>
   <dc:creator>Nagar, Daya Krishna</dc:creator>
   <dc:creator>Zarrazola Rivera, Edwin de Jesús</dc:creator>
   <dc:creator>Sánchez Herrera, Luz Estela</dc:creator>
