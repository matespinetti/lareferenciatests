   <dc:title>A strain-independent method to induce progressive and lethal pneumococcal pneumonia in neutropenic mice</dc:title>
   <dc:creator>Salazar Giraldo, Beatriz</dc:creator>
   <dc:creator>Zuluaga Salazar, Andrés Felipe</dc:creator>
   <dc:creator>Agudelo García, Olga María</dc:creator>
   <dc:creator>Rodríguez Jaramillo, Carlos Andrés</dc:creator>
   <dc:creator>Vesga Meneses, Omar</dc:creator>
   <dc:creator>Agudelo García, Olga María</dc:creator>
   <dc:creator>Zuluaga Salazar, Andrés Felipe</dc:creator>
   <dc:creator>Salazar Giraldo, Beatriz Eugenia</dc:creator>
   <dc:contributor>GRIPE: Grupo Investigador de Problemas en Enfermedades Infecciosas</dc:contributor>
