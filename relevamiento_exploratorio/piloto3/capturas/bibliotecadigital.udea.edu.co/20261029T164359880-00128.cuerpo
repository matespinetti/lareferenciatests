   <dc:title>Identificación de pacientes con anafilaxia en una institución de salud de tercer nivel de Medellín, Colombia (2009-2019)</dc:title>
   <dc:title>Characterization of patients with anaphylaxis in a tertiary hospital in Medellin, Colombia (2009-2019)</dc:title>
   <dc:creator>Aguirre Morales, Natalia</dc:creator>
   <dc:creator>Zapata Marín, Valeria</dc:creator>
   <dc:creator>Calvo Betancur, Víctor Daniel</dc:creator>
   <dc:creator>Ramírez Giraldo, Ruth Helena</dc:creator>
   <dc:creator>Cardona Villa, Ricardo</dc:creator>
   <dc:contributor>Grupo de Alergología Clínica y Experimental (GACE)</dc:contributor>
   <dc:contributor>Grupo de Alergología Clínica y Experimental (GACE)</dc:contributor>
