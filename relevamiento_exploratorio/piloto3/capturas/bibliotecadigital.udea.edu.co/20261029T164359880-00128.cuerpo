   <dc:title>Osteomielitis en los maxilares, reporte de 25 casos</dc:title>
   <dc:creator>Duque Serna, Francisco Levi</dc:creator>
   <dc:contributor>Grupo de Investigación en Patología Oral Periodoncia y Cirugía Alvéolo-Dentaria (POPCAD)</dc:contributor>
   <dc:subject>610 - Medicina y salud::617 - Cirugía, medicina regional, odontología, oftalmología, otología, audiología</dc:subject>
   <dc:subject>Osteomielitis</dc:subject>
   <dc:subject>Osteomyelitis</dc:subject>
   <dc:subject>Estado de Descerebración</dc:subject>
   <dc:subject>Decerebrate State</dc:subject>
   <dc:subject>Curetaje Subgingival</dc:subject>
   <dc:subject>Subgingival Curettage</dc:subject>
