</metadata></record><record><header><identifier>oai:repositorio.unb.br:10482/56695</identifier><datestamp>2026-09-22T18:09:59Z</datestamp><setSpec>com_10482_45725</setSpec><setSpec>col_10482_45731</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
   <dc:title>c0961877-89de-4a56-8105-35703a8744d1</dc:title>
   <dc:creator>10482/45731</dc:creator>
   <dc:date>2026-09-22T18:09:59Z</dc:date>
