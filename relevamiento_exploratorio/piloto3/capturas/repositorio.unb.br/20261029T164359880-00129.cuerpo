               <mods:titleInfo>
                  <mods:title>Análises estruturais e de modelos de interação das proteases NS3 dos Flavivirus zika e dengue, e nsP2 dos Alphavirus chikungunya e mayaro utilizando ferramentas in silico e in vitro</mods:title>
               </mods:titleInfo>
               <mods:genre>Tese</mods:genre>
            </mods:mods>
         </xmlData>
