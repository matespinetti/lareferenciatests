      <element name="identifier">
         <element name="citation">
            <element name="pt_BR">
               <field name="value">COELHO, Milena Vieira. “A influência da atividade física nos perfis de fragilidade, funcionalidade, cognição e qualidade de vida em populações de diferentes contextos ambientais rurais e urbanos”. x, 49 f., il. Dissertação (Mestrado em Ciências do Comportamento)—Universidade de Brasília, Brasília, 2014.</field>
            </element>
         </element>
