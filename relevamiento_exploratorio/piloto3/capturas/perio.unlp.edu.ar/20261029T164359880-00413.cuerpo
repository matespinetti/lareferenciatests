	<dc:identifier>10.24215/16696581e735</dc:identifier>
	<dc:source xml:lang="es">Question/Cuestión; Vol. 3 Núm. 72 (2022): Agosto 2022; E735</dc:source>
	<dc:source>1669-6581</dc:source>
