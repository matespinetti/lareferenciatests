	http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
	<dc:title xml:lang="es">Ganar la calle para ganar rendimiento: inteligencia artificial y big data en la publicidad exterior digital contemporánea</dc:title>
	<dc:creator xml:lang="es">Rolandi, Facundo</dc:creator>
	<dc:subject xml:lang="es">Publicidad exterior digital</dc:subject>
	<dc:subject xml:lang="es">inteligencia artificial</dc:subject>
	<dc:subject xml:lang="es">big data</dc:subject>
	<dc:subject xml:lang="es">democracia</dc:subject>
	<dc:subject xml:lang="es">libertad de expresión</dc:subject>
	<dc:description xml:lang="es">El presente artículo intenta analizar y problematizar, desde un punto de vista comunicacional y político, el fenómeno de la publicidad exterior digital presente en casi todas las principales ciudades del mundo contemporáneo a partir de la indagación en torno a ciertas causas y consecuencias, para luego plantear algunos desafíos y oportunidades sobre esta industria mediática en crecimiento.</dc:description>
	<dc:publisher xml:lang="es">Universidad Nacional de La Plata</dc:publisher>
	<dc:date>2022-09-01</dc:date>
