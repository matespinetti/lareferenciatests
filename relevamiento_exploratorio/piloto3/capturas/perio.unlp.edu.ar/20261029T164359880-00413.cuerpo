	<dc:identifier>10.24215/16696581e628</dc:identifier>
	<dc:source xml:lang="es">Question/Cuestión; Vol. 3 Núm. 70 (2021): Diciembre 2021; E628</dc:source>
	<dc:source>1669-6581</dc:source>
	<dc:language>spa</dc:language>
