   <dc:title>Realidades y coyunturas del Aborto : entre el derecho y la necesidad por Susana Checa (comp.). Buenos Aires : Paidós, 2006</dc:title>
   <dc:creator>Otero, Ivana</dc:creator>
   <dc:subject>RESEÑAS BIBLIOGRAFICAS</dc:subject>
   <dc:subject>CRITICA LITERARIA</dc:subject>
