</metadata></record><record><header><identifier>oai:repositorio.filo.uba.ar:filodigital/16298</identifier><datestamp>2026-04-13T01:22:58Z</datestamp><setSpec>com_filodigital_151</setSpec><setSpec>com_filodigital_16058</setSpec><setSpec>com_filodigital_16057</setSpec><setSpec>com_filodigital_1832</setSpec><setSpec>com_filodigital_9</setSpec><setSpec>com_filodigital_5</setSpec><setSpec>col_filodigital_2043</setSpec><setSpec>col_filodigital_16268</setSpec><setSpec>snrd</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
   <dc:title>¿Cómo leer hoy textos medievales?</dc:title>
   <dc:title>How to read Medieval texts today?</dc:title>
   <dc:creator>Briancesco, Eduardo</dc:creator>
   <dc:subject>EDAD MEDIA</dc:subject>
   <dc:subject>TRADICIÓN</dc:subject>
   <dc:subject>ENSEÑANZA</dc:subject>
   <dc:subject>HERMENÉUTICA</dc:subject>
   <dc:subject>MIDDLE AGES</dc:subject>
   <dc:subject>TRADITION</dc:subject>
   <dc:subject>TEACHING</dc:subject>
   <dc:subject>HERMENEUTICS</dc:subject>
   <dc:description>Fil: Briancesco, Eduardo. Consejo Nacional de Investigaciones Científicas y Técnicas; Argentina.</dc:description>
   <dc:description>Fil: Briancesco, Eduardo. Universidad de Buenos Aires. Facultad de Filosofía y Letras. Centro de Estudios de Filosofía Medieval; Argentina.</dc:description>
   <dc:description>Esta nota intentará responder al tema presentando: 1) un panorama histórico de las diversas exégesis practicadas sobre los grandes textos doctrinales de la Edad Media; 2) el resultado de mi propia experiencia, rica ya de treinta años, en el manejo de dichos textos; 3) su relación con el así llamado “régimen hermenéutico actual de la razón”</dc:description>
   <dc:description>This note will attempt to respond to the theme by presenting: 1) a historical framework of the various exegeses practiced on the great doctrinal texts of the Middle Ages; 2) the result of my own experience, already of thirty years, in the handling of these texts; 3) their relationship with the so-called “current hermeneutic regime of reason”.</dc:description>
   <dc:date>1988/07/04</dc:date>
   <dc:date>2023-04-18T20:37:10Z</dc:date>
   <dc:date>2023-04-18T20:37:10Z</dc:date>
