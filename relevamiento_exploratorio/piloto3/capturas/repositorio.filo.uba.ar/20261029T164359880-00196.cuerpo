</metadata></record><record><header><identifier>oai:repositorio.filo.uba.ar:filodigital/5724</identifier><datestamp>2026-04-13T01:24:36Z</datestamp><setSpec>com_filodigital_151</setSpec><setSpec>com_filodigital_5715</setSpec><setSpec>com_filodigital_3408</setSpec><setSpec>com_filodigital_3251</setSpec><setSpec>com_filodigital_1941</setSpec><setSpec>com_filodigital_1832</setSpec><setSpec>com_filodigital_9</setSpec><setSpec>com_filodigital_5</setSpec><setSpec>col_filodigital_2043</setSpec><setSpec>col_filodigital_5716</setSpec><setSpec>snrd</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
   <dc:title>Después de la utopía: la insularidad como negación de la historia en Samuel Beckett.</dc:title>
   <dc:creator>Montes, Elina R.</dc:creator>
   <dc:subject>BECKETT, SAMUEL</dc:subject>
   <dc:subject>1900-1999</dc:subject>
   <dc:subject>LITERATURA FRANCESA</dc:subject>
   <dc:subject>UTOPÍAS</dc:subject>
   <dc:subject>INSULARIDAD</dc:subject>
   <dc:subject>AHISTORICISMO</dc:subject>
   <dc:description>FIl: Montes, Elina R. Universidad de Buenos Aires. Facultad de Filosofía y Letras; Argentina.</dc:description>
   <dc:description>Este trabajo intentará dar cuenta de un espacio des-realizado que puede pensarse como contracara de utopías y distopías, como culminación de una trayectoria ficcional que pone en juego los anhelos de un comienzo ex novo o denuncia los peligros de la exacerbación de ese deseo. Se analizarán en tal sentido algunos textos en prosa del autor en donde parecería confluir, condensado, un problema que atraviesa su producción teatral.</dc:description>
   <dc:date>2018-06-19T19:23:36Z</dc:date>
   <dc:date>2018-06-19T19:23:36Z</dc:date>
   <dc:date>1997</dc:date>
   <dc:type>info:eu-repo/semantics/publishedVersion</dc:type>
   <dc:type>info:ar-repo/semantics/artículo</dc:type>
   <dc:type>info:eu-repo/semantics/article</dc:type>
