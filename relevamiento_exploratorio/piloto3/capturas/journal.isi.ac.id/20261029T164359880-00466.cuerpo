	<dc:identifier>10.24821/ars.v28i3.14463</dc:identifier>
	<dc:source xml:lang="en-US">Ars: Jurnal Seni Rupa dan Desain; Vol 28, No 3 (2025): September-Desember 2025</dc:source>
