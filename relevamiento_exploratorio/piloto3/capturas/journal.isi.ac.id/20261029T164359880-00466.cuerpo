	<dc:identifier>10.24821/ars.v29i1.19274</dc:identifier>
	<dc:source xml:lang="en-US">Ars: Jurnal Seni Rupa dan Desain; Vol 29, No 1 (2026): Januari-April 2026; 45-56</dc:source>
