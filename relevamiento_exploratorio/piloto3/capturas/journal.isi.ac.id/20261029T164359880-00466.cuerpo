	<dc:identifier>10.24821/ars.v23i1.3798</dc:identifier>
	<dc:source xml:lang="en-US">Ars: Jurnal Seni Rupa dan Desain; Vol 23, No 1 (2020): April 2020; 13 - 21</dc:source>
