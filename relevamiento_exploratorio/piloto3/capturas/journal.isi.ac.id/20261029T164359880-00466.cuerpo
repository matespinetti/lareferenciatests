	<dc:identifier>10.24821/ars.v23i2.3705</dc:identifier>
	<dc:source xml:lang="en-US">Ars: Jurnal Seni Rupa dan Desain; Vol 23, No 2 (2020): Agustus 2020; 101-111</dc:source>
	<dc:source>2580-7374</dc:source>
	<dc:source>1829-7412</dc:source>
