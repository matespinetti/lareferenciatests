	<dc:format>application/pdf</dc:format>
	<dc:identifier>https://journal.isi.ac.id/index.php/ars/article/view/2885</dc:identifier>
	<dc:identifier>10.24821/ars.v21i2.2885</dc:identifier>
	<dc:source xml:lang="en-US">Ars: Jurnal Seni Rupa dan Desain; Vol 21, No 2 (2018): Agustus 2018; 136-143</dc:source>
	<dc:source>2580-7374</dc:source>
