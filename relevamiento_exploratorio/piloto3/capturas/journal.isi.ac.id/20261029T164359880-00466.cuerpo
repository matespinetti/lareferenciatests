	<dc:type xml:lang="en-US"></dc:type>
	<dc:identifier>https://journal.isi.ac.id/index.php/ars/article/view/117</dc:identifier>
	<dc:identifier>10.24821/ars.v3i11.117</dc:identifier>
	<dc:source xml:lang="en-US">Ars: Jurnal Seni Rupa dan Desain; Vol 3, No 11: September-Desember 2010</dc:source>
