	<dc:language>eng</dc:language>
	<dc:relation>https://journal.isi.ac.id/index.php/ars/article/view/2840/1632</dc:relation>
	<dc:rights xml:lang="en-US">Copyright (c) 2019 ARS</dc:rights>
</oai_dc:dc>
