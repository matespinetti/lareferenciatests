	<dc:identifier>10.24821/ars.v1i14.141</dc:identifier>
	<dc:source xml:lang="en-US">Ars: Jurnal Seni Rupa dan Desain; Vol 1, No 14: September-Desember 2011</dc:source>
	<dc:source>2580-7374</dc:source>
	<dc:source>1829-7412</dc:source>
	<dc:source>10.24821/ars.v1i14</dc:source>
	<dc:language>en</dc:language>
</oai_dc:dc>
