	<dc:identifier>10.24821/ars.v1i14.2804</dc:identifier>
	<dc:source xml:lang="en-US">Ars: Jurnal Seni Rupa dan Desain; Vol 1, No 14: September-Desember 2011; 12 - 32</dc:source>
	<dc:source>2580-7374</dc:source>
