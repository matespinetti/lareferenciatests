   <dc:title>"El futuro del trabajo, una mirada desde latinoamerica y el caribe"</dc:title>
   <dc:creator>Toselli, Carlos Alberto</dc:creator>
   <dc:subject>Derecho</dc:subject>
   <dc:subject>Laboral</dc:subject>
   <dc:subject>Tecnologias</dc:subject>
