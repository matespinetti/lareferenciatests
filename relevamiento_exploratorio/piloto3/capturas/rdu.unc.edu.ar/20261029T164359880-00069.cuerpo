   <dc:title>La Red Argentina de Centros de Información Medicamentos y sus aportes en el contexto de la pandemia</dc:title>
   <dc:creator>Nuñez Montoya, Susana Carolina</dc:creator>
   <dc:creator>Caffaratti, Mariana</dc:creator>
   <dc:creator>Calderón, Claudia</dc:creator>
