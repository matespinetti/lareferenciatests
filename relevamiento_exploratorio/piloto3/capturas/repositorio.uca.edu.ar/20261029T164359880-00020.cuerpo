				  return "<a target='_blank' href='" + j( "div" ).data( "moreLink" ).link + "'></a>";
			}).append(" <i class='fa fa-info-circle' data-toggle='tooltip' title='Get updated citations from database'></i>");
			
			jQuery('[data-toggle="tooltip"]').tooltip();
		});
		</script>
	
