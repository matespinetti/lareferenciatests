<dc:title>Estado del desarrollo humano y social en el Gran Salta : región del Noroeste Argentino</dc:title>
<dc:creator>Salvia, Agustín</dc:creator>
<dc:creator>Donza, Eduardo</dc:creator>
<dc:creator>Poy, Santiago</dc:creator>
<dc:creator>Rodríguez Espínola, Solange Sylvia</dc:creator>
