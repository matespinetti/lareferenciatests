<dc:title>Condiciones materiales de vida : hábitat, pobreza y desigualdad en los hogares urbanos de la Argentina (2010-2017)</dc:title>
<dc:creator>Bonfiglio, Juan Ignacio</dc:creator>
<dc:creator>Vera, Julieta</dc:creator>
<dc:contributor>Salvia, Agustín (coord.)</dc:contributor>
