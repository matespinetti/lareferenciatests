	<script>
	
  	  google.charts.load('current', {'packages':['corechart']});

      // Draw the pie chart for Sarah's pizza when Charts is loaded.
      google.charts.setOnLoadCallback(drawSubjects);

      // Draw the pie chart for the Anthony's pizza when Charts is loaded.
      google.charts.setOnLoadCallback(drawTypes);
	  var charts;
	  var chartt;
	  var datas;
	  var datat;

	




// Callback that draws the pie chart for Sarah's pizza.
      function drawSubjects() {

        // Create the data table for Sarah's pizza.
        datas = new google.visualization.DataTable();
        datas.addColumn('string', 'Materias');
        datas.addColumn('number', 'Items');
        datas.addRows([['FILOSOFIA',2801],['DERECHO',2185],['HISTORIA',1687],['LITERATURA',1680],['TEOLOGIA',1440],['PSICOLOGIA',1112],['ECONOMIA',1056],['CIENCIA POLITICA',675],['MUSICA',670],['SOCIOLOGIA',550],['MEDICINA',546],['BIOETICA',353],['CIENCIAS SOCIALES',311],['INGENIERIA',251],['PSICOPEDAGOGIA',240],['DERECHO CANONICO',239],['CIENCIAS AGRARIAS',238],['EDUCACION',168],['ADMINISTRACION DE EMPRESAS',137],['LENGUA',115],['INGENIERIA AMBIENTAL',107],['COMUNICACION',102],['ARQUEOLOGIA',84],['PRODUCCION AGROPECUARIA',78],['INGENIERIA EN ALIMENTOS',77],['INGENIERIA INDUSTRIAL',59],['QUIMICA',37],['INFORMATICA',28],['ARTE',20],['PERIODISMO',20],['BIBLIOTECOLOGIA',17],['BIOQUIMICA',1],['CIENCIAS MEDICAS',1],['CIENCIAS POLITICAS',1],['DERECHO PENAL',1],['LETRAS',1],['PSICOLOGÍA',1],]);

        // Set options for Sarah's pie chart.
        var options = {title:'Distribución por disciplina',
					   is3D: true,	
                       width:500,
                       height:300};

        // Instantiate and draw the chart for Sarah's pizza.
        charts = new google.visualization.PieChart(document.getElementById('div_subject'));
		google.visualization.events.addListener(charts, 'select', selectHandlerSubject); 
        charts.draw(datas, options);
      }

      // Callback that draws the pie chart for Anthony's pizza.
      function drawTypes() {

        // Create the data table for Anthony's pizza.
        datat = new google.visualization.DataTable();
        datat.addColumn('string', 'Tipo de material');
        datat.addColumn('number', 'Items');
        datat.addRows([['Artículo',11543],['Documento de conferencia',1974],['Reseña libro',1441],['Revista (Número completo)',1063],['Parte de libro',1038],['Tesis de grado',598],['Trabajo final de grado',589],['Documento de trabajo',559],['Libro',351],['Tesis doctoral',243],]);

        // Set options for Anthony's pie chart.
        var options = {title:'Distribución por tipo de Item',
					   is3D: true,	
                       width:600,
                       height:300};

        // Instantiate and draw the chart for Anthony's pizza.
        chartt = new google.visualization.PieChart(document.getElementById('div_type'));
		google.visualization.events.addListener(chartt, 'select', selectHandlerType); 
        chartt.draw(datat, options);
      }

	  
	  
	  function selectHandlerSubject() 
      {
		var selectedItem = charts.getSelection()[0];

		if (selectedItem) 
		{
			var subject = datas.getValue(selectedItem.row, 0);
			window.location.href = "simple-search?filterquery="+subject+"&filtername=publicationdisciplina&filtertype=equals&location=publications#";
			//alert('The user selected ' + topping);
		}
      } 
	  
	  function selectHandlerType() 
      {
		var selectedItem = chartt.getSelection()[0];

		if (selectedItem) 
		{
			var type = datat.getValue(selectedItem.row, 0);
			window.location.href = "simple-search?filterquery="+type+"&filtername=itemtype&filtertype=authority&location=publications";
			
		}
      } 



    
	</script>


