ga('create', 'UA-126449882-1', 'auto');
ga('send', 'pageview');
</script>
<style>
.ojs-readonly-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    font-family: "Noto Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.ojs-readonly-popup {
    background: #ffffff;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    max-width: 700px;
    width: 95%;
    margin: 20px;
    max-height: 85vh;	
    position: relative;
    animation: popupSlide 0.3s ease-out;
    overflow-y: auto;
}

@keyframes popupSlide {
    from {
        opacity: 0;
        transform: translateY(-30px) scale(0.9);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.popup-header {
    background: linear-gradient(135deg, #d73c3c, #f39c12);
    color: white;
    padding: 20px;
    text-align: center;
    border-radius: 8px 8px 0 0;
    position: relative;
}

.popup-icon {
    font-size: 2.5rem;
    margin-bottom: 10px;
    display: block;
}

.popup-title {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 0;
}

.popup-body {
    padding: 30px;
}

.language-section {
    margin-bottom: 25px;
    padding-bottom: 20px;
    border-bottom: 1px solid #e0e0e0;
}

.language-section:last-of-type {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
}

.language-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
}

.flag {
    margin-right: 8px;
    font-size: 1.2em;
}

.message-text {
    color: #555;
    line-height: 1.6;
    font-size: 0.95rem;
}

.contact-highlight {
    background: #f8f9fa;
    padding: 15px;
    border-left: 4px solid #007acc;
    margin: 15px 0;
    border-radius: 0 6px 6px 0;
}

.contact-text {
    font-weight: 500;
    color: #007acc;
    margin: 0;
}

.new-site-notice {
    background: linear-gradient(135deg, #e8f5e8, #f0f8ff);
    padding: 15px;
    border-left: 4px solid #28a745;
    margin: 15px 0;
    border-radius: 0 6px 6px 0;
    border: 1px solid #d4edda;
}

.new-site-text {
    font-weight: 500;
    color: #155724;
    margin: 0;
}

.popup-footer {
    padding: 20px 30px;
    background: #f8f9fa;
    text-align: center;
    border-radius: 0 0 8px 8px;
}

.btn-understand {
    background: #007acc;
    color: white;
    border: none;
    padding: 12px 30px;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    min-width: 120px;
}

.btn-new-site {
    background: #155724;
    color: white;
    border: none;
    padding: 12px 30px;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    min-width: 120px;
}

.btn-understand:hover {
    background: #005a99;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 122, 204, 0.3);
}

.close-btn {
    position: absolute;
    top: 15px;
    right: 20px;
    background: none;
    border: none;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.3s ease;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.close-btn:hover {
    opacity: 1;
}

@media (max-width: 600px) {
    .ojs-readonly-popup {
        width: 95%;
        margin: 10px;
    }
    
    .popup-body {
        padding: 20px;
    }
    
    .popup-footer {
        padding: 15px 20px;
    }
    
    .popup-buttons {
        flex-direction: column;
        gap: 10px;
    }
    
    .btn-new-site {
        margin-right: 0;
        width: 100%;
    }
    
    .btn-understand {
        width: 100%;
    }
}
</style>

<div class="ojs-readonly-overlay" id="readonlyPopup">
    <div class="ojs-readonly-popup">
        <div class="popup-header">
            <button class="close-btn" onclick="closeReadonlyPopup()" aria-label="Close">×</button>
            <div class="popup-icon"></div>
            <h2 class="popup-title">Important Notice</h2>
        </div>
        
        <div class="popup-body">
            <div class="language-section">
                <h3 class="language-title">
                </h3>
                <p class="message-text">
		Este sitio web es la versión histórica de nuestro portal de revistas.  <br> Todos los artículos continúan disponibles en <strong>acceso abierto</strong> para consulta y descarga. 
                </p>
                <div class="contact-highlight">
                    <p class="contact-text">
			Importante: En este sitio ya no es posible registrarse ni enviar nuevos manuscritos.<br>  
			 Para envíos y nuevas gestiones editoriales, por favor utilice nuestro <strong>nuevo portal</strong>.  
                    </p>
                </div>
            </div>

            <div class="language-section">
                <h3 class="language-title">
                </h3>
                <p class="message-text">
		This is the historical version of our journals portal. <br> All articles remain available in <strong>open access</strong> for consultation and download.  
                </p>
                <div class="contact-highlight">
                    <p class="contact-text">
			Please note: Registration and new submissions are no longer possible on this site.<br>             For manuscript submissions and editorial processes, please use our <strong>new portal</strong>.

                    </p>
                </div>
            </div>
        </div>
       
        <div class="popup-footer">
            <div class="popup-buttons">
                <a href="https://revistas.ucr.ac.cr" class="btn-new-site" target="_blank" rel="noopener noreferrer">
                    🌐  New portal
                </a> <br> <br> <br>
                <button class="btn-understand" onclick="closeReadonlyPopup()">
                    Entendido / Understood
                </button>
            </div>
        </div>
    </div>
</div>

<script>
function closeReadonlyPopup() {
    const popup = document.getElementById('readonlyPopup');
    popup.style.animation = 'fadeOut 0.3s ease-out forwards';
    setTimeout(() => {
        popup.style.display = 'none';
        sessionStorage.setItem('ojsReadonlyPopupShown', 'true');
    }, 300);
}

function showReadonlyPopup() {
    const popup = document.getElementById('readonlyPopup');
    popup.style.display = 'flex';
}

// Verificar si mostrar popup
document.addEventListener('DOMContentLoaded', function() {
    const alreadyShown = sessionStorage.getItem('ojsReadonlyPopupShown');
    if (!alreadyShown) {
        setTimeout(showReadonlyPopup, 1500);
    }
});

// Cerrar con Escape o click fuera
document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        closeReadonlyPopup();
    }
});

document.addEventListener('click', function(event) {
    const popup = document.getElementById('readonlyPopup');
    if (event.target === popup) {
        closeReadonlyPopup();
    }
});

// Animación fade out
const fadeOutStyle = document.createElement('style');
fadeOutStyle.textContent = `
    @keyframes fadeOut {
        from { opacity: 1; }
        to { opacity: 0; }
    }
`;
document.head.appendChild(fadeOutStyle);
</script>

</body>
</html>
