</metadata></record><record><header><identifier>oai:rephip.unr.edu.ar:2133/31652</identifier><datestamp>2025-12-05T14:00:20Z</datestamp><setSpec>com_2133_17332</setSpec><setSpec>col_2133_31550</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
   <dc:title>Boletín estadístico de la ciudad de Rosario. Primer, segundo, tercer y cuarto trimestre, 1942</dc:title>
   <dc:creator>Dirección General de Estadística de la Municipalidad de Rosario</dc:creator>
   <dc:subject>Rosario</dc:subject>
   <dc:subject>Datos</dc:subject>
   <dc:subject>Estadística</dc:subject>
   <dc:subject>Demografía histórica</dc:subject>
   <dc:subject>Boletín</dc:subject>
   <dc:description>Este archivo contiene los boletines estadísticos de la ciudad de Rosario correspondiente al primer, segundo, tercer y cuarto trimestre del año 1942. Este boletín incluye secciones dedicadas a: Demografía (nacimientos, matrimonios, defunciones); estadística sanitaria (administración sanitaria y asist. social, inhumaciones, maternidad, morbilidad hospitalaria, denuncia de enfermedades infectocontagiosas y parasitarias); servicios y salud pública; economía y finanzas; edificación y movimiento inmobiliario; cultura y espectáculos públicos; transportes y comunicaciones; policía; y climatología.</dc:description>
   <dc:description>Municipalidad de Rosario</dc:description>
   <dc:publisher>Municipalidad de Rosario</dc:publisher>
   <dc:date>1943-01-02</dc:date>
