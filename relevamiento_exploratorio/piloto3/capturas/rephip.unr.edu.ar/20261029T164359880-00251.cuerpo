</oai_dc:dc>
</metadata></record><record><header><identifier>oai:rephip.unr.edu.ar:2133/17515</identifier><datestamp>2026-10-06T06:00:13Z</datestamp><setSpec>com_2133_13992</setSpec><setSpec>com_2133_13978</setSpec><setSpec>col_2133_13999</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
   <dc:title>¿Cuánto gana mi vecino? Contrastes en Rosario</dc:title>
   <dc:creator>Tessmer, Germán Adolfo</dc:creator>
   <dc:creator>Martín, Norberto</dc:creator>
   <dc:subject>Distribución del ingreso</dc:subject>
   <dc:subject>Ingreso per cápita familiar</dc:subject>
   <dc:subject>Deciles</dc:subject>
   <dc:subject>Hogares</dc:subject>
   <dc:subject>Género</dc:subject>
   <dc:subject>Educación</dc:subject>
   <dc:subject>Gran Rosario</dc:subject>
   <dc:description>Se caracteriza la población del Aglomerado Gran Rosario, según los niveles de ingreso por hogar.</dc:description>
   <dc:description>A characterization of the population of the Greater Rosario Area by household income level.</dc:description>
   <dc:description>Fil: Tessmer, Germán Adolfo. Universidad Nacional de Rosario. Observatorio Económico Social; Argentina.</dc:description>
