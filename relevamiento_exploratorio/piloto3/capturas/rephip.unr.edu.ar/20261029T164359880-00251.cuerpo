</metadata></record><record><header><identifier>oai:rephip.unr.edu.ar:2133/31647</identifier><datestamp>2025-12-05T05:00:23Z</datestamp><setSpec>com_2133_17332</setSpec><setSpec>col_2133_31550</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
   <dc:title>Anuario estadístico de la ciudad de Rosario. Años 1938, 1939 y 1940</dc:title>
   <dc:creator>Dirección General de Estadística de la Municipalidad de Rosario</dc:creator>
   <dc:subject>Rosario</dc:subject>
   <dc:subject>Datos</dc:subject>
   <dc:subject>Estadística</dc:subject>
   <dc:subject>Boletín</dc:subject>
   <dc:subject>Demografía histórica</dc:subject>
   <dc:description>Este archivo contiene los Anuarios Estadísticos de la ciudad de Rosario correspondientes a 1938, 1939 y 1940, elaborados por la Dirección General de Estadística Municipal. Incluye información sobre climatología; territorio y vías públicas; edificación y actividad inmobiliaria; población y movimiento demográfico; salud pública y asistencia social; servicios públicos; abastecimiento y precios; crédito; transportes y comunicaciones; enseñanza y cultura; policía; finanzas municipales y estadística electoral.</dc:description>
   <dc:description>Municipalidad de Rosario</dc:description>
