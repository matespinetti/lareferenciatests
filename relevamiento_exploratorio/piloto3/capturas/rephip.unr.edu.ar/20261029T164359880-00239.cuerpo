84b-f2d394c1ea19/thumbnail"]},"https://rephip.unr.edu.ar/server/api/core/items/c322b388-623f-498e-884b-f2d394c1ea19":{"data":{"handle":"2133/34321","lastModified":"2026-10-29T06:02:30.836Z","isArchived":true,"isDiscoverable":true,"isWithdrawn":false,"_links":{"accessStatus":{"href":"https://rephip.unr.edu.ar/server/api/core/items/c322b388-623f-498e-884b-f2d394c1ea19/accessStatus"},"bundles":{"href":"https://rephip.unr.edu.ar/server/api/core/items/c322b388-623f-498e-884b-f2d394c1ea19/bundles"},"identifiers":{"href":"https://rephip.unr.edu.ar/server/api/core/items/c322b388-623f-498e-884b-f2d394c1ea19/identifiers"},"mappedCollections":{"href":"https://rephip.unr.edu.ar/server/api/core/items/c322b388-623f-498e-884b-f2d394c1ea19/mappedCollections"},"owningCollection":{"href":"https://rephip.unr.edu.ar/server/api/core/items/c322b388-623f-498e-884b-f2d394c1ea19/owningCollection"},"relationships":{"href":"https://rephip.unr.edu.ar/server/api/core/items/c322b388-623f-498e-884b-f2d394c1ea19/relationships"},"version":{"href":"https://rephip.unr.edu.ar/server/api/core/items/c322b388-623f-498e-884b-f2d394c1ea19/version"},"templateItemOf":{"href":"https://rephip.unr.edu.ar/server/api/core/items/c322b388-623f-498e-884b-f2d394c1ea19/templateItemOf"},"thumbnail":{"href":"https://rephip.unr.edu.ar/server/api/core/items/c322b388-623f-498e-884b-f2d394c1ea19/thumbnail"},"submitter":{"href":"https://rephip.unr.edu.ar/server/api/core/items/c322b388-623f-498e-884b-f2d394c1ea19/submitter"},"self":{"href":"https://rephip.unr.edu.ar/server/api/core/items/c322b388-623f-498e-884b-f2d394c1ea19"}},"_name":"SISTEMAS DE CRÉDITOS UNIVERSITARIOS EN ARGENTINA Y PAÍSES LIMÍTROFES","id":"c322b388-623f-498e-884b-f2d394c1ea19","uuid":"c322b388-623f-498e-884b-f2d394c1ea19","type":"item","metadata":{"dc.citation.title":[{"uuid":"83e2f6d3-3c05-488b-94e4-c5e83c359891","language":null,"value":"Informes de Investigación IIATA Nro.10, Noviembre 2026","place":0,"authority":null,"confidence":-1}],"dc.creator":[{"uuid":"3c56938c-244e-40c9-bb62-2403f17be6bc","language":null,"value":"Acosta, Anabel Virginia","place":0,"authority":null,"confidence":-1},{"uuid":"c8109b1f-1f4a-451d-ab1b-0ec097c9fba5","language":null,"value":"Cavallo, Marcela Analía","place":1,"authority":null,"confidence":-1},{"uuid":"4e364e72-8a41-4669-9c24-534691ad1a3b","language":null,"value":"Cicerchia, Nerina","place":2,"authority":null,"confidence":-1},{"uuid":"145aef23-b765-468d-8fbd-8297328b42d7","language":null,"value":"Giménez, Cintia Alejandra","place":3,"authority":null,"confidence":-1},{"uuid":"7585ccf0-443a-4887-8035-50dddf862058","language":null,"value":"Lovagnini, Serenella","place":4,"authority":null,"confidence":-1},{"uuid":"e5f2e826-abef-4c8f-a986-3bff99159546","language":null,"value":"Romanini Porta, María Magdalena","place":5,"authority":null,"confidence":-1},{"uuid":"b8383f03-e4ed-42b3-82bb-1b354ea836df","language":null,"value":"Torregiani, Romina","place":6,"authority":null,"confidence":-1}],"dc.date.accessioned":[{"uuid":"6b2d9b8c-0499-4c70-9c59-2d7144e6cb13","language":null,"value":"2026-10-28T23:28:02Z","place":0,"authority":null,"confidence":-1}],"dc.date.issued":[{"uuid":"d01b2588-c028-41e3-ae54-08144de57b82","language":null,"value":"2026-11","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"64e07555-b8dd-4b1d-8dc5-37b243574c0f","language":null,"value":"El presente trabajo analiza comparativamente los sistemas de créditos académicos universitarios de Argentina, Bolivia, Brasil, Chile, Paraguay y Uruguay, con el objetivo de identificar convergencias, divergencias y tendencias regionales. Mediante un enfoque cualitativo, descriptivo-comparativo y de análisis documental, se relevaron normativas, instrumentos institucionales e informes oficiales\nde cada país, sistematizados en una matriz de categorías (denominación, año de implementación, tipo de norma, alcance, equivalencia horaria, flexibilidad y movilidad, entre otras). Los resultados muestran una convergencia formal hacia un estándar de 25 a 30 horas de trabajo total por crédito y hacia un modelo centrado en el aprendizaje del estudiante, pero también tensiones significativas: disparidad en las unidades de medida (entre 15 y 30 horas según el país), asimetrías en el grado de consolidación normativa (Chile y Uruguay consolidados; Argentina, Bolivia y Paraguay en transición; Brasil sin unificación nacional) y limitaciones de alcance institucional. Si bien existe voluntad de modernización y de integración regional, la ausencia de criterios técnicos unificados continúa siendo el principal obstáculo para la movilidad académica y el reconocimiento ágil de titulaciones en el bloque.","place":0,"authority":null,"confidence":-1},{"uuid":"b9a0b86c-61b7-4382-bc31-b7fbb6fe031b","language":null,"value":"This article presents a comparative analysis of university academic credit systems in Argentina, Bolivia, Brazil, Chile, Paraguay, and Uruguay, aiming to identify convergences, divergences, and regional trends. Employing a qualitative, descriptive-comparative approach based on document analysis, the study examined regulations, institutional instruments, and official reports from each country, systematizing the data into a category matrix (covering aspects such as designation, year of implementation, type of regulation, scope, hourly equivalence, flexibility, and mobility, among others). The results reveal a formal convergence toward a standard of 25 to 30 hours of total workload per credit and a student-centered learning model; however, significant tensions persist, including disparities in measurement units (ranging from 15 to 30 hours depending on the country), asymmetries in the degree of regulatory consolidation (consolidated in Chile and Uruguay; in transition in Argentina, Bolivia, and Paraguay; lacking national unification in Brazil), and limitations regarding institutional scope. While there is a willingness toward modernization and regional integration, the absence of unified technical criteria remains the primary obstacle for academic mobility and the swift recognition of degrees within the bloc.","place":1,"authority":null,"confidence":-1}],"dc.description.fil":[{"uuid":"c457f1b0-d1dd-4404-a058-27baf2c31559","language":null,"value":"Fil: Acosta, Anabel Virginia. Comisión de Educación, Ciencia e Investigación Aplicada del Consejo Profesional de Ciencias Económicas de la Provincia de Santa Fe Cámara II; Argentina.","place":0,"authority":null,"confidence":-1},{"uuid":"d4506ccb-41d6-4853-bf56-0bcbb0774e61","language":null,"value":"Fil: Cavallo, Marcela Analía. Comisión de Educación, Ciencia e Investigación Aplicada del Consejo Profesional de Ciencias Económicas de la Provincia de Santa Fe Cámara II; Argentina.","place":1,"authority":null,"confidence":-1},{"uuid":"8efbb38e-0ffa-4c36-bf65-13b6bc40cbba","language":null,"value":"Fil: Cicerchia, Nerina. Comisión de Educación, Ciencia e Investigación Aplicada del Consejo Profesional de Ciencias Económicas de la Provincia de Santa Fe Cámara II; Argentina.","place":2,"authority":null,"confidence":-1},{"uuid":"91f608a4-d17c-4656-90fe-aff4db3e7d73","language":null,"value":"Fil: Giménez, Cintia. Comisión de Educación, Ciencia e Investigación Aplicada del Consejo Profesional de Ciencias Económicas de la Provincia de Santa Fe Cámara II; Argentina.","place":3,"authority":null,"confidence":-1},{"uuid":"54abafe4-5c96-4e1a-bffa-8df6c011982f","language":null,"value":"Fil: Lovagnini, Serenella. Comisión de Educación, Ciencia e Investigación Aplicada del Consejo Profesional de Ciencias Económicas de la Provincia de Santa Fe Cámara II; Argentina.","place":4,"authority":null,"confidence":-1},{"uuid":"db8ac470-94d5-4bc2-9349-a8cf3778f505","language":null,"value":"Fil: Romanini Porta, María Magdalena. Comisión de Educación, Ciencia e Investigación Aplicada del Consejo Profesional de Ciencias Económicas de la Provincia de Santa Fe Cámara II; Argentina.","place":5,"authority":null,"confidence":-1},{"uuid":"df896280-8a2c-4a29-a1d7-72e4d0fab4af","language":null,"value":"Fil: Torregiani, Romina. Comisión de Educación, Ciencia e Investigación Aplicada del Consejo Profesional de Ciencias Económicas de la Provincia de Santa Fe Cámara II; Argentina.","place":6,"authority":null,"confidence":-1}],"dc.description.version":[{"uuid":"aee786a1-2382-45dd-ae1d-0c2eef30018d","language":null,"value":"peerreviewed","place":0,"authority":null,"confidence":-1}],"dc.format.extent":[{"uuid":"007fd87a-5a02-4daa-8b3b-b0d736fc3d93","language":null,"value":"110-119","place":0,"authority":null,"confidence":-1}],"dc.identifier.issn":[{"uuid":"5e582450-97c2-4840-9fbe-2132eb2143d3","language":null,"value":"2525-1023","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"3e841f14-d211-4dd2-91a2-fb33c5003081","language":null,"value":"https://hdl.handle.net/2133/34321","place":0,"authority":null,"confidence":-1}],"dc.language.iso":[{"uuid":"7ef118ea-0bce-4521-bd46-742db9225ef0","language":null,"value":"es","place":0,"authority":null,"confidence":-1}],"dc.publisher":[{"uuid":"d44be1ad-e5c7-4d0d-91f3-fbd672f60013","language":null,"value":"FCEyE","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"311fab90-615c-4fa6-bc40-36f3e08b486b","language":null,"value":"openAccess","place":0,"authority":null,"confidence":-1}],"dc.rights.text":[{"uuid":"064bca07-4d2c-4ee9-9ec1-63d4dc4b37a0","language":"en","value":"Attribution-NonCommercial-ShareAlike 4.0 International","place":0,"authority":null,"confidence":-1}],"dc.rights.uri":[{"uuid":"1d1fcbce-c01e-46d1-a85d-5c878d04decf","language":null,"value":"http://creativecommons.org/licenses/by-nc-sa/4.0/","place":0,"authority":null,"confidence":-1}],"dc.subject":[{"uuid":"60b9abce-3ab4-4e64-9a83-9764889f40f1","language":null,"value":"Sistemas de Créditos Universitarios","place":0,"authority":null,"confidence":-1},{"uuid":"6547d490-5f28-4c9f-a7cf-be973b46134d","language":null,"value":"Armonización regional","place":1,"authority":null,"confidence":-1},{"uuid":"ef719f1d-d400-4b28-b155-5d37d75d4a71","language":null,"value":"Mercosur","place":2,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"a6da012e-3159-4305-ac97-2d774906c29c","language":null,"value":"SISTEMAS DE CRÉDITOS UNIVERSITARIOS EN ARGENTINA Y PAÍSES LIMÍTROFES","place":0,"authority":null,"confidence":-1}],"dc.type":[{"uuid":"742bf40e-319f-4c6c-be39-123a8718163e","language":null,"value":"articulo","place":0,"authority":null,"confidence":-1}],"dc.type.version":[{"uuid":"7ed4275e-4471-48f2-8edb-81156e28edd5","language":null,"value":"publishedVersion","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793292661150,"msToLive":900000,"requestUUIDs":["client/cb9a7cbf-7333-4ade-b5f6-a89bb90b76b6"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://rephip.unr.edu.ar/server/api/core/bitstreams/bf757e3f-c1a2-4a9f-8288-8b8b83809ac0":{"data":{"sizeBytes":4827,"bundleName":"THUMBNAIL","_links":{"content":{"href":"https://rephip.unr.edu.ar/server/api/core/bitstreams/bf757e3f-c1a2-4a9f-8288-8b8b83809ac0/content"},"bundle":{"href":"https://rephip.unr.edu.ar/server/api/core/bitstreams/bf757e3f-c1a2-4a9f-8288-8b8b83809ac0/bundle"},"accessStatus":{"href":"https://rephip.unr.edu.ar/server/api/core/bitstreams/bf757e3f-c1a2-4a9f-8288-8b8b83809ac0/accessStatus"},"format":{"href":"https://rephip.unr.edu.ar/server/api/core/bitstreams/bf757e3f-c1a2-4a9f-8288-8b8b83809ac0/format"},"thumbnail":{"href":"https://rephip.unr.edu.ar/server/api/core/bitstreams/bf757e3f-c1a2-4a9f-8288-8b8b83809ac0/thumbnail"},"self":{"href":"https://rephip.unr.edu.ar/server/api/core/bitstreams/bf757e3f-c1a2-4a9f-8288-8b8b83809ac0"}},"_name":"120-132.pdf.jpg","id":"bf757e3f-c1a2-4a9f-8288-8b8b83809ac0","uuid":"bf757e3f-c1a2-4a9f-8288-8b8b83809ac0","type":"bitstream","metadata":{"dc.description":[{"uuid":"9f048ddb-d42b-4416-95d4-d95669d0fbc8","language":null,"value":"Generated Thumbnail","place":0,"authority":null,"confidence":-1}],"dc.source":[{"uuid":"fc45bbba-15ef-487f-82c9-a5aae2538168","language":null,"value":"Written by FormatFilter org.dspace.app.mediafilter.PDFBoxThumbnail on 2026-10-29T06:00:28Z (GMT).","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"7ac0b0ec-9b3b-40ae-9f78-ffeec8a57b9e","language":null,"value":"120-132.pdf.jpg","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793292661151,"msToLive":900000,"requestUUIDs":["client/cb9a7cbf-7333-4ade-b5f6-a89bb90b76b6"],"dependentRequestUUIDs":["client/cb9a7cbf-7333-4ade-b5f6-a89bb90b76b6"],"isDirty":false,"patches":[],"alternativeLinks":["https://rephip.unr.edu.ar/server/api/core/items/0c84c29c-3cc3-4d4a-aa3f-cb35171efa8c/thumbnail"]},"https://rephip.unr.edu.ar/server/api/core/items/0c84c29c-3cc3-4d4a-aa3f-cb35171efa8c":{"data":{"handle":"2133/34320","lastModified":"2026-10-29T06:00:28.603Z","isArchived":true,"isDiscoverable":true,"isWithdrawn":false,"_links":{"accessStatus":{"href":"https://rephip.unr.edu.ar/server/api/core/items/0c84c29c-3cc3-4d4a-aa3f-cb35171efa8c/accessStatus"},"bundles":{"href":"https://rephip.unr.edu.ar/server/api/core/items/0c84c29c-3cc3-4d4a-aa3f-cb35171efa8c/bundles"},"identifiers":{"href":"https://rephip.unr.edu.ar/server/api/core/items/0c84c29c-3cc3-4d4a-aa3f-cb35171efa8c/identifiers"},"mappedCollections":{"href":"https://rephip.unr.edu.ar/server/api/core/items/0c84c29c-3cc3-4d4a-aa3f-cb35171efa8c/mappedCollections"},"owningCollection":{"href":"https://rephip.unr.edu.ar/server/api/core/items/0c84c29c-3cc3-4d4a-aa3f-cb35171efa8c/owningCollection"},"relationships":{"href":"https://rephip.unr.edu.ar/server/api/core/items/0c84c29c-3cc3-4d4a-aa3f-cb35171efa8c/relationships"},"version":{"href":"https://rephip.unr.edu.ar/server/api/core/items/0c84c29c-3cc3-4d4a-aa3f-cb35171efa8c/version"},"templateItemOf":{"href":"https://rephip.unr.edu.ar/server/api/core/items/0c84c29c-3cc3-4d4a-aa3f-cb35171efa8c/templateItemOf"},"thumbnail":{"href":"https://rephip.unr.edu.ar/server/api/core/items/0c84c29c-3cc3-4d4a-aa3f-cb35171efa8c/thumbnail"},"submitter":{"href":"https://rephip.unr.edu.ar/server/api/core/items/0c84c29c-3cc3-4d4a-aa3f-cb35171efa8c/submitter"},"self":{"href":"https://rephip.unr.edu.ar/server/api/core/items/0c84c29c-3cc3-4d4a-aa3f-cb35171efa8c"}},"_name":"POLITICAS FISCALES Y MEDIAMBIENTE: FACTIBILIDAD DE LA IMPLEMENTACIÓN DE TRIBUTOS AMBIENTALES EN EL MARCO DE UNA REFORMA FISCAL VERDE EN ARGENTINA","id":"0c84c29c-3cc3-4d4a-aa3f-cb35171efa8c","uuid":"0c84c29c-3cc3-4d4a-aa3f-cb35171efa8c","type":"item","metadata":{"dc.citation.title":[{"uuid":"e0774c13-aa33-46b6-97d4-4b4f0a14aa29","language":null,"value":"Informes de Investigación IIATA Nro.10, Noviembre 2026","place":0,"authority":null,"confidence":-1}],"dc.creator":[{"uuid":"092ca6fd-fb93-4f53-9e2d-64cb91298713","language":null,"value":"Almada, Lorena Marcela","place":0,"authority":null,"confidence":-1}],"dc.date.accessioned":[{"uuid":"3240b871-1795-46e4-a50a-b16191b28b6c","language":null,"value":"2026-10-28T23:13:02Z","place":0,"authority":null,"confidence":-1}],"dc.date.issued":[{"uuid":"3fcc4b4a-288b-49d2-9183-c8262d18cbf3","language":null,"value":"2026-11","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"0177da2d-7bc5-4fdf-b2c9-b7e9c6766dac","language":null,"value":"La conservación y protección del medio ambiente se ha convertido en una de las cuestiones que más preocupan a la sociedad en la actualidad. Los gobiernos son cada vez más conscientes de este interés social, el medio ambiente ha sido reconocido como un bien jurídico digno de tutela, incluso constitucionalmente. Esta idea de protección no por medio de obligaciones prohibiciones, sino por medio de tributos, supone un cambio de mentalidad en el planteamiento del tema. En efecto, se pasa de un derecho de pura imposición estatal a un derecho que implica una colaboración y cooperación entre el estado y la sociedad en el sostenimiento del medio ambiente. Por tanto, y considerando que países como la Argentina recién comienzan a transitar el camino del interés ambiental, y su relación con el ordenamiento fiscal, es que nos proponemos en este trabajo abordar el estudio de los denominados “tributos ecológicos”, como uno de los mecanismos que pueden implementarse, en la búsqueda de soluciones en torno a la cuestión ambiental. La propuesta consiste en pensar un nuevo modelo tributario en favor del medio ambiente, es decir, la implementación de tributos ecológicos debería encuadrarse dentro de una reforma más general de nuestro sistema fiscal.","place":0,"authority":null,"confidence":-1},{"uuid":"2bacf2a2-2776-4ea8-b469-fe48b1db67ec","language":null,"value":"Environmental conservation and protection have become major societal concerns today. Governments are increasingly aware of this public interest, and the environment has been recognized as a legal asset worthy of protection—even at the constitutional level. This concept of protection—achieved not through prohibitions or mandatory obligations, but through taxation— represents a shift in mindset regarding how the issue is approached. Indeed, the focus is moving from a regime based purely on state imposition to one involving collaboration and cooperation between the state and society to sustain the environment. Given that countries like Argentina are just beginning to address environmental concerns in relation to their tax systems, this study aims to examine \"ecological taxes\" as one of the mechanisms that could be implemented to find solutions to environmental issues. The proposal entails envisioning a new tax model that supports the environment; in other words, the implementation of ecological taxes should be framed within a broader reform of our tax system.","place":1,"authority":null,"confidence":-1}],"dc.description.fil":[{"uuid":"fa635334-5911-4d41-ae04-36b4d8286bf5","language":null,"value":"Fil: Almada, Lorena Marcela. Universidad Nacional de Rosario. Facultad de Ciencias Económicas y Estadística. Instituto de investigaciones y asistencia tecnológica en Administración; Argentina.","place":0,"authority":null,"confidence":-1}],"dc.description.version":[{"uuid":"0ffc8eb9-4142-4b5e-baa3-e35bef948618","language":null,"value":"peerreviewed","place":0,"authority":null,"confidence":-1}],"dc.format.extent":[{"uuid":"9cf9954f-6d03-4830-a7e8-e6e9c696219d","language":null,"value":"120-132","place":0,"authority":null,"confidence":-1}],"dc.identifier.issn":[{"uuid":"36afed47-4ac8-4717-8791-85b21fa2fbcc","language":null,"value":"2525-1023","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"2c0cff97-9b15-425b-bf97-b56d198e9be6","language":null,"value":"https://hdl.handle.net/2133/34320","place":0,"authority":null,"confidence":-1}],"dc.language.iso":[{"uuid":"6477f75f-d741-406b-baa6-a7b28b5a83b8","language":null,"value":"es","place":0,"authority":null,"confidence":-1}],"dc.publisher":[{"uuid":"fb896113-00c2-44c2-83bd-2200b39621f1","language":null,"value":"FCEyE","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"d0c8be14-23fa-4c08-8527-1e9af065bfdc","language":null,"value":"openAccess","place":0,"authority":null,"confidence":-1}],"dc.rights.text":[{"uuid":"fbc6baca-973b-4052-b638-8500168d2270","language":"en","value":"Attribution-NonCommercial-ShareAlike 4.0 International","place":0,"authority":null,"confidence":-1}],"dc.rights.uri":[{"uuid":"a0ea801e-600e-4d4e-be63-b76d86b9aaf0","language":null,"value":"http://creativecommons.org/licenses/by-nc-sa/4.0/","place":0,"authority":null,"confidence":-1}],"dc.subject":[{"uuid":"fe95e18b-a3e2-4ac8-8350-c6c37b08319f","language":null,"value":"Medioambiente","place":0,"authority":null,"confidence":-1},{"uuid":"277728b4-597f-4b09-a02e-9a96b4e0d5d5","language":null,"value":"Tributos Ecológicos","place":1,"authority":null,"confidence":-1},{"uuid":"81f8536d-960f-4378-8f43-555a5560a7fe","language":null,"value":"Reforma Fiscal","place":2,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"af36c1f2-93e2-4057-bdd3-264265473c86","language":null,"value":"POLITICAS FISCALES Y MEDIAMBIENTE: FACTIBILIDAD DE LA IMPLEMENTACIÓN DE TRIBUTOS AMBIENTALES EN EL MARCO DE UNA REFORMA FISCAL VERDE EN ARGENTINA","place":0,"authority":null,"confidence":-1}],"dc.type":[{"uuid":"e370b036-2ca4-406d-97ed-67aaddfdc8e5","language":null,"value":"articulo","place":0,"authority":null,"confidence":-1}],"dc.type.version":[{"uuid":"19f480a6-b4c4-4deb-99d4-cdfcdb4fe512","language":null,"value":"publishedVersion","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793292661152,"msToLive":900000,"requestUUIDs":["client/cb9a7cbf-7333-4ade-b5f6-a89bb90b76b6"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://rephip.unr.edu.ar/server/api/discover/search/objects?dsoType=ITEM&sort=dc.date.accessioned,DESC&size=5":{"data":{"type":{"value":"discovery-objects"},"page":[{"type":{"value":"searchresult"},"hitHighlights":{},"_links":{"indexableObject":{"href":"https://rephip.unr.edu.ar/server/api/core/items/057afe93-1a38-4e5f-94b1-88be94ecc1ca"}}},{"type":{"value":"searchresult"},"hitHighlights":{},"_links":{"indexableObject":{"href":"https://rephip.unr.edu.ar/server/api/core/items/a05aaedf-687c-4e13-b3de-d5dc81c59e0d"}}},{"type":{"value":"searchresult"},"hitHighlights":{},"_links":{"indexableObject":{"href":"https://rephip.unr.edu.ar/server/api/core/items/e20b02d2-cba1-4d9a-a8b9-72b208cc750b"}}},{"type":{"value":"searchresult"},"hitHighlights":{},"_links":{"indexableObject":{"href":"https://rephip.unr.edu.ar/server/api/core/items/c322b388-623f-498e-884b-f2d394c1ea19"}}},{"type":{"value":"searchresult"},"hitHighlights":{},"_links":{"indexableObject":{"href":"https://rephip.unr.edu.ar/server/api/core/items/0c84c29c-3cc3-4d4a-aa3f-cb35171efa8c"}}}],"scope":null,"appliedFilters":null,"sort":{"by":"dc.date.accessioned","order":"DESC"},"configuration":null,"_links":{"next":{"href":"https://rephip.unr.edu.ar/server/api/discover/search/objects?dsoType=ITEM&sort=dc.date.accessione