:0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"3ec142b0-c380-426a-9dec-17ef52e8a296","language":null,"value":"Área Académica y de Aprendizaje","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793292661005,"msToLive":900000,"requestUUIDs":["client/9b4c5516-cf82-4ac2-9bff-080ea2cf47f7"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://rephip.unr.edu.ar/server/api/core/communities/8df1c31f-9994-45c7-9e2a-ebf604a7d86b":{"data":{"archivedItemsCount":-1,"_links":{"collections":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/8df1c31f-9994-45c7-9e2a-ebf604a7d86b/collections"},"logo":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/8df1c31f-9994-45c7-9e2a-ebf604a7d86b/logo"},"subcommunities":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/8df1c31f-9994-45c7-9e2a-ebf604a7d86b/subcommunities"},"parentCommunity":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/8df1c31f-9994-45c7-9e2a-ebf604a7d86b/parentCommunity"},"adminGroup":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/8df1c31f-9994-45c7-9e2a-ebf604a7d86b/adminGroup"},"self":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/8df1c31f-9994-45c7-9e2a-ebf604a7d86b"}},"_name":"Área de Acción Social y Gremial","id":"8df1c31f-9994-45c7-9e2a-ebf604a7d86b","uuid":"8df1c31f-9994-45c7-9e2a-ebf604a7d86b","type":"community","metadata":{"dc.description":[{"uuid":"a2728cca-2c76-49d0-9449-308580e319cd","language":null,"value":"\u003Cp class=\"MsoNormal\">El \u003Cb style='mso-bidi-font-weight:normal'>Área de Acción Social y Gremial\u003C/b>  presenta la política global que anima su misión y función: \u003C/p>\r\n\u003Cp class=\"MsoNormal\">Implementación de un modelo de investigación acción, participación integrativa y evaluación por resultados, para el fortalecimiento institucional y el mejoramiento de la calidad de sus servicios. \u003C/p>\r\n\u003Cp class=\"MsoNormal\">Planificación estratégica para evaluar, analizar y diagnosticar las fortalezas y debilidades de esta particular institución, a nivel interno y externo, que permitió visualizar el sistemas de objetivos. \u003C/p>","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"27a6fc9a-7d94-47c1-b0a5-939463fa174d","language":null,"value":"https://rephip.unr.edu.ar/handle/2133/7184","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"04a28888-8bb0-4ab7-b7f7-969ec759c105","language":null,"value":"Área de Acción Social y Gremial","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793292661006,"msToLive":900000,"requestUUIDs":["client/9b4c5516-cf82-4ac2-9bff-080ea2cf47f7"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://rephip.unr.edu.ar/server/api/core/communities/59acbc0b-bb3e-4b70-8fd0-a0c471de0b67":{"data":{"archivedItemsCount":-1,"_links":{"collections":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/59acbc0b-bb3e-4b70-8fd0-a0c471de0b67/collections"},"logo":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/59acbc0b-bb3e-4b70-8fd0-a0c471de0b67/logo"},"subcommunities":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/59acbc0b-bb3e-4b70-8fd0-a0c471de0b67/subcommunities"},"parentCommunity":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/59acbc0b-bb3e-4b70-8fd0-a0c471de0b67/parentCommunity"},"adminGroup":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/59acbc0b-bb3e-4b70-8fd0-a0c471de0b67/adminGroup"},"self":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/59acbc0b-bb3e-4b70-8fd0-a0c471de0b67"}},"_name":"Área de Ciencia, Tecnología e Innovación para el Desarrollo","id":"59acbc0b-bb3e-4b70-8fd0-a0c471de0b67","uuid":"59acbc0b-bb3e-4b70-8fd0-a0c471de0b67","type":"community","metadata":{"dc.identifier.uri":[{"uuid":"b6e991fa-57aa-402d-a37c-1fd333f1ecee","language":null,"value":"https://rephip.unr.edu.ar/handle/2133/17319","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"9e33433a-3ef5-4e8a-b698-0dd65c716cee","language":null,"value":"Área de Ciencia, Tecnología e Innovación para el Desarrollo","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793292661006,"msToLive":900000,"requestUUIDs":["client/9b4c5516-cf82-4ac2-9bff-080ea2cf47f7"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://rephip.unr.edu.ar/server/api/core/communities/4952fa9f-0609-4116-b680-5a8875090191":{"data":{"archivedItemsCount":-1,"_links":{"collections":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/4952fa9f-0609-4116-b680-5a8875090191/collections"},"logo":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/4952fa9f-0609-4116-b680-5a8875090191/logo"},"subcommunities":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/4952fa9f-0609-4116-b680-5a8875090191/subcommunities"},"parentCommunity":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/4952fa9f-0609-4116-b680-5a8875090191/parentCommunity"},"adminGroup":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/4952fa9f-0609-4116-b680-5a8875090191/adminGroup"},"self":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/4952fa9f-0609-4116-b680-5a8875090191"}},"_name":"Área de Derechos Humanos","id":"4952fa9f-0609-4116-b680-5a8875090191","uuid":"4952fa9f-0609-4116-b680-5a8875090191","type":"community","metadata":{"dc.description":[{"uuid":"f4551284-dd9a-4a13-a40f-61a6622f2d5d","language":null,"value":"\u003Cp class=\"MsoNormal\"> El \u003Cb style='mso-bidi-font-weight:normal'> \u003Ca href =\"https://www.unr.edu.ar/secretaria/21/derechos-humanos\" target=\"nueva\">Área de Derechos Humanos\u003C/a> \u003C/b>  tiene como objetivo la promoción, el impulso y el fortalecimiento de acciones acciones vinculadas al campo de los derechos humanos, en estrecha relación con los Departamentos, Cátedras e Institutos dependientes de nuestra Universidad así como con las diferentes organizaciones e instituciones de la sociedad civil que trabajan por este mismo objetivo. \u003C/p>\r\n\u003Cp class=\"MsoNormal\"> Secretaria: Lic. Paula Contino\u003C/p>\r\n\u003Cp class=\"MsoNormal\"> Dirección: Maipú 1065 - 3er piso - Of. 347 Rosario - Argentina - C.P. 2000 \u003C/p>\r\n\u003Cp class=\"MsoNormal\"> Tel.: +54 341 4201200, Int. 371 \u003C/p>\r\n\u003Cp class=\"MsoNormal\">\u003C/p>\r\n\u003Cp class=\"MsoNormal\">\u003C/p>\r\n\u003Cp class=\"MsoNormal\">Email:\u003Ca href=\"derechoshumanosunr@gmail.com\">derechoshumanosunr@gmail.com\u003C/a>,\u003Ca href=\" secretariadeddhh@unr.edu.ar \"> secretariadeddhh@unr.edu.ar \u003C/a>\u003C/p> \r\n\u003Cp class=\"MsoNormal\">Facebook: \u003Ca href=\" https://www.facebook.com/DDHHUNR\" target=\"nueva\"> https://www.facebook.com/DDHHUNR\u003C/a>\u003C/p>\r\n\u003Cp class=\"MsoNormal\">Url: \u003Ca href=\" https://www.unr.edu.ar/secretaria/21/derechos-humanos\" target=\"nueva\"> https://www.unr.edu.ar/secretaria/21/derechos-humanos \u003C/a>\u003C/p>","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"515ee59c-e48e-44f7-89dc-20189ece3534","language":null,"value":"https://rephip.unr.edu.ar/handle/2133/17953","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"f8915732-39e6-4005-9f3c-4a500b8ad92f","language":null,"value":"Área de Derechos Humanos","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793292661012,"msToLive":900000,"requestUUIDs":["client/9b4c5516-cf82-4ac2-9bff-080ea2cf47f7"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://rephip.unr.edu.ar/server/api/core/communities/d132c30e-e4b2-4602-a2ab-f325f70eec36":{"data":{"archivedItemsCount":-1,"_links":{"collections":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/d132c30e-e4b2-4602-a2ab-f325f70eec36/collections"},"logo":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/d132c30e-e4b2-4602-a2ab-f325f70eec36/logo"},"subcommunities":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/d132c30e-e4b2-4602-a2ab-f325f70eec36/subcommunities"},"parentCommunity":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/d132c30e-e4b2-4602-a2ab-f325f70eec36/parentCommunity"},"adminGroup":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/d132c30e-e4b2-4602-a2ab-f325f70eec36/adminGroup"},"self":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/d132c30e-e4b2-4602-a2ab-f325f70eec36"}},"_name":"Área de Género y Sexualidades - A.Ge.Sex-UNR","id":"d132c30e-e4b2-4602-a2ab-f325f70eec36","uuid":"d132c30e-e4b2-4602-a2ab-f325f70eec36","type":"community","metadata":{"dc.description":[{"uuid":"eae940c1-b0a0-4f62-83bb-4d3a5e2274c0","language":null,"value":"\u003Cp class=\"MsoNormal\"> El \u003Cb style='mso-bidi-font-weight:normal'> \u003Ca href =\" https://www.unr.edu.ar/secretaria/182/genero-y-sexualidades\" target=\"nueva\">\u003C/a> ÁREA DE GÉNERO Y SEXUALIDADES \u003C/b> tiene como misión asistir al Rector y al Secretario General en la construcción de una Universidad pública, feminista y popular que contribuya con la tarea de abonar a una sociedad igualitaria, inclusiva, plural y libre de violencias dando respuestas a las demandas de transformación. \u003C/p>\r\n\u003Cp class=\"MsoNormal\">Le corresponden las siguientes funciones:\u003C/p>\r\n\u003Cp class=\"MsoNormal\">\r\n\u003Cli> Entender en todo lo relativo a la transformación institucional, potenciando desde los feminismos, los principios democráticos que sostienen la Universidad. \u003C/li>\r\n\u003Cli> Desarrollar un Plan Integral de Igualdad. \u003C/li>\r\n\u003Cli> Proponer y ejecutar programas de formación y capacitación destinados a la comunidad universitaria amparados en la Ley de Educación Sexual Integral, Ley Micaela de Capacitación Obligatoria en Género para todas la comunidad universitaria. \u003C/li>\r\n\u003Cli> Diseñar y desarrollar estrategias de transversalización de la perspectiva de género en los planes de estudio y en políticas de gestión, investigación y extensión. \u003C/li>\r\n\u003Cli> Diagnosticar y producir informes sobre los trayectorias laborales y formativas desde una perspectiva de género. \u003C/li>\r\n\u003Cli> Desarrollar acciones de prevención, abordaje y sensibilización para la erradicación de violencias sexistas. \u003C/li>\u003C/p>\r\n\u003Cp class=\"MsoNormal\"> Secretaria:\u003C/p>\r\n\u003Cp class=\"MsoNormal\"> Dra. Florencia Laura Rovetto \u003C/p>\r\n\u003Cp class=\"MsoNormal\"> Coordinador General:\u003C/p>\r\n\u003Cp class=\"MsoNormal\"> Dr. Luciano Fabbri \u003C/p>\r\n\u003Cp class=\"MsoNormal\">Redes\u003C/p>\r\n\u003Cp class=\"MsoNormal\">Instagram: @agesexunr\u003C/p>\r\n\u003Cp class=\"MsoNormal\">Facebook: agesexunr\u003C/p>\r\n\u003Cp class=\"MsoNormal\">Email:\u003Ca href=\"mailto: area.ge.sex@gmail.com\">area.ge.sex@gmail.com\u003C/a>\u003C/p>","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"1df7e7cd-352f-4d5d-a0b3-9b880d28c5c7","language":null,"value":"https://rephip.unr.edu.ar/handle/2133/20651","place":0,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"5769bb26-8b5d-4d06-a192-82f17cd966b2","language":null,"value":"Área de Género y Sexualidades - A.Ge.Sex-UNR","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793292661013,"msToLive":900000,"requestUUIDs":["client/9b4c5516-cf82-4ac2-9bff-080ea2cf47f7"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://rephip.unr.edu.ar/server/api/core/communities/search/top?page=0&size=5&sort=dc.title,ASC":{"data":{"type":{"value":"paginated-list"},"pageInfo":{"elementsPerPage":5,"totalElements":37,"totalPages":8,"currentPage":1},"_links":{"first":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/search/top?page=0&size=5&sort=dc.title,asc"},"self":{"href":"https://rephip.unr.edu.ar/server/api/core/communities/search/top?page=0&size=5&sort=dc.title,ASC"},"next":{"href":"https://rephi