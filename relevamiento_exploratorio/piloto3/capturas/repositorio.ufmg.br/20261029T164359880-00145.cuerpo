io.ufmg.br/server/api/core/items/b5310d06-b72f-464e-951a-36515b990ffd/mappedCollections"},"owningCollection":{"href":"https://repositorio.ufmg.br/server/api/core/items/b5310d06-b72f-464e-951a-36515b990ffd/owningCollection"},"relationships":{"href":"https://repositorio.ufmg.br/server/api/core/items/b5310d06-b72f-464e-951a-36515b990ffd/relationships"},"version":{"href":"https://repositorio.ufmg.br/server/api/core/items/b5310d06-b72f-464e-951a-36515b990ffd/version"},"templateItemOf":{"href":"https://repositorio.ufmg.br/server/api/core/items/b5310d06-b72f-464e-951a-36515b990ffd/templateItemOf"},"thumbnail":{"href":"https://repositorio.ufmg.br/server/api/core/items/b5310d06-b72f-464e-951a-36515b990ffd/thumbnail"},"self":{"href":"https://repositorio.ufmg.br/server/api/core/items/b5310d06-b72f-464e-951a-36515b990ffd"}},"_name":"Otimização multiobjetivo para a manutenção seletiva de sistemas de monitoramento geotécnico","id":"b5310d06-b72f-464e-951a-36515b990ffd","uuid":"b5310d06-b72f-464e-951a-36515b990ffd","type":"item","metadata":{"dc.creator":[{"uuid":"146f8ec8-b0ae-42c1-8196-bebab02bd543","language":null,"value":"Giovanna Cristina da Rocha","place":0,"authority":null,"confidence":-1}],"dc.date.accessioned":[{"uuid":"aeb0014a-0559-4f39-ad19-a98a36003354","language":null,"value":"2026-10-29T15:51:41Z","place":0,"authority":null,"confidence":-1}],"dc.date.issued":[{"uuid":"6c9255de-1584-492b-b902-273b2780162c","language":null,"value":"2026-08-28","place":0,"authority":null,"confidence":-1}],"dc.description.abstract":[{"uuid":"eec3d4a6-05e6-4442-b2cd-cca7da416936","language":null,"value":"Maintenance activities play a key role in ensuring the reliability and availability of critical systems, particularly in geotechnical monitoring contexts, where asset failures may compromise operational and environmental safety. This work proposes a multi-objective optimization approach for defining maintenance strategies for geotechnical monitoring systems, considering both the maximization of system reliability and the minimization of associated maintenance costs. Initially, historical failure data from different operational complexes were analyzed, enabling the characterization of failure modes and the adjustment of the Weibull distribution to model time-to-failure of system components. The results indicate a predominance of early-life failures, associated with shape parameters lower than one, suggesting a higher failure rate during the initial stages of operation. Based on this reliability model, a multi-objective optimization problem was formulated, integrating preventive and corrective maintenance decisions, intervention levels, technician allocation, and operational constraints such as time and resource availability. The problem was solved using the NSGA-II evolutionary algorithm, which generates a set of non-dominated solutions representing the trade-off between cost and reliability. The results demonstrate the effectiveness of the proposed approach in identifying efficient maintenance strategies, showing that selective maintenance estrategies focused on critical components can achieve high reliability levels while keeping costs under control. The analysis of the estimated Pareto frontier provides a clear understanding of the trade-offs involved in decision-making, highlighting diminishing returns in reliability gains as maintenance investments increase. It is concluded that the integration of probabilistic reliability modeling and multi-objective optimization techniques represents a valuable tool for maintenance planning in critical systems, supporting more efficient, consistent, and operationally aligned decision-making.","place":0,"authority":null,"confidence":-1}],"dc.identifier.uri":[{"uuid":"2f2e2910-08ea-46b7-9981-935318c12152","language":null,"value":"https://hdl.handle.net/1843/6052","place":0,"authority":null,"confidence":-1}],"dc.language":[{"uuid":"2b402e6f-b0d6-4eb5-a5d7-1cf3948a2220","language":null,"value":"por","place":0,"authority":null,"confidence":-1}],"dc.publisher":[{"uuid":"6d29046b-b3a4-43f2-a8d4-c658c82707d1","language":null,"value":"Universidade Federal de Minas Gerais","place":0,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"57bf7973-b05a-48f3-949b-9612429a78e8","language":null,"value":"Acesso aberto","place":0,"authority":null,"confidence":-1}],"dc.subject":[{"uuid":"1681dfd6-4f8b-45b4-bdca-35cb0147d894","language":null,"value":"Engenharia elétrica","place":0,"authority":null,"confidence":-1},{"uuid":"d2cb1404-a5a5-42c1-a568-5afb707ef2e8","language":null,"value":"Confiabilidade (Engenharia)","place":1,"authority":null,"confidence":-1},{"uuid":"ddb97414-569f-42f9-9a63-befbdd9cce6b","language":null,"value":"Manutenção","place":2,"authority":null,"confidence":-1},{"uuid":"5f9722d0-eff3-4ffe-a613-2c3fd0f683ac","language":null,"value":"Otimização multiobjectivo","place":3,"authority":null,"confidence":-1}],"dc.subject.other":[{"uuid":"a545a30a-9658-4e31-87b6-f424c50989e2","language":null,"value":"Manutenção","place":0,"authority":null,"confidence":-1},{"uuid":"57521047-0ffe-40a1-bf4c-3d1d72e5f9ac","language":null,"value":"Confiabilidade","place":1,"authority":null,"confidence":-1},{"uuid":"e5f8075e-ac9d-403e-853f-cac47c7c115b","language":null,"value":"Otimização Multiobjetivo","place":2,"authority":null,"confidence":-1},{"uuid":"497cb012-6d89-4863-80a1-c73f6abf6bad","language":null,"value":"Monitoramento geotécnico","place":3,"authority":null,"confidence":-1}],"dc.title":[{"uuid":"fa75c15d-9b78-447b-8bd5-8619233120c2","language":null,"value":"Otimização multiobjetivo para a manutenção seletiva de sistemas de monitoramento geotécnico","place":0,"authority":null,"confidence":-1}],"dc.type":[{"uuid":"603930e5-8d1b-4d49-8bf1-c23c2ad8f990","language":null,"value":"Dissertação de mestrado","place":0,"authority":null,"confidence":-1}],"local.contributor.advisor1":[{"uuid":"1a3439f4-00d3-4f63-a038-6cf8e680a4ba","language":null,"value":"Michel Bessani","place":0,"authority":null,"confidence":-1}],"local.contributor.advisor1Lattes":[{"uuid":"7435c336-7f6d-4286-b220-a87ddbc6ff68","language":null,"value":"http://lattes.cnpq.br/9450846955939545","place":0,"authority":null,"confidence":-1}],"local.contributor.referee1":[{"uuid":"fcf8a11b-3f50-4b68-8762-57875ce53581","language":null,"value":"Lucas de Souza Batista","place":0,"authority":null,"confidence":-1},{"uuid":"4710beb5-b9bb-4af8-9d4f-03cfbe90f909","language":null,"value":"Luiza Bernardes Real Ferreira","place":1,"authority":null,"confidence":-1}],"local.creator.Lattes":[{"uuid":"a8b9468b-e8bd-46c8-b93e-52091b15865f","language":null,"value":"http://lattes.cnpq.br/4780276836099243","place":0,"authority":null,"confidence":-1}],"local.description.resumo":[{"uuid":"b89f78e1-d1dd-4f6c-9357-e205d0ee8e19","language":null,"value":"As atividades de manutenção desempenham um papel fundamental na garantia da confiabilidade e disponibilidade de sistemas críticos, particularmente em contextos de monitoramento geotécnico, nos quais a falha dos ativos pode comprometer a segurança operacional e ambiental. Neste trabalho é proposta uma abordagem de otimização multiobjetivo para a definição de estratégias de manutenção de sistemas de monitoramento geotécnico, considerando simultaneamente a maximização da confiabilidade e a minimização dos custos associados às intervenções. Inicialmente, foi realizada a análise de dados históricos de falha provenientes de diferentes complexos operacionais, permitindo a caracterização dos modos de falha e o ajuste da distribuição de Weibull para modelar o tempo até a falha dos componentes. Os resultados evidenciaram a predominância de falhas prematuras, associadas a parâmetros de forma inferiores a um, indicando maior taxa de falhas nos períodos iniciais de operação. Com base nesse modelo de confiabilidade, foi formulado um problema de otimização multiobjetivo que integra decisões de manutenção preventiva e corretiva, níveis de intervenção, alocação de mantenedores e restrições operacionais de tempo e de recursos. O problema foi resolvido por meio do algoritmo evolucionário NSGA-II, capaz de gerar um conjunto de soluções não dominadas representando o trade-off entre custo e confiabilidade. Os resultados demonstraram a eficácia da abordagem proposta na identificação de estratégias de manutenção eficientes, evidenciando que estratégias de manutenção seletivas, baseadas na criticidade dos componentes, podem alcançar níveis elevados de confiabilidade com custos controlados. A análise da fronteira de Pareto estimada permitiu compreender de forma clara os compromissos envolvidos na tomada de decisão, destacando a existência de retornos decrescentes na confiabilidade à medida que os investimentos em manutenção aumentam. Conclui-se que a integração entre a modelagem probabilística de confiabilidade e as técnicas de otimização multiobjetivo constitui uma ferramenta relevante para o planejamento da manutenção de sistemas críticos, contribuindo para decisões mais eficientes, consistentes e alinhadas às necessidades operacionais.","place":0,"authority":null,"confidence":-1}],"local.publisher.country":[{"uuid":"c98379cb-9f47-4a0a-9329-547c9f4ee934","language":null,"value":"Brasil","place":0,"authority":null,"confidence":-1}],"local.publisher.department":[{"uuid":"678905b7-0aa7-42aa-9e58-a26855306e7c","language":null,"value":"ENG - DEPARTAMENTO DE ENGENHARIA ELÉTRICA","place":0,"authority":null,"confidence":-1}],"local.publisher.initials":[{"uuid":"3c536622-1eac-4a97-beeb-76d4be033dfa","language":null,"value":"UFMG","place":0,"authority":null,"confidence":-1}],"local.publisher.program":[{"uuid":"b582bd07-84a9-4d83-95cd-c1f38313170a","language":null,"value":"Programa de Pós-Graduação em Engenharia Elétrica","place":0,"authority":null,"confidence":-1}],"local.subject.cnpq":[{"uuid":"d077bcab-62a1-44e2-880c-f50a0467c70c","language":null,"value":"ENGENHARIAS::ENGENHARIA ELETRICA::TELECOMUNICACOES::SISTEMAS DE TELECOMUNICACOES","place":0,"authority":null,"confidence":-1}]}},"timeCompleted":1793292501287,"msToLive":900000,"requestUUIDs":["client/da560174-8c32-4626-91c7-182d07b58419"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://repositorio.ufmg.br/server/api/core/items/404680c0-dec0-4980-998a-9d47c3df2a0e/thumbnail":{"data":null,"timeCompleted":1793292501287,"msToLive":900000,"requestUUIDs":["client/da560174-8c32-4626-91c7-182d07b58419"],"dependentRequestUUIDs":["client/da560174-8c32-4626-91c7-182d07b58419"],"isDirty":false,"patches":[],"alternativeLinks":["https://repositorio.ufmg.br/server/api/core/items/404680c0-dec0-4980-998a-9d47c3df2a0e/thumbnail"]},"https://repositorio.ufmg.br/server/api/core/items/404680c0-dec0-4980-998a-9d47c3df2a0e":{"data":{"handle":"1843/6051","lastModified":"2026-10-29T14:36:38.482Z","isArchived":true,"isDiscoverable":true,"isWithdrawn":false,"_links":{"accessStatus":{"href":"https://repositorio.ufmg.br/server/api/core/items/404680c0-dec0-4980-998a-9d47c3df2a0e/accessStatus"},"bundles":{"href":"https://repositorio.ufmg.br/server/api/core/items/404680c0-dec0-4980-998a-9d47c3df2a0e/bundles"},"identifiers":{"href":"https://repositorio.ufmg.br/server/api/core/items/404680c0-dec0-4980-998a-9d47c3df2a0e/identifiers"},"mappedCollections":{"href":"https://repositorio.ufmg.br/server/api/core/items/404680c0-dec0-4980-998a-9d47c3df2a0e/mappedCollections"},"owningCollection":{"href":"https://repositorio.ufmg.br/server/api/core/items/404680c0-dec0-4980-998a-9d47c3df2a0e/owningCollection"},"relationships":{"href":"https://repositorio.ufmg.br/server/api/core/items/404680c0-dec0-4980-998a-9d47c3df2a0e/relationships"},"version":{"href":"https://repositorio.ufmg.br/server/api/core/items/404680c0-dec0-4980-998a-9d47c3df2a0e/version"},"templateItemOf":{"href":"https://repositorio.ufmg.br/server/api/core/items/404680c0-dec0-4980-998a-9d47c3df2a0e/templateItemOf"},"thumbnail":{"href":"https://repositorio.ufmg.br/server/api/core/items/404680c0-dec0-4980-998a-9d47c3df2a