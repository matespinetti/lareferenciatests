pace-angular-c1108392464="" class="ng-star-inserted" data-used-theme="base"><ds-base-badges _nghost-dspace-angular-c686605257="" class="ng-star-inserted"><ds-status-badge _ngcontent-dspace-angular-c686605257="" data-used-theme="base"><ds-base-status-badge class="ng-star-inserted"><!----><!----></ds-base-status-badge><!----></ds-status-badge><!----><div _ngcontent-dspace-angular-c686605257=""><ds-type-badge _ngcontent-dspace-angular-c686605257="" class="pr-1" data-used-theme="ufmg"><ds-base-type-badge class="ng-star-inserted"><span class="ng-star-inserted"><span class="badge badge-info"><span class="sr-only">Item type:</span>Artigo de periódico<!----><!----><!----><span class="sr-only">, </span></span></span><!----></ds-base-type-badge><!----></ds-type-badge><ds-access-status-badge _ngcontent-dspace-angular-c686605257="" class="ng-star-inserted" data-used-theme="base"><ds-base-access-status-badge _nghost-dspace-angular-c4161845445="" class="ng-star-inserted"><!----></ds-base-access-status-badge><!----></ds-access-status-badge><!----><!----></div></ds-base-badges><!----></ds-badges><!----></div><ds-truncatable _ngcontent-dspace-angular-c1108392464="" _nghost-dspace-angular-c571785846="" class="ng-star-inserted"><div _ngcontent-dspace-angular-c571785846=""><a _ngcontent-dspace-angular-c1108392464="" role="link" tabindex="0" class="lead item-list-title dont-break-out ng-star-inserted" href="/items/1be39b67-5a2b-4a98-b16e-d17cf08d0182" target="_self">Growth arrested live-attenuated Leishmania infantum KHARON1 null mutants display cytokinesis defect and protective immunity in mice</a><!----><!----><span _ngcontent-dspace-angular-c1108392464="" class="text-muted"><ds-truncatable-part _ngcontent-dspace-angular-c1108392464="" _nghost-dspace-angular-c2660396069=""><div _ngcontent-dspace-angular-c2660396069="" class="clamp-default-1 min-1"><div _ngcontent-dspace-angular-c2660396069="" class="content dont-break-out preserve-line-breaks removeFaded"> (<span _ngcontent-dspace-angular-c1108392464="" class="item-list-publisher ng-star-inserted">Universidade Federal de Minas Gerais</span><!----><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted">, </span><!----><span _ngcontent-dspace-angular-c1108392464="" class="item-list-date ng-star-inserted">2018</span><!---->) <!----><!----><span _ngcontent-dspace-angular-c1108392464="" class="item-list-authors ng-star-inserted"><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted"><span _ngcontent-dspace-angular-c1108392464="">Ana Maria Murta Santi</span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted">; </span><!----></span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted"><span _ngcontent-dspace-angular-c1108392464="">Juliane Sousa Lanza</span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted">; </span><!----></span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted"><span _ngcontent-dspace-angular-c1108392464="">Luiza Guimarães Tunes</span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted">; </span><!----></span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted"><span _ngcontent-dspace-angular-c1108392464="">Jacqueline Araújo Fiuza</span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted">; </span><!----></span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted"><span _ngcontent-dspace-angular-c1108392464="">Gaétan Roy</span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted">; </span><!----></span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted"><span _ngcontent-dspace-angular-c1108392464="">Alessandra da Silva Orfanó</span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted">; </span><!----></span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted"><span _ngcontent-dspace-angular-c1108392464="">Andréa Teixeira de Carvalho</span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted">; </span><!----></span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted"><span _ngcontent-dspace-angular-c1108392464="">Frederic Jean Georges Frezard</span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted">; </span><!----></span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted"><span _ngcontent-dspace-angular-c1108392464="">André Luís Branco de Barros</span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted">; </span><!----></span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted"><span _ngcontent-dspace-angular-c1108392464="">Silvane Maria Fonseca Murta</span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted">; </span><!----></span><span _ngcontent-dspace-angular-c1108392464="" class="ng-star-inserted"><span _ngcontent-dspace-angular-c1108392464="">Rubens Lima do Monte Neto</span><!----></span><!----></span><!----></div><button _ngcontent-dspace-angular-c2660396069="" dsdragclick="" role="button" tabindex="0" class="btn btn-link expandButton p-0" aria-expanded="false"><i _ngcontent-dspace-angular-c2660396069="" class="fa-angle-down fas"></i><span _ngcontent-dspace-angular-c2660396069="" class="ml-1">Mostrar mais</span></button></div></ds-truncatable-part></span><div _ngcontent-dspace-angular-c1108392464="" class="item-list-abstract ng-star-inserted"><ds-truncatable-part _ngcontent-dspace-angular-c1108392464="" _nghost-dspace-angular-c2660396069=""><div _ngcontent-dspace-angular-c2660396069="" class="clamp-default-3 min-3"><div _ngcontent-dspace-angular-c2660396069="" class="content dont-break-out preserve-line-breaks removeFaded"><span _ngcontent-dspace-angular-c1108392464="">Não existe uma vacina segura e eficaz disponível contra a leishmaniose humana, e vacinas com patógenos vivos atenuados têm sido utilizadas como uma alternativa profilática contra a doença. Com o objetivo de obter um parasita Leishmania atenuado para fins vacinais, geramos mutantes nulos de L. infantum para o gene KHARON1 (KH1) (ΔLikh1). Esse gene foi previamente associado a defeitos no crescimento em L. mexicana. A linhagem ΔLikh1 foi obtida e confirmada por meio de PCR, qPCR e Southern blot. Também geramos uma linhagem com o gene KH1 complementado, por meio da introdução de cópias epissomais de KH1. Embora as formas promastigotas de ΔLikh1 tenham apresentado um padrão de crescimento semelhante ao da linhagem selvagem, elas diferem na morfologia, sem que isso afete a viabilidade do parasita. As formas amastigotas de L. infantum deficientes em KH1 não conseguiram manter uma infecção experimental em macrófagos, resultando na formação de células multinucleadas - um fenômeno confirmado pelo fenótipo de atenuação in vivo. A análise do ciclo celular das amastigotas ΔLikh1 revelou células com interrupção na fase G2/M. Camundongos imunizados com ΔLikh1 apresentaram uma carga parasitária reduzida após o desafio com L. infantum virulento, em comparação com camundongos não imunizados. Esse efeito esteve associado a níveis séricos mais elevados de IgG específica contra antígenos solúveis de L. infantum (Li SLA) e a uma maior produção de IL-17. Portanto, os parasitas ΔLikh1 apresentam um fenótipo atenuado - porém ainda capaz de infectar - decorrente de um defeito na citocinese; ao mesmo tempo, induzem imunidade contra a leishmaniose visceral em modelos murinos, tornando-se, assim, candidatos para o desenvolvimento de uma vacina contra a leishmaniose.</span></div><button _ngcontent-dspace-angular-c2660396069="" dsdragclick="" role="button" tabindex="0" class="btn btn-link expandButton p-0" aria-expanded="false"><i _ngcontent-dspace-angular-c2660396069="" class="fa-angle-down fas"></i><span _ngcontent-dspace-angular-c2660396069="" class="ml-1">Mostrar mais</span></button></div></ds-truncatable-part></div><!----></div></ds-truncatable><!----></div></div></ds-item-search-result-list-element><!----></ds-listable-object-component-loader></ds-item-list-element><!----></ds-listable-object-component-loader></li><!----></ul><button _ngcontent-dspace-angular-c1672724769="" role="link" tabindex="0" class="btn btn-primary search-button mt-4 ng-tns-c1672724769-4"> Carregar mais ... </button></div><!----><!----><!----><!----><!----></ds-recent-item-list><!----><!----><!----></div></div><!----></div></div></div></div></ds-page-with-sidebar><!----><!----><!----><!----></ds-base-configuration-search-page><!----></ds-configuration-search-page><!----><!----><ds-suggestions-popup _ngcontent-dspace-angular-c2263277992="" _nghost-dspace-angular-c3155373292="" class="ng-tns-c3155373292-3 ng-star-inserted"><!----></ds-suggestions-popup><!----></ds-base-home-page><!----></ds-home-page><!----></div></main><ds-footer _ngcontent-dspace-angular-c2190221462="" class="ng-tns-c2190221462-0" data-used-theme="ufmg"><ds-themed-footer _nghost-dspace-angular-c2501891349="" class="ng-star-inserted"><footer _ngcontent-dspace-angular-c2501891349=""><!----><div _ngcontent-dspace-angular-c2501891349="" class="bottom-footer p-1 d-flex flex-column flex-md-row justify-content-center align-items-center text-white"><div _ngcontent-dspace-angular-c2501891349="" class="content-container align-self-center"><div _ngcontent-dspace-angular-c2501891349="" class="logo-ufmg"><p _ngcontent-dspace-angular-c2501891349="" class="m-0"><a _ngcontent-dspace-angular-c2501891349="" href="https://ufmg.br/" role="link" tabindex="0" class="text-white"><img _ngcontent-dspace-angular-c2501891349="" src="/assets/ufmg/images/logo-ufmg.svg" width="60%" alt="Logo UFMG"></a></p></div></div><!----></div></footer></ds-themed-footer><!----></ds-footer></div></div><ds-notifications-board _ngcontent-dspace-angular-c2190221462="" class="ng-tns-c2190221462-0"><div class="notifications-wrapper position-fixed top right"><!----></div></ds-notifications-board><!----><ds-live-region _ngcontent-dspace-angu