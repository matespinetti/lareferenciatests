</metadata></record><record><header><identifier>oai:repositorio.ufmg.br:1843/3884</identifier><datestamp>2026-07-31T12:04:33Z</datestamp><setSpec>com_1843_3</setSpec><setSpec>col_1843_271</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
   <dc:title>Institutional duality: Understanding the relationship between culture, institutions, and underdevelopment</dc:title>
   <dc:creator>Wallace Marcelino Pereira</dc:creator>
   <dc:creator>Gustavo Britto</dc:creator>
   <dc:creator>João Prates Romero</dc:creator>
   <dc:subject>Desenvolvimento econômico</dc:subject>
   <dc:subject>América Latina</dc:subject>
