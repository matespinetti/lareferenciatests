</metadata></record><record><header><identifier>oai:repositorio.ufmg.br:1843/2306</identifier><datestamp>2026-03-30T22:11:18Z</datestamp><setSpec>com_1843_3</setSpec><setSpec>col_1843_271</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
   <dc:title>Editorial: nutritional factors and interventions in environmental-borne diseases</dc:title>
   <dc:title>Editorial: fatores nutricionais e intervenções em doenças transmitidas pelo ambiente</dc:title>
   <dc:creator>Reinaldo Barreto Oriá</dc:creator>
   <dc:creator>Ronald Pinheiro</dc:creator>
   <dc:creator>Jacqueline Isaura Alvarez-Leite</dc:creator>
   <dc:subject>Doença ambiental</dc:subject>
   <dc:subject>Poluentes ambientais</dc:subject>
   <dc:subject>Ciências da nutrição</dc:subject>
   <dc:subject>Environmental enteric dysfunction (EED)</dc:subject>
   <dc:subject>Pollutants</dc:subject>
   <dc:subject>Congenital heart defect</dc:subject>
   <dc:subject>Metabolic syndrome risk factor</dc:subject>
   <dc:subject>Malnutrition</dc:subject>
   <dc:subject>Trace elements</dc:subject>
   <dc:subject>Oxidative stress</dc:subject>
   <dc:subject>Insulin resistance</dc:subject>
   <dc:description>Environmental diseases affect vulnerable populations, exacerbated by poverty and poor sanitation. This topic brings together studies on intestinal pathogens, trace elements, BPA exposure, and nutritional interventions. Evidence shows impacts on growth, development, and metabolic risk, highlighting the role of nutrition in preventing and mitigating harm to human health.</dc:description>
   <dc:date>2026-03-30T22:11:17Z</dc:date>
   <dc:date>2023</dc:date>
