   <dc:rights>Acesso aberto</dc:rights>
   <dc:format>application/pdf</dc:format>
   <dc:publisher>Universidade Federal de Minas Gerais</dc:publisher>
</oai_dc:dc>
</metadata></record><record><header><identifier>oai:repositorio.ufmg.br:1843/3759</identifier><datestamp>2026-07-28T19:58:26Z</datestamp><setSpec>com_1843_3</setSpec><setSpec>col_1843_333</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
