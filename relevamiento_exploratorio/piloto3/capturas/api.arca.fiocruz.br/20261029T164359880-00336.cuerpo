                  <mods:namePart>Santos, Solange Laurentino dos</mods:namePart>
               </mods:name>
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">author</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Augusto, Lia Giraldo da Silva</mods:namePart>
