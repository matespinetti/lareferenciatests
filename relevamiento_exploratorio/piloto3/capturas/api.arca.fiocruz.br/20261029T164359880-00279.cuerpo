   <dc:title>A história de construção das portarias de consolidação do Sistema Único de Saúde: um marco normativo</dc:title>
   <dc:title>La historia de la construcción de las ordenanzas de consolidación del Sistema Único de Salud: un hito normativo</dc:title>
   <dc:title>The history of the construction of the consolidation ordinances of the Unified Health System: a normative milestone</dc:title>
   <dc:creator>Mendes, Daphne Sarah Gomes Jacob</dc:creator>
   <dc:creator>Rodrigues, Maria Ester Simões Nogueira</dc:creator>
   <dc:creator>Montagner, Miguel Ângelo</dc:creator>
   <dc:subject>Sistema Único de Saúde</dc:subject>
   <dc:subject>Direito Sanitário</dc:subject>
   <dc:subject>Portarias de Consolidação</dc:subject>
   <dc:subject>Unified Health System</dc:subject>
   <dc:subject>Health Law</dc:subject>
