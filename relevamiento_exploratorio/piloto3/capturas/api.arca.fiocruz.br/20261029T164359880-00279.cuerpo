   <dc:title>Pandemia da COVID-19: revelando interfaces entre saúde, ambiente e desenvolvimento</dc:title>
   <dc:title>Pandemic of the COVID-19: revealing interfaces between health, environment and development</dc:title>
   <dc:creator>Santos, Solange Laurentino dos</dc:creator>
   <dc:creator>Augusto, Lia Giraldo da Silva</dc:creator>
   <dc:creator>Medeiros, Marcilio Sandro de</dc:creator>
   <dc:creator>Costa, André Monteiro</dc:creator>
   <dc:creator>Mertens, Frederic Adelin Georges</dc:creator>
