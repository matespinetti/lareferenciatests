   <dc:title>Febre Amarela e Malária: investigação de dois surtos zoonóticos no Sudeste brasileiro</dc:title>
   <dc:creator>Abreu, Filipe Vieira Santos de</dc:creator>
   <dc:contributor>Oliveira, Ricardo Lourenço de</dc:contributor>
   <dc:subject>Febre Amarela</dc:subject>
