   <dc:title>Benign-by-design SAHA analogues for human and animal vector-borne parasitic diseases</dc:title>
   <dc:creator>Rossi, Michele</dc:creator>
   <dc:creator>Martinengo, Bianca</dc:creator>
   <dc:creator>Diamanti, Eleonora</dc:creator>
   <dc:creator>Salerno, Alessandra</dc:creator>
   <dc:creator>Rizzardi, Nicola</dc:creator>
   <dc:creator>Fato, Romana</dc:creator>
   <dc:creator>Bergamini, Christian</dc:creator>
   <dc:creator>Oliveira, Andressa Souza de</dc:creator>
   <dc:creator>Ferreira, Thais de Araújo Marques</dc:creator>
   <dc:creator>Holanda, Cleonice Andrade</dc:creator>
   <dc:creator>Romeiro, Luiz Antonio Soares</dc:creator>
   <dc:creator>Soeiro, Maria de Nazaré Correia</dc:creator>
   <dc:creator>Costa, Krislayne Nunes da</dc:creator>
   <dc:creator>Fiuza, Ludmila Ferreira de Almeida</dc:creator>
