   <dc:title>Monitoramento e avaliação ecotoxicológica de níveis ambientais de cocaína e benzoilecgonina em águas fluviais no Rio de Janeiro</dc:title>
   <dc:title>Monitoring and ecotoxicological assessment of environmental levels of cocaine and benzoylecgonine in river waters in Rio de Janeiro</dc:title>
   <dc:creator>Araujo, Gabriel de Farias</dc:creator>
   <dc:contributor>Correia, Fábio Veríssimo</dc:contributor>
   <dc:contributor>Saggioro, Enrico Mendes</dc:contributor>
   <dc:contributor>Pereira, Henrique Marcelo Gualberto</dc:contributor>
   <dc:contributor>Gomes, Márcia Marques</dc:contributor>
