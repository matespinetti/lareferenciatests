   <dc:title>Computationally-guided drug repurposing enables the discovery of kinase targets and inhibitors as new schistosomicidal agents</dc:title>
   <dc:creator>Giuliani, Sandra</dc:creator>
   <dc:creator>Silva, Arthur de Carvalho</dc:creator>
   <dc:creator>Borba, Joyce Villa Verde Borba</dc:creator>
