</metadata></record><record><header><identifier>oai:arca.fiocruz.br:icict/70657</identifier><datestamp>2026-10-26T16:37:51Z</datestamp><setSpec>com_icict_3790</setSpec><setSpec>col_icict_9624</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
   <dc:title>Relato de experiência sobre um curso de especialização em medicina tropical na modalidade a distância oferecido pela Unyleya</dc:title>
   <dc:title>Relato de experiencia sobre un curso de especialización en medicina tropical en modalidad a distancia ofrecido por Unyleya</dc:title>
   <dc:title>Experience report on a distance learning specialization course in tropical medicine offered by Unyleya</dc:title>
   <dc:creator>Hasslocher-Moreno, Alejandro Marcel</dc:creator>
   <dc:creator>Hargreaves, Luiz Henrique</dc:creator>
   <dc:creator>Hasslocher, Ciro Carneiro</dc:creator>
   <dc:subject>Ensino a Distância</dc:subject>
