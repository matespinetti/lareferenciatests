               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Transição para um novo centro de distribuição logístico em uma indústria de confecção</mods:title>
               </mods:titleInfo>
               <mods:genre>Trabalho de conclusão de curso</mods:genre>
            </mods:mods>
