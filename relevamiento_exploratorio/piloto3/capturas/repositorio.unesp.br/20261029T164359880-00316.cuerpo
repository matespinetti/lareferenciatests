</oai_dc:dc></metadata></record><record><header><identifier>oai:repositorio.unesp.br:11449/330789</identifier><datestamp>2026-08-28T05:12:42Z</datestamp><setSpec>com_11449_253922</setSpec><setSpec>com_11449_1</setSpec><setSpec>col_11449_253973</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
   <dc:title>Reticulados em corpos ciclotômicos</dc:title>
   <dc:creator>Simonato, Adriano Luís [UNESP]</dc:creator>
