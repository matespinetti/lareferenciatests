   <dc:title>A temática existencialista de Albert Camus e Clarice Lispector</dc:title>
   <dc:creator>Oliveira, Wanda Aparecida Leonardo de [UNESP]</dc:creator>
   <dc:contributor>Coronado, Guillermo de la Cruz [UNESP]</dc:contributor>
