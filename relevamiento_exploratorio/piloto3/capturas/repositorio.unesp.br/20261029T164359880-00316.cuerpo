   <dc:title>Galilean Podolsky electrodynamics</dc:title>
   <dc:creator>Pompeia, P. J. [UNESP]</dc:creator>
   <dc:creator>De Montigny, M.</dc:creator>
   <dc:creator>Khanna, F. C.</dc:creator>
   <dc:contributor>University of Alberta</dc:contributor>
