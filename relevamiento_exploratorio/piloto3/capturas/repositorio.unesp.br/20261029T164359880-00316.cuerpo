</oai_dc:dc></metadata></record><record><header><identifier>oai:repositorio.unesp.br:11449/307909</identifier><datestamp>2026-10-07T19:07:44Z</datestamp><setSpec>com_11449_26405</setSpec><setSpec>com_11449_1</setSpec><setSpec>col_11449_30899</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
   <dc:title>Contributions to the knowledge of Pabstiella (Orchidaceae: Pleurothallidinae) from Brazil: A new species, new synonyms and taxonomic notes</dc:title>
   <dc:creator>Gutiérrez Morales, Nicolás </dc:creator>
   <dc:creator>de Brito, A.L.V. Toscano</dc:creator>
   <dc:creator>Restrepo, Eugenio</dc:creator>
   <dc:creator>Gil-Amaya, Karen</dc:creator>
   <dc:creator>de Camargo Smidt, Eric </dc:creator>
   <dc:contributor>Universidade Estadual Paulista (UNESP)</dc:contributor>
   <dc:contributor>Universidade Federal do Paraná (UFPR)</dc:contributor>
   <dc:contributor>Fundación Ecotonos</dc:contributor>
   <dc:contributor>Marie Selby Botanical Gardens</dc:contributor>
   <dc:contributor>Universidad de Caldas</dc:contributor>
   <dc:contributor>University of Costa Rica</dc:contributor>
   <dc:subject>Atlantic Rainforest</dc:subject>
   <dc:subject>endemism</dc:subject>
   <dc:subject>epiphyte</dc:subject>
   <dc:subject>Serra do Mar</dc:subject>
   <dc:subject>taxonomy</dc:subject>
   <dc:description>A new species of Pabstiella native to the southeastern Brazilian Atlantic Rainforest is described and illustrated. The new species is compared with morphologically similar taxa, and its infrageneric placement is inferred based on morphology. In addition, six species are proposed as synonyms: P. dasilvae [= P. fragae], P. discors [=P. garayi], P. isabelae [=P. gossameri], P. melior [=P. brachystele], P. naimekei [=P. ezechiasi] and P. setibensis [=P. savioi]. Respective photographs and taxonomic discussions are provided for each case.</dc:description>
