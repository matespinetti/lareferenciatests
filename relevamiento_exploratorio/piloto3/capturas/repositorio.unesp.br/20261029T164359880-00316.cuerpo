   <dc:title>A psicologia na educação : contribuições da psicologia organizacional na atuação do diretor de escola</dc:title>
   <dc:creator>Reis, Claudio Edward dos [UNESP]</dc:creator>
   <dc:contributor>Gutierrez, Gustavo Luiz [UNESP]</dc:contributor>
   <dc:contributor>Universidade Estadual Paulista (UNESP)</dc:contributor>
   <dc:subject>Psicologia organizacional</dc:subject>
   <dc:subject>Diretores escolares</dc:subject>
   <dc:date>2026-06-11T16:48:17Z</dc:date>
   <dc:date>1995</dc:date>
   <dc:type>Dissertação de mestrado</dc:type>
   <dc:identifier>https://hdl.handle.net/11449/325446</dc:identifier>
   <dc:identifier>990000271230206341</dc:identifier>
   <dc:rights>Acesso aberto</dc:rights>
   <dc:format>80 f.</dc:format>
