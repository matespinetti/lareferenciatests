<oai_dc:dc
	xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/"
	xmlns:dc="http://purl.org/dc/elements/1.1/"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/
	http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
	<dc:title xml:lang="en-US"></dc:title>
	<dc:title xml:lang="es-ES">Introducción al pensamiento sociológico</dc:title>
	<dc:creator>Escudero, María Carolina</dc:creator>
	<dc:creator>Galimberti, Carlos María</dc:creator>
	<dc:creator>Vélez, Joaquín</dc:creator>
	<dc:subject xml:lang="en-US"></dc:subject>
	<dc:subject xml:lang="es-ES">Ciencias Sociales; Sociología</dc:subject>
	<dc:description xml:lang="en-US"></dc:description>
	<dc:description xml:lang="es-ES">El libro se ofrece como una introducción al pensamiento sociológico. Se estructura en 6 capítulos continuos que no obstante delinean dos grandes partes. La primera ofrece una mirada general sobre el surgimiento y formas de proceder de la sociología como pensamiento científico y su relación axiológica con los problemas sociales. La segunda desarrolla algunos aspectos centrales de obras paradigmáticas de los autores clásicos de la Sociología, con énfasis en identificar su método de análisis, su objeto de crítica y sus conceptos centrales. </dc:description>
	<dc:publisher xml:lang="en-US">Portal de Libros de la Universidad Nacional de La Plata</dc:publisher>
	<dc:publisher xml:lang="es-ES">Portal de Libros de la Universidad Nacional de La Plata</dc:publisher>
