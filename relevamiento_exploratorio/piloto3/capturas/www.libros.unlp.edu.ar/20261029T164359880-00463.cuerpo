<oai_dc:dc
	xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/"
	xmlns:dc="http://purl.org/dc/elements/1.1/"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/
	http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
	<dc:title xml:lang="en-US"></dc:title>
	<dc:title xml:lang="es-ES">Experiencias en Prácticas del Lenguaje</dc:title>
	<dc:creator>Hoz, Gabriela Mónica Beatriz</dc:creator>
	<dc:creator>Bosoer, Sara</dc:creator>
	<dc:creator>Molinari, María Claudia</dc:creator>
	<dc:subject xml:lang="en-US"></dc:subject>
	<dc:subject xml:lang="es-ES">Educación</dc:subject>
	<dc:description xml:lang="en-US"></dc:description>
	<dc:description xml:lang="es-ES">En este libro se presentan diferentes situaciones didácticas desarrolladas en aulas de nivel inicial y de nivel primario. Experiencias que se originan desde una perspectiva constructivista que entiende que las prácticas del lenguaje y el sistema de escritura son el objeto de enseñanza desde que los niños ingresan al jardín hasta que terminan la primaria. A lo largo de los capítulos encontrarán experiencias que retratan la enseñanza de la lectura, la escritura y los desafíos que hoy enfrenta la escuela en la incorporación de cada estudiante a la cultura de lo escrito. </dc:description>
	<dc:publisher xml:lang="en-US">Portal de Libros de la Universidad Nacional de La Plata</dc:publisher>
	<dc:publisher xml:lang="es-ES">Portal de Libros de la Universidad Nacional de La Plata</dc:publisher>
	<dc:date>2025-12-23</dc:date>
	<dc:type xml:lang="es-ES">##rt.metadata.pkp.dctype##</dc:type>
