<oai_dc:dc
	xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/"
	xmlns:dc="http://purl.org/dc/elements/1.1/"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/
	http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
	<dc:title xml:lang="en-US"></dc:title>
	<dc:title xml:lang="es-ES">FPE | Temas de proyecto en Taller de Arquitectura</dc:title>
	<dc:creator>Pagani, Gustavo Emilio</dc:creator>
	<dc:creator>Etulain, Juan Carlos</dc:creator>
	<dc:subject xml:lang="en-US"></dc:subject>
	<dc:subject xml:lang="es-ES">Arquitectura</dc:subject>
	<dc:description xml:lang="en-US"></dc:description>
	<dc:description xml:lang="es-ES">El libro &quot;Temas de Proyecto en Taller de Arquitectura&quot; presenta una serie de ciclos de charlas que exploran diversos aspectos del proceso proyectual y la enseñanza de la arquitectura. Cada ciclo aborda temas como la práctica profesional del arquitecto, las escalas proyectuales y la relación entre proyecto y materia. Estas temáticas se presentan como herramientas para enriquecer los contenidos del taller, estableciendo una conexión significativa entre la obra arquitectónica y su autor, enriqueciendo la experiencia educativa en el ámbito de la arquitectura. </dc:description>
	<dc:publisher xml:lang="en-US">Portal de Libros de la Universidad Nacional de La Plata</dc:publisher>
