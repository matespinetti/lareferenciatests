<oai_dc:dc
	xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/"
	xmlns:dc="http://purl.org/dc/elements/1.1/"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/
	http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
	<dc:title xml:lang="en-US"></dc:title>
	<dc:title xml:lang="es-ES">Las guardias del tango</dc:title>
	<dc:creator>Polemann, Alejandro Jorge</dc:creator>
	<dc:creator>Jurado, Martín</dc:creator>
	<dc:creator>Samela, Gustavo</dc:creator>
	<dc:subject xml:lang="en-US"></dc:subject>
	<dc:subject xml:lang="es-ES">Música ; Educación</dc:subject>
	<dc:description xml:lang="en-US"></dc:description>
	<dc:description xml:lang="es-ES">Las guardias del tango es un material didáctico para la enseñanza del tango rioplatense. Propone un abordaje para la producción musical en diferentes estilos como: primera guardia, la guardia vieja; segunda guardia, la guardia nueva; tercera guardia, la vanguardia y cuarta guardia: tango del siglo XXI. Su diseño responde a la metodología de trabajo desarrollada en las cátedras Producción y análisis musical: música rioplatense y Tango, de la Facultad de Artes de la Universidad Nacional de La Plata. </dc:description>
	<dc:publisher xml:lang="en-US">Portal de Libros de la Universidad Nacional de La Plata</dc:publisher>
	<dc:publisher xml:lang="es-ES">Portal de Libros de la Universidad Nacional de La Plata</dc:publisher>
	<dc:date>2026-03-26</dc:date>
	<dc:type xml:lang="es-ES">##rt.metadata.pkp.dctype##</dc:type>
	<dc:type xml:lang="es-ES"></dc:type>
	<dc:type xml:lang="en-US"></dc:type>
	<dc:format>Digital</dc:format>
