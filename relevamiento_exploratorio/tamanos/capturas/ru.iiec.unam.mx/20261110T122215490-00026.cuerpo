      <identifier>oai:ru.iiec.unam.mx:143</identifier>
      <datestamp>2012-10-17T19:03:29Z</datestamp>
      <setSpec>7374617475733D707562</setSpec>
      <setSpec>7375626A656374733D4C:4C39:4C3936</setSpec>
      <setSpec>7375626A656374733D4F:4F31:4F3131</setSpec>
