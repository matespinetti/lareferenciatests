                  <mods:topic>Mortalidade Prematura</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Doença Crônica</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Mortes evitáveis no Sistema Único de Saúde na população brasileira, entre 5 e 69 anos, 2000 – 2013</mods:title>
               </mods:titleInfo>
               <mods:genre>Artigo de periódico</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
   </dmdSec>
