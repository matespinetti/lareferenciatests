</metadata></record><record><header><identifier>oai:repositorio.ufmg.br:1843/BUOS-8FNKBK</identifier><datestamp>2025-09-09T17:56:27Z</datestamp><setSpec>com_1843_6</setSpec><setSpec>com_1843_2</setSpec><setSpec>col_1843_238</setSpec></header><metadata><mets xmlns="http://www.loc.gov/METS/" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" ID="&#xa;&#x9;&#x9;&#x9;&#x9;DSpace_ITEM_1843-BUOS-8FNKBK" TYPE="DSpace ITEM" PROFILE="DSpace METS SIP Profile 1.0" xsi:schemaLocation="http://www.loc.gov/METS/ http://www.loc.gov/standards/mets/mets.xsd" OBJID="&#xa;&#x9;&#x9;&#x9;&#x9;hdl:1843/BUOS-8FNKBK">
   <metsHdr CREATEDATE="2026-11-10T09:23:22Z">
