   <dmdSec ID="DMD_1843_2306">
      <mdWrap MDTYPE="MODS">
         <xmlData xmlns:mods="http://www.loc.gov/mods/v3" xsi:schemaLocation="http://www.loc.gov/mods/v3 http://www.loc.gov/standards/mods/v3/mods-3-1.xsd">
            <mods:mods xsi:schemaLocation="http://www.loc.gov/mods/v3 http://www.loc.gov/standards/mods/v3/mods-3-1.xsd">
               <mods:extension>
                  <mods:dateAccessioned encoding="iso8601">2026-03-30T22:11:17Z</mods:dateAccessioned>
               </mods:extension>
               <mods:originInfo>
                  <mods:dateIssued encoding="iso8601">2023</mods:dateIssued>
               </mods:originInfo>
               <mods:identifier type="issn">2296-861X</mods:identifier>
               <mods:identifier type="doi">http://dx.doi.org/10.3389/fnut.2023.1241030</mods:identifier>
               <mods:identifier type="uri">https://hdl.handle.net/1843/2306</mods:identifier>
               <mods:abstract>Environmental diseases affect vulnerable populations, exacerbated by poverty and poor sanitation. This topic brings together studies on intestinal pathogens, trace elements, BPA exposure, and nutritional interventions. Evidence shows impacts on growth, development, and metabolic risk, highlighting the role of nutrition in preventing and mitigating harm to human health.</mods:abstract>
               <mods:language>
                  <mods:languageTerm authority="rfc3066" />
               </mods:language>
               <mods:accessCondition type="useAndReproduction">Acesso aberto</mods:accessCondition>
               <mods:subject>
                  <mods:topic>Doença ambiental</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Poluentes ambientais</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Ciências da nutrição</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Editorial: nutritional factors and interventions in environmental-borne diseases</mods:title>
               </mods:titleInfo>
               <mods:genre>Artigo de periódico</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
   </dmdSec>
