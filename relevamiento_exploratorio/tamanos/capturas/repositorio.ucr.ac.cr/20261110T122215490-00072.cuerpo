                  <mods:topic>Nivel del mar</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Observatorio sismológico</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Geofísica</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Costa Rica</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Terremoto de Cóbano, 1990</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Análisis de los registros de nivel del mar correspondientes al terremoto de Cóbano del 23-3-90</mods:title>
               </mods:titleInfo>
               <mods:genre>artículo original</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
