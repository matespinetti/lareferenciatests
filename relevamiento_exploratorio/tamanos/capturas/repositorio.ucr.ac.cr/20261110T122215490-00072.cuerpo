                  <mods:dateIssued encoding="iso8601">1991-07</mods:dateIssued>
               </mods:originInfo>
               <mods:identifier type="issn">0252-9769</mods:identifier>
               <mods:identifier type="uri">https://hdl.handle.net/10669/626</mods:identifier>
               <mods:abstract>Mediante un oportuno filtrado de la información de nivel del mar, se analiza la señal&#xd;
correspondiente al evento generado por el sismo de Cóbano (Golfo de Nicoya, Costa&#xd;
Rica) el día 25-3-90. Se establece una hipótesis acerca de la posible evolución del&#xd;
fenómeno y la conveniencia de un control compelmentario de la sismicidad local, a&#xd;
partir del periódico análisis de la información registrada por mareógrafos estratégicamente&#xd;
emplazados.</mods:abstract>
               <mods:language>
                  <mods:languageTerm authority="rfc3066">es</mods:languageTerm>
               </mods:language>
               <mods:accessCondition type="useAndReproduction">acceso abierto</mods:accessCondition>
