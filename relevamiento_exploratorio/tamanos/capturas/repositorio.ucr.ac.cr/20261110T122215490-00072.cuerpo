</metadata></record><record><header><identifier>oai:kerwa.ucr.ac.cr:10669/12475</identifier><datestamp>2021-05-04T21:15:50Z</datestamp><setSpec>com_10669_12453</setSpec><setSpec>com_10669_1426</setSpec><setSpec>col_10669_12470</setSpec></header><metadata><mets xmlns="http://www.loc.gov/METS/" xmlns:doc="http://www.lyncode.com/xoai" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ID="&#xa;&#x9;&#x9;&#x9;&#x9;DSpace_ITEM_10669-12475" TYPE="DSpace ITEM" PROFILE="DSpace METS SIP Profile 1.0" xsi:schemaLocation="http://www.loc.gov/METS/ http://www.loc.gov/standards/mets/mets.xsd" OBJID="&#xa;&#x9;&#x9;&#x9;&#x9;hdl:10669/12475">
