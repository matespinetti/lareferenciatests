                  <mods:topic>Historia oral</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Centro de Información de Occidente (CIO)</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Apodos y sobrenombres en la comunidad ramonense: recuperación de la memoria colectiva</mods:title>
               </mods:titleInfo>
