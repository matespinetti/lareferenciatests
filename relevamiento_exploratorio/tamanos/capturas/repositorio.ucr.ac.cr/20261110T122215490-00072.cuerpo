                  <mods:topic>Centro de Información de Occidente (CIO)</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>El humanismo marxista: materiales para la Cátedra de Filosofía</mods:title>
               </mods:titleInfo>
