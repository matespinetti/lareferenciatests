</metadata></record><record><header><identifier>oai:kerwa.ucr.ac.cr:10669/100452</identifier><datestamp>2025-01-14T13:36:25Z</datestamp><setSpec>com_10669_77938</setSpec><setSpec>col_10669_92059</setSpec></header><metadata><mets xmlns="http://www.loc.gov/METS/" xmlns:doc="http://www.lyncode.com/xoai" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ID="&#xa;&#x9;&#x9;&#x9;&#x9;DSpace_ITEM_10669-100452" TYPE="DSpace ITEM" PROFILE="DSpace METS SIP Profile 1.0" xsi:schemaLocation="http://www.loc.gov/METS/ http://www.loc.gov/standards/mets/mets.xsd" OBJID="&#xa;&#x9;&#x9;&#x9;&#x9;hdl:10669/100452">
   <metsHdr CREATEDATE="2026-11-10T12:22:34Z">
      <agent ROLE="CUSTODIAN" TYPE="ORGANIZATION">
         <name>Kérwá - Repositorio Universidad de Costa Rica</name>
