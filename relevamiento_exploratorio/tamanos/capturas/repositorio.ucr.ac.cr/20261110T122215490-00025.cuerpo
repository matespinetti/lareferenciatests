               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Amino acid sequence of a myotoxic Lys49-phospholipase A2 homologue from the venom of Cerrophidion (Bothrops) godmani</mods:title>
               </mods:titleInfo>
               <mods:genre>artículo original</mods:genre>
