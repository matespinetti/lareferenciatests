               <mods:abstract>In this paper we study an algorithm for approximating fixed points using simplicial subdivisions of the simplex. Furthermore, it is compared with algorithms of primitive sets.Se estudiará un algoritmo para aproximar puntos fijos usando subdivisiones simpliciales de un simplex S, el cual será comparado con un algoritmo del mismo tipo pero basado en conjuntos primitivos.</mods:abstract>
               <mods:language>
                  <mods:languageTerm authority="rfc3066">es</mods:languageTerm>
               </mods:language>
               <mods:accessCondition type="useAndReproduction" />
               <mods:titleInfo>
                  <mods:title>Algoritmos de punto fijo usando subdivisiones simpliciales Algoritmos de punto fijo usando subdivisiones simpliciales</mods:title>
               </mods:titleInfo>
               <mods:genre>artículo original</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
   </dmdSec>
