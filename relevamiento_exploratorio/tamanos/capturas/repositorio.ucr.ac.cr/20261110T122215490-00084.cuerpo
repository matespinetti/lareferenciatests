         <file ID="BITSTREAM_ORIGINAL_10669_73134_1" MIMETYPE="application/pdf" SEQ="1" SIZE="572991" CHECKSUM="7411ddc751cb7d9220a504201704fc3d" CHECKSUMTYPE="MD5" ADMID="FO_10669_73134_1" GROUPID="GROUP_BITSTREAM_10669_73134_1">
            <FLocat LOCTYPE="URL" xlink:type="simple" xlink:href="https://kerwa.ucr.ac.cr/bitstreams/b63a3bf9-10b0-433e-923e-c648adc74c1b/download" />
         </file>
