                           <premis:messageDigest>4159c3c77468972d436e06fa34df0097</premis:messageDigest>
                        </premis:fixity>
                        <premis:size>103393</premis:size>
                        <premis:format>
                           <premis:formatDesignation>
                              <premis:formatName>text/plain</premis:formatName>
                           </premis:formatDesignation>
                        </premis:format>
