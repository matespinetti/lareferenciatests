               <mods:identifier type="none"/>
               <mods:identifier type="citation">Applied Biochemistry and Biotechnology, v. 188, n. 3, p. 798-809, 2019.</mods:identifier>
               <mods:identifier type="issn">1559-02910273-2289</mods:identifier>
