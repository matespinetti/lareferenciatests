               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Localização e rastreamento 3D usando comunicação sem fio LoRa</mods:title>
               </mods:titleInfo>
               <mods:genre>Dissertação de mestrado</mods:genre>
            </mods:mods>
         </xmlData>
