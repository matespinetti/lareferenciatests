</mets></metadata></record><record><header><identifier>oai:repositorio.unesp.br:11449/191806</identifier><datestamp>2026-01-26T12:24:38Z</datestamp><setSpec>com_11449_254423</setSpec><setSpec>com_11449_1</setSpec><setSpec>col_11449_254443</setSpec></header><metadata><mets xmlns="http://www.loc.gov/METS/" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" ID="&#xa;&#x9;&#x9;&#x9;&#x9;DSpace_ITEM_11449-191806" TYPE="DSpace ITEM" PROFILE="DSpace METS SIP Profile 1.0" xsi:schemaLocation="http://www.loc.gov/METS/ http://www.loc.gov/standards/mets/mets.xsd" OBJID="&#xa;&#x9;&#x9;&#x9;&#x9;hdl:11449/191806">
   <metsHdr CREATEDATE="2026-11-10T12:22:29Z">
      <agent ROLE="CUSTODIAN" TYPE="ORGANIZATION">
