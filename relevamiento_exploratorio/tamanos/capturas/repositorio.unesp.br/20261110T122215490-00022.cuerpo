                     <mods:roleTerm type="text">institution</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Universidade Estadual Paulista (UNESP)</mods:namePart>
               </mods:name>
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">institution</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Universidade Federal do Paraná (UFPR)</mods:namePart>
               </mods:name>
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">institution</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Fundación Ecotonos</mods:namePart>
               </mods:name>
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">institution</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Marie Selby Botanical Gardens</mods:namePart>
               </mods:name>
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">institution</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Universidad de Caldas</mods:namePart>
               </mods:name>
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">institution</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>University of Costa Rica</mods:namePart>
               </mods:name>
               <mods:extension>
                  <mods:dateAccessioned encoding="iso8601">2025-04-29T20:10:36Z</mods:dateAccessioned>
               </mods:extension>
               <mods:originInfo>
                  <mods:dateIssued encoding="iso8601">2025-04-01</mods:dateIssued>
               </mods:originInfo>
               <mods:identifier type="none"/>
               <mods:identifier type="citation">Phytotaxa, v. 696, n. 2, p. 145-157, 2025.</mods:identifier>
               <mods:identifier type="issn">1179-31631179-3155</mods:identifier>
               <mods:identifier type="uri">https://hdl.handle.net/11449/307909</mods:identifier>
               <mods:identifier type="doi">10.11646/phytotaxa.696.2.4</mods:identifier>
               <mods:identifier type="scopus">2-s2.0-105001865329</mods:identifier>
               <mods:identifier type="lattes">1539716845687200</mods:identifier>
               <mods:identifier type="orcid">0000-0002-6592-93260000-0002-7037-16700000-0002-2088-1541</mods:identifier>
               <mods:identifier type="dimensions">pub.1187198373</mods:identifier>
               <mods:abstract>A new species of Pabstiella native to the southeastern Brazilian Atlantic Rainforest is described and illustrated. The new species is compared with morphologically similar taxa, and its infrageneric placement is inferred based on morphology. In addition, six species are proposed as synonyms: P. dasilvae [= P. fragae], P. discors [=P. garayi], P. isabelae [=P. gossameri], P. melior [=P. brachystele], P. naimekei [=P. ezechiasi] and P. setibensis [=P. savioi]. Respective photographs and taxonomic discussions are provided for each case.</mods:abstract>
               <mods:language>
                  <mods:languageTerm authority="rfc3066">eng</mods:languageTerm>
               </mods:language>
               <mods:accessCondition type="useAndReproduction"/>
               <mods:subject>
                  <mods:topic>Atlantic Rainforest</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>endemism</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>epiphyte</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Serra do Mar</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>taxonomy</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Contributions to the knowledge of Pabstiella (Orchidaceae: Pleurothallidinae) from Brazil: A new species, new synonyms and taxonomic notes</mods:title>
               </mods:titleInfo>
               <mods:genre>Artigo</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
   </dmdSec>
