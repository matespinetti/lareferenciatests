                  <mods:topic>Dental enamel</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Dentin</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Dentin-bonding agents</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Desempenho clínico de diferentes estratégias de adesão de restaurações de lesões cervicais não cariosas</mods:title>
               </mods:titleInfo>
               <mods:genre>Tese de doutorado</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
