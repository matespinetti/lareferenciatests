                  <mods:topic>Conversão alimentar</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Ganho em peso</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Hormônio de crescimento</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Desempenho de caprinos de três genótipos recebendo somatotropina bovina recombinante (rbST)</mods:title>
               </mods:titleInfo>
               <mods:genre>Artigo</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
