               </mods:originInfo>
               <mods:identifier type="citation">Transplantation Proceedings, v. 17, n. 2, p. 1741-1745, 1985.</mods:identifier>
               <mods:identifier type="issn">0041-1345</mods:identifier>
               <mods:identifier type="uri">http://hdl.handle.net/11449/63755</mods:identifier>
               <mods:identifier type="scopus">2-s2.0-0022361999</mods:identifier>
               <mods:abstract>The aim of this paper is to analyze 87 cases of kidney transplants obtained from nonrelated donors; in 20 of these, a donor-specific transfusion procedure4 was added to the pretreatment protocol of each recipient.</mods:abstract>
               <mods:language>
