               </mods:extension>
               <mods:extension>
                  <mods:dateAvailable encoding="iso8601">2020-12-10T17:59:40Z</mods:dateAvailable>
               </mods:extension>
               <mods:originInfo>
                  <mods:dateIssued encoding="iso8601">1997-09-01</mods:dateIssued>
               </mods:originInfo>
               <mods:identifier type="citation">Quimica Nova. Sao Paulo: Soc Brasileira Quimica, v. 20, n. 5, p. 551-554, 1997.</mods:identifier>
               <mods:identifier type="issn">0100-4042</mods:identifier>
               <mods:identifier type="uri">http://hdl.handle.net/11449/195669</mods:identifier>
               <mods:identifier type="wos">WOS:A1997XX09800016</mods:identifier>
               <mods:abstract>A model for the construction of a simple and cheap apparatus to be used as bioreactor for reactions catalyzed by baker&amp;apos;s yeast (Saccharomyces cerevisiae) is described, The bioconversion and separation of cells from products and residual substrates are obtained at the same time, The reactions carried out in this type of reactor are faster than those catalyzed by immobilized cells, Yeast cells can be cultivated in this bioreactor operating with cell recycling at appropriated conditions using glucose and other nutrients.</mods:abstract>
               <mods:language>
                  <mods:languageTerm authority="rfc3066">por</mods:languageTerm>
               </mods:language>
               <mods:accessCondition type="useAndReproduction"/>
               <mods:subject>
                  <mods:topic>baker&amp;apos;s yeast</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Saccharomyces cerevisiae</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>reactor</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>immobilized cells</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>asymmetric synthesis</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Project and construction of a bioreactor for reactions catalyzed by baker&amp;apos;s yeast (Saccharomyces cerevisiae).</mods:title>
               </mods:titleInfo>
               <mods:genre>Artigo</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
   </dmdSec>
