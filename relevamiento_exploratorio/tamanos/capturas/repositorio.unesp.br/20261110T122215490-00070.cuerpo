               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Antropologia da doenca e do doente: percepcoes e estrategias de vida dos tuberculosis.</mods:title>
               </mods:titleInfo>
               <mods:genre>Artigo</mods:genre>
