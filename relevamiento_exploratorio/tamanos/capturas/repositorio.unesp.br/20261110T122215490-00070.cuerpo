               </mods:name>
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">author</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Janzen, Henrique Evaldo [UNESP]</mods:namePart>
               </mods:name>
