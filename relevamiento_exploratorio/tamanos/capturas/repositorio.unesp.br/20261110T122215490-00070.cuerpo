               </mods:subject>
               <mods:subject>
                  <mods:topic>Geo coding</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Geographical locations</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Multi-modal</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Multi-modal image</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Rank aggregation</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Test images</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Multimodal image geocoding: The 2013 RECOD&amp;apos;s approach</mods:title>
               </mods:titleInfo>
