                  <mods:topic>Toothbrushing</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>In vitro evaluation of surface roughness of 4 resin composites after the toothbrushing process and methods to recover superficial smoothness.</mods:title>
               </mods:titleInfo>
               <mods:genre>Artigo</mods:genre>
            </mods:mods>
         </xmlData>
