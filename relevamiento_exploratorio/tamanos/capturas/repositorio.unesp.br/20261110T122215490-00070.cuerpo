                  <mods:topic>Measures time</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Photogate</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Stopwatch</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Tracker software</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Video analysis</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Experimental lab propose of different data acquisition techniques of time measurement in physics teaching Proposta de atividade experimental de medida de tempo em laboratório de ensino de física</mods:title>
               </mods:titleInfo>
               <mods:genre>Artigo</mods:genre>
