         <mdWrap MIMETYPE="text/plain" MDTYPE="OTHER" OTHERMDTYPE="DSpaceDepositLicense">
            <binData></binData>
         </mdWrap>
      </rightsMD>
   </amdSec>
   <amdSec ID="FO_10482_14473_1">
      <techMD ID="TECH_O_10482_14473_1">
         <mdWrap MDTYPE="PREMIS">
            <xmlData xmlns:premis="http://www.loc.gov/standards/premis" xsi:schemaLocation="http://www.loc.gov/standards/premis http://www.loc.gov/standards/premis/PREMIS-v1-0.xsd">
               <premis:premis>
                  <premis:object>
                     <premis:objectIdentifier>
                        <premis:objectIdentifierType>URL</premis:objectIdentifierType>
                        <premis:objectIdentifierValue>http://repositorio2.unb.br/jspui/bitstream/10482/14473/1/2013_FernandoOscarSchmitt.pdf</premis:objectIdentifierValue>
                     </premis:objectIdentifier>
                     <premis:objectCategory>File</premis:objectCategory>
                     <premis:objectCharacteristics>
