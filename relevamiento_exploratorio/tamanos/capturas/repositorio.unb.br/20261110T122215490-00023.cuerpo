</metadata></record><record><header><identifier>oai:repositorio.unb.br:10482/11144</identifier><datestamp>2026-01-28T19:59:05Z</datestamp><setSpec>com_10482_45725</setSpec><setSpec>col_10482_45731</setSpec></header><metadata><mets xmlns="http://www.loc.gov/METS/" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" ID="&#xa;&#x9;&#x9;&#x9;&#x9;DSpace_ITEM_10482-11144" TYPE="DSpace ITEM" PROFILE="DSpace METS SIP Profile 1.0" xsi:schemaLocation="http://www.loc.gov/METS/ http://www.loc.gov/standards/mets/mets.xsd" OBJID="&#xa;&#x9;&#x9;&#x9;&#x9;hdl:10482/11144">
   <metsHdr CREATEDATE="2026-11-07T07:13:35Z">
      <agent ROLE="CUSTODIAN" TYPE="ORGANIZATION">
         <name>Repositório Institucional da UnB</name>
