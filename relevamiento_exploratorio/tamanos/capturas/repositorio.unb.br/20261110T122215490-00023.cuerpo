                  </mods:role>
                  <mods:namePart>Maia, Tadeu Queiroz</mods:namePart>
               </mods:name>
               <mods:extension>
                  <mods:dateAccessioned encoding="iso8601">2010-12-21T11:49:27Z</mods:dateAccessioned>
               </mods:extension>
