               </mods:extension>
               <mods:originInfo>
                  <mods:dateIssued encoding="iso8601">2009</mods:dateIssued>
               </mods:originInfo>
               <mods:identifier type="citation">Universidad de Antioquia. Facultad de Ciencias Sociales y Humanas. Centro de Estudios de Opinión - CEO. (2009). Fundamentals of polling. La Sociología en sus Escenarios, (19), 1–18.</mods:identifier>
               <mods:identifier type="issn">123-8973</mods:identifier>
               <mods:identifier type="uri">https://hdl.handle.net/10495/2379</mods:identifier>
               <mods:abstract>ABSTRACT: This tutorial is intended to offer a simplified glimpse into some of the fundamentals of public opinion polling. Designed for the novice, the manual provides definitions, examples, and explanations that serve to introduce interested students to the field of public opinion research.RESUMEN: Esta clase particular se piensa para ofrecer una ojeada simplificada en algunos de los fundamentales de la interrogación de opinión pública. Diseñado para el principiante, el manual proporciona definiciones, ejemplos, y las explicaciones que sirven presentar a estudiantes interesados al campo de la investigación de la opinión pública.</mods:abstract>
               <mods:language>
                  <mods:languageTerm authority="rfc3066">spa</mods:languageTerm>
               </mods:language>
               <mods:accessCondition type="useAndReproduction"/>
               <mods:subject>
                  <mods:topic>Opinión pública</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Public opinion</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Survey</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Estudios de opinión</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Fundamentals of polling</mods:title>
               </mods:titleInfo>
               <mods:genre>Artículo de investigación</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
   </dmdSec>
