               </mods:name>
               <mods:extension>
                  <mods:dateAccessioned encoding="iso8601">2016-02-12T18:08:57Z</mods:dateAccessioned>
               </mods:extension>
               <mods:extension>
                  <mods:dateAvailable encoding="iso8601">2016-02-12T18:08:57Z</mods:dateAvailable>
               </mods:extension>
               <mods:originInfo>
                  <mods:dateIssued encoding="iso8601">2012</mods:dateIssued>
               </mods:originInfo>
               <mods:identifier type="citation">Pérez Toro, W. F. (2012). ¿Nos repugna realmente la prisión? Un recordatorio abolicionista. Diálogos de Derecho y Política, (8), 1-18.</mods:identifier>
               <mods:identifier type="issn">2145-2784</mods:identifier>
               <mods:identifier type="uri">https://hdl.handle.net/10495/3490</mods:identifier>
               <mods:abstract>RESUMEN: El artículo examina la solidez de la afirmación común según la cual la prisión es un lugar, un mecanismo o una forma de castigo repugnante. Igualmente, se pregunta por las razones que impiden que se la conozca o que hacen que, aun conociendo sus irracionalidades o perversidades, se la tolere.</mods:abstract>
               <mods:language>
                  <mods:languageTerm authority="rfc3066">spa</mods:languageTerm>
               </mods:language>
               <mods:accessCondition type="useAndReproduction"/>
               <mods:subject>
                  <mods:topic>Detención</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Administración de justicia penal</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Encarcelamiento</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Ejecución judicial</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>¿Nos repugna realmente la prisión? Un recordatorio abolicionista</mods:title>
               </mods:titleInfo>
               <mods:genre>Artículo de investigación</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
   </dmdSec>
