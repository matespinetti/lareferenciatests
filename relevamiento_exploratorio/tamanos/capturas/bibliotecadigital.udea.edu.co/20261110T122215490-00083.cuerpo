               </mods:name>
               <mods:extension>
                  <mods:dateAccessioned encoding="iso8601">2016-01-27T17:50:15Z</mods:dateAccessioned>
               </mods:extension>
               <mods:extension>
                  <mods:dateAvailable encoding="iso8601">2016-01-27T17:50:15Z</mods:dateAvailable>
               </mods:extension>
               <mods:originInfo>
                  <mods:dateIssued encoding="iso8601">2008</mods:dateIssued>
               </mods:originInfo>
               <mods:identifier type="citation">Universidad de Antioquia. Centro de Investigaciones Económicas. Grupo de Economía de la Salud (GES).(2008). Limitaciones y derechos sobre la atención en salud de los colombianos. Observatorio de la Seguridad Social, 7(18), 1-16.</mods:identifier>
               <mods:identifier type="issn">1657-5415</mods:identifier>
               <mods:identifier type="uri">https://hdl.handle.net/10495/3425</mods:identifier>
               <mods:abstract>RESUMEN: Teniendo en cuenta especialmente el contexto y las implicaciones de la sentencia T-760 proferida por la Corte Constitucional en julio de 2008, en esta Observación se revisa la problemática del país en cuanto al dilema entre la consagración de límites o asignación prioritaria y los derechos en salud. En esta ocasión se cuenta con la colaboración de reconocidos académicos que enriquecen&#xd;
el análisis y la discusión del tema.</mods:abstract>
               <mods:language>
                  <mods:languageTerm authority="rfc3066">spa</mods:languageTerm>
               </mods:language>
               <mods:accessCondition type="useAndReproduction"/>
               <mods:subject>
                  <mods:topic>Acción de tutela</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>POS (Plan Obligatorio de Salud)</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Derecho a la salud</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Sistemas de salud - Colombia</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Sentencia T-760 de 2008</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Colombia</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Reforma a la seguridad social</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Sistema General de Seguridad Social en Salud</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Tutela (Derecho civil)</mods:topic>
               </mods:subject>
