                     <mods:roleTerm type="text">author</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Vasco Palacios, Aída Marcela</mods:namePart>
               </mods:name>
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">author</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Palacio Úsuga, Karen Astrid</mods:namePart>
               </mods:name>
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">author</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Montoya Aguirre, Cristian Mateo</mods:namePart>
               </mods:name>
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">illustrator</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Mejía Osorio, Alejandro</mods:namePart>
               </mods:name>
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">researchgroup</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>BIOMICRO</mods:namePart>
               </mods:name>
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">researchgroup</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Sistemas de Información en Salud</mods:namePart>
               </mods:name>
               <mods:extension>
                  <mods:dateAccessioned encoding="iso8601">2026-08-04T18:40:16Z</mods:dateAccessioned>
               </mods:extension>
               <mods:originInfo>
                  <mods:dateIssued encoding="iso8601">2026</mods:dateIssued>
               </mods:originInfo>
               <mods:identifier type="uri">https://hdl.handle.net/10495/51991</mods:identifier>
               <mods:identifier type="instname">instname:Universidad de Antioquia</mods:identifier>
               <mods:identifier type="reponame">reponame:Repositorio Institucional Universidad de Antioquia</mods:identifier>
               <mods:identifier type="repourl">repourl:https://bibliotecadigital.udea.edu.co/</mods:identifier>
               <mods:abstract>Esta cartilla es el resultado de un esfuerzo colectivo que fue posible gracias al compromiso, la confianza y la participación de numerosas personas e instituciones. Expresamos nuestro más profundo agradecimiento a la comunidad de la vereda La Aldea, a su Junta de Acción Comunal y al Centro Educativo Rural (CER) La Aldea,  quienes nos abrieron sus puertas, compartieron sus conocimientos, experiencias y entusiasmo, y caminaron junto a nosotros en la construcción de este proceso. Su participación activa fue fundamental para fortalecer el diálogo de saberes y el aprendizaje conjunto que dieron vida a esta iniciativa. Agradecemos a la Vicerrectoría de Extensión de la Universidad de Antioquia por financiar el proyecto Laboratorio Piloto de Resiliencia al Cambio Climático con Comunidades Campesinas de la Vereda La Aldea, Municipio de Santo Domingo,Antioquia, desarrollado en el marco de la 20.ª Convocatoria del Banco Universitario de Programas y Proyectos de Extensión (BUPPE), temática Acciones por el Clima, del cual surge esta cartilla como uno de sus principales resultados.
Reconocemos también el valioso aporte de la Colección de Microorganismos de la Escuela de Microbiología de la Universidad de Antioquia por suministrar las cepas que hicieron posible el establecimiento de los cultivos experimentales; al Grupo de Investigación BiOMicro y al Semillero de Investigación Micofradía por su respaldo técnico, la elaboración de los inóculos y la disposición de equipos que permitieron el desarrollo de las  actividades propuestas. Asimismo, agradecemos a los voluntarios de la Corporación Aquelarre Cultural por su entusiasmo, compromiso y apropiación de la iniciativa, contribuyendo a ampliar su alcance e impacto en el territorio; y al Centro de Recursos para la Salud Mental Colectiva -SAMECO por su acompañamiento permanente y por aportar una mirada sensible, humana e integral a lo largo de todo el proceso. A todos y todas, gracias por hacer posible este espacio de aprendizaje, diálogo de saberes, construcción colectiva y fortalecimiento de la resiliencia frente al cambio climático</mods:abstract>
               <mods:language>
                  <mods:languageTerm authority="rfc3066">spa</mods:languageTerm>
               </mods:language>
               <mods:accessCondition type="useAndReproduction"/>
               <mods:titleInfo>
                  <mods:title>Cartilla educativa laboratorio piloto de resiliencia al cambio climático</mods:title>
               </mods:titleInfo>
               <mods:genre>Cartilla</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
   </dmdSec>
