                  </mods:role>
                  <mods:namePart>Estudios sobre Juventud</mods:namePart>
               </mods:name>
               <mods:extension>
                  <mods:dateAccessioned encoding="iso8601">2017-01-08T13:56:30Z</mods:dateAccessioned>
               </mods:extension>
               <mods:extension>
                  <mods:dateAvailable encoding="iso8601">2017-01-08T13:56:30Z</mods:dateAvailable>
               </mods:extension>
               <mods:originInfo>
                  <mods:dateIssued encoding="iso8601">2010</mods:dateIssued>
               </mods:originInfo>
               <mods:identifier type="citation">Uribe, N. (2010). Reflexiones psicoanalíticas sobre la delincuencia juvenil en Colombia. Poiésis, (20), 1–12. DOI: http://dx.doi.org/10.21501/issn.1692-0945</mods:identifier>
               <mods:identifier type="uri">https://hdl.handle.net/10495/5837</mods:identifier>
               <mods:identifier type="doi">10.21501/issn.1692-0945</mods:identifier>
               <mods:identifier type="eissn">1692-0945</mods:identifier>
               <mods:abstract>RESUMEN: Aun cuando desde el Psicoanálisis se tiende a dar primacía al estudio de los factores intrapsíquicos del sujeto, esta disciplina no desconoce la importancia de los factores externos, y por el contrario, tiene en cuenta la compleja articulación de ambos, pues piensa que la subjetividad se estructura a partir de las formas singulares en que cada uno articula a su propia historia aquello que ofrece el medio familiar y social.</mods:abstract>
               <mods:language>
                  <mods:languageTerm authority="rfc3066">spa</mods:languageTerm>
               </mods:language>
               <mods:accessCondition type="useAndReproduction"/>
               <mods:subject>
                  <mods:topic>Reflexiones</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Psicoanálisis</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Delincuencia</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Delincuencia juvenil</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Delincuencia juvenil - Colombia</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Jóvenes</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Menores infractores</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Reflexiones psicoanalíticas sobre la delincuencia juvenil en Colombia</mods:title>
               </mods:titleInfo>
               <mods:genre>Artículo de investigación</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
   </dmdSec>
