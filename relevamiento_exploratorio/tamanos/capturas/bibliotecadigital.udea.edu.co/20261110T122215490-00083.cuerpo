</mets></metadata></record><record><header><identifier>oai:bibliotecadigital.udea.edu.co:10495/43257</identifier><datestamp>2025-03-26T22:06:32Z</datestamp><setSpec>com_10495_9678</setSpec><setSpec>com_10495_1724</setSpec><setSpec>col_10495_18264</setSpec></header><metadata><mets xmlns="http://www.loc.gov/METS/" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" ID="&#xa;&#x9;&#x9;&#x9;&#x9;DSpace_ITEM_10495-43257" TYPE="DSpace ITEM" PROFILE="DSpace METS SIP Profile 1.0" xsi:schemaLocation="http://www.loc.gov/METS/ http://www.loc.gov/standards/mets/mets.xsd" OBJID="&#xa;&#x9;&#x9;&#x9;&#x9;hdl:10495/43257">
   <metsHdr CREATEDATE="2026-11-10T07:23:29Z">
      <agent ROLE="CUSTODIAN" TYPE="ORGANIZATION">
         <name>Repositorio Institucional de la Universidad de Antioquia</name>
