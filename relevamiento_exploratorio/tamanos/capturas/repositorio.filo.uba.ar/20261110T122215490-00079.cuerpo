</metadata></record><record><header><identifier>oai:repositorio.filo.uba.ar:filodigital/13074</identifier><datestamp>2021-11-02T18:00:54Z</datestamp><setSpec>com_filodigital_151</setSpec><setSpec>com_filodigital_12128</setSpec><setSpec>com_filodigital_12117</setSpec><setSpec>com_filodigital_12111</setSpec><setSpec>com_filodigital_1832</setSpec><setSpec>com_filodigital_9</setSpec><setSpec>com_filodigital_5</setSpec><setSpec>col_filodigital_3239</setSpec><setSpec>col_filodigital_12131</setSpec><setSpec>snrd</setSpec></header><metadata><mets xmlns="http://www.loc.gov/METS/" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" ID="&#xa;&#x9;&#x9;&#x9;&#x9;DSpace_ITEM_filodigital-13074" TYPE="DSpace ITEM" PROFILE="DSpace METS SIP Profile 1.0" xsi:schemaLocation="http://www.loc.gov/METS/ http://www.loc.gov/standards/mets/mets.xsd" OBJID="&#xa;&#x9;&#x9;&#x9;&#x9;hdl:filodigital/13074">
   <metsHdr CREATEDATE="2026-11-10T12:22:27Z">
      <agent ROLE="CUSTODIAN" TYPE="ORGANIZATION">
         <name>DSpace de la Facultad de Filosofia y Letras</name>
