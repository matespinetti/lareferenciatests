</metadata></record><record><header><identifier>oai:repositorio.filo.uba.ar:filodigital/16918</identifier><datestamp>2026-04-13T01:22:19Z</datestamp><setSpec>com_filodigital_11990</setSpec><setSpec>com_filodigital_1833</setSpec><setSpec>com_filodigital_1832</setSpec><setSpec>com_filodigital_9</setSpec><setSpec>com_filodigital_5</setSpec><setSpec>col_filodigital_12010</setSpec><setSpec>snrd</setSpec></header><metadata><mets xmlns="http://www.loc.gov/METS/" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" ID="&#xa;&#x9;&#x9;&#x9;&#x9;DSpace_ITEM_filodigital-16918" TYPE="DSpace ITEM" PROFILE="DSpace METS SIP Profile 1.0" xsi:schemaLocation="http://www.loc.gov/METS/ http://www.loc.gov/standards/mets/mets.xsd" OBJID="&#xa;&#x9;&#x9;&#x9;&#x9;hdl:filodigital/16918">
   <metsHdr CREATEDATE="2026-11-10T12:21:36Z">
      <agent ROLE="CUSTODIAN" TYPE="ORGANIZATION">
         <name>DSpace de la Facultad de Filosofia y Letras</name>
