               <mods:titleInfo>
                  <mods:title>Epidemiological assessment of neglected diseases in children: lymphatic filariasis and soil-transmitted helminthiasis Prevalência de doenças negligenciadas em escolares: filariose linfática e parasitoses intestinais</mods:title>
               </mods:titleInfo>
               <mods:genre>journal article</mods:genre>
            </mods:mods>
         </xmlData>
