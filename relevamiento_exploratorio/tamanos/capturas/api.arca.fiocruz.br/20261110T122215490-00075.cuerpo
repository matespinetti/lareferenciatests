</metadata></record><record><header><identifier>oai:arca.fiocruz.br:icict/22897</identifier><datestamp>2026-10-26T16:20:42Z</datestamp><setSpec>com_icict_22858</setSpec><setSpec>com_icict_3802</setSpec><setSpec>col_icict_22860</setSpec></header><metadata><mets xmlns="http://www.loc.gov/METS/" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" ID="&#xa;&#x9;&#x9;&#x9;&#x9;DSpace_ITEM_icict-22897" TYPE="DSpace ITEM" PROFILE="DSpace METS SIP Profile 1.0" xsi:schemaLocation="http://www.loc.gov/METS/ http://www.loc.gov/standards/mets/mets.xsd" OBJID="&#xa;&#x9;&#x9;&#x9;&#x9;hdl:icict/22897">
   <metsHdr CREATEDATE="2026-11-10T12:23:21Z">
