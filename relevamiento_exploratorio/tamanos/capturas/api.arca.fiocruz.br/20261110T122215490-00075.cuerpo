               </mods:originInfo>
               <mods:identifier type="citation">SIMÕES-GURGEL, Claudia et al. Establishment of anthocyanin-producing habituated callus cultures of Tarenaya rosea (Vahl ex DC.) Soares Neto &amp;amp; Roalson. Revista Fitos, Rio de Janeiro, v. 18, p. 1-10, 2024.</mods:identifier>
               <mods:identifier type="issn">1808-9569</mods:identifier>
               <mods:identifier type="uri">https://arca.fiocruz.br/handle/icict/69040</mods:identifier>
