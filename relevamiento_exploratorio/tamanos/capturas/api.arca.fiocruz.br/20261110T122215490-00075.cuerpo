               </mods:name>
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">member</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Gomes, Márcia Marques</mods:namePart>
               </mods:name>
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">member</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Sodré, Fernando Fabriz</mods:namePart>
               </mods:name>
               <mods:name>
