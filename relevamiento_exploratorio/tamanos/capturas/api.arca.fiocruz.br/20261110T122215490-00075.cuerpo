</metadata></record><record><header><identifier>oai:arca.fiocruz.br:icict/27832</identifier><datestamp>2026-10-25T14:13:31Z</datestamp><setSpec>com_icict_1707</setSpec><setSpec>com_icict_7119</setSpec><setSpec>col_icict_6664</setSpec><setSpec>col_icict_9216</setSpec></header><metadata><mets xmlns="http://www.loc.gov/METS/" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" ID="&#xa;&#x9;&#x9;&#x9;&#x9;DSpace_ITEM_icict-27832" TYPE="DSpace ITEM" PROFILE="DSpace METS SIP Profile 1.0" xsi:schemaLocation="http://www.loc.gov/METS/ http://www.loc.gov/standards/mets/mets.xsd" OBJID="&#xa;&#x9;&#x9;&#x9;&#x9;hdl:icict/27832">
   <metsHdr CREATEDATE="2026-11-10T12:23:21Z">
      <agent ROLE="CUSTODIAN" TYPE="ORGANIZATION">
         <name>Arca - Repositório Institucional da Fiocruz</name>
