</metadata></record><record><header><identifier>oai:arca.fiocruz.br:icict/39218</identifier><datestamp>2026-10-25T17:28:17Z</datestamp><setSpec>com_icict_28198</setSpec><setSpec>com_icict_13554</setSpec><setSpec>col_icict_28200</setSpec></header><metadata><mets xmlns="http://www.loc.gov/METS/" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" ID="&#xa;&#x9;&#x9;&#x9;&#x9;DSpace_ITEM_icict-39218" TYPE="DSpace ITEM" PROFILE="DSpace METS SIP Profile 1.0" xsi:schemaLocation="http://www.loc.gov/METS/ http://www.loc.gov/standards/mets/mets.xsd" OBJID="&#xa;&#x9;&#x9;&#x9;&#x9;hdl:icict/39218">
