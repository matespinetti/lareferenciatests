</mets></metadata></record><record><header><identifier>oai:rdu.unc.edu.ar:11086/555406</identifier><datestamp>2025-04-23T14:57:41Z</datestamp><setSpec>com_11086_489</setSpec><setSpec>com_11086_166</setSpec><setSpec>col_11086_552647</setSpec></header><metadata><mets xmlns="http://www.loc.gov/METS/" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" ID="&#xa;&#x9;&#x9;&#x9;&#x9;DSpace_ITEM_11086-555406" TYPE="DSpace ITEM" PROFILE="DSpace METS SIP Profile 1.0" xsi:schemaLocation="http://www.loc.gov/METS/ http://www.loc.gov/standards/mets/mets.xsd" OBJID="&#xa;&#x9;&#x9;&#x9;&#x9;hdl:11086/555406">
   <metsHdr CREATEDATE="2026-11-10T12:23:21Z">
