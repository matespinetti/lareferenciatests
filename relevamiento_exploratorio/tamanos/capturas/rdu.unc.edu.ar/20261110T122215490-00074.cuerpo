                  <mods:topic>Derechos sociales </mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Corte suprema de justicia</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Desco16: Derechos Sociales en la Corte 2016</mods:title>
               </mods:titleInfo>
               <mods:genre/>
            </mods:mods>
         </xmlData>
      </mdWrap>
   </dmdSec>
