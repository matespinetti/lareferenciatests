      <mdWrap MDTYPE="MODS">
         <xmlData xmlns:mods="http://www.loc.gov/mods/v3" xsi:schemaLocation="http://www.loc.gov/mods/v3 http://www.loc.gov/standards/mods/v3/mods-3-1.xsd">
            <mods:mods xsi:schemaLocation="http://www.loc.gov/mods/v3 http://www.loc.gov/standards/mods/v3/mods-3-1.xsd">
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">advisor</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Quintana Salvat, Francisco</mods:namePart>
               </mods:name>
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">advisor</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Cebollada y Verdaguer, María del Pilar</mods:namePart>
               </mods:name>
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">author</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Jaymes, Gisela Beatriz</mods:namePart>
               </mods:name>
               <mods:extension>
                  <mods:dateAccessioned encoding="iso8601">2015-10-19T22:39:01Z</mods:dateAccessioned>
               </mods:extension>
               <mods:extension>
                  <mods:dateAvailable encoding="iso8601">2015-10-19T22:39:01Z</mods:dateAvailable>
               </mods:extension>
               <mods:originInfo>
                  <mods:dateIssued encoding="iso8601">2015</mods:dateIssued>
               </mods:originInfo>
               <mods:identifier type="none"/>
               <mods:identifier type="uri">http://hdl.handle.net/11086/2156</mods:identifier>
               <mods:abstract>Implica la zonificación de áreas suceptibles y la evaluación de niveles de vulnerabilidad ante amenazas de tipo erosivas, principalmente, en las márgenes de Río Segundo, a la altura de la localidad de Villa del Rosario, Provincia de Córdoba; Argentina. Analiza los aspectos más importantes de las condiciones geológicas y geomorfológicas, entre otros aspectos geológicos-ambientales</mods:abstract>
               <mods:language>
                  <mods:languageTerm authority="rfc3066">spa</mods:languageTerm>
               </mods:language>
               <mods:accessCondition type="useAndReproduction">Atribución-NoComercial-SinDerivadas 2.5 Argentina</mods:accessCondition>
               <mods:subject>
                  <mods:topic>Trabajo Final CG</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Geología</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Geología regional</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Geomorfología</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Erosión</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Residuos urbanos</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Recursos hídricos</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Estudio geoambiental; zonificación y evaluación de amenazas en un tramo del Río Segundo (Xanaes) a la altura de la localidad de Villa del Rosario - 31°32'36.24'' S, 63°32'8.87'' O -, Provincia de Córdoba"</mods:title>
               </mods:titleInfo>
               <mods:genre>bachelorThesis</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
   </dmdSec>
