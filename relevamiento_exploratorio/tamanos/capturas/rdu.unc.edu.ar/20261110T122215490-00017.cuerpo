                  <mods:topic>Espacio áulico</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Aprender en contextos de pandemia: tensiones en torno a las subjetividades construidas</mods:title>
               </mods:titleInfo>
               <mods:genre>bookPart</mods:genre>
            </mods:mods>
         </xmlData>
