                  <mods:title>Variedades de vegetales y de hongos existentes en la República Argentina y poseedoras de principios psicoactivos /</mods:title>
               </mods:titleInfo>
               <mods:genre>masterThesis</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
