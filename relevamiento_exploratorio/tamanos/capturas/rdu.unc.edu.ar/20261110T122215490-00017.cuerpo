               </mods:subject>
               <mods:subject>
                  <mods:topic>Google Classroom</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Moodle</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Trabajos colaborativos</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Google Drive</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Grupos de Whatsapp</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Estudiantes</mods:topic>
               </mods:subject>
