</mets></metadata></record><record><header><identifier>oai:rdu.unc.edu.ar:11086/23398</identifier><datestamp>2022-03-24T09:23:26Z</datestamp><setSpec>com_11086_489</setSpec><setSpec>com_11086_166</setSpec><setSpec>col_11086_493</setSpec></header><metadata><mets xmlns="http://www.loc.gov/METS/" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" ID="&#xa;&#x9;&#x9;&#x9;&#x9;DSpace_ITEM_11086-23398" TYPE="DSpace ITEM" PROFILE="DSpace METS SIP Profile 1.0" xsi:schemaLocation="http://www.loc.gov/METS/ http://www.loc.gov/standards/mets/mets.xsd" OBJID="&#xa;&#x9;&#x9;&#x9;&#x9;hdl:11086/23398">
