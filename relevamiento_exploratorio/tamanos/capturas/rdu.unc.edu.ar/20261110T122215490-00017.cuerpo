                  <mods:topic>Youths</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Kirchnerism</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>La construcción de la narrativa nacional-popular en juventudes militantes durante los años del kirchnerismo en Argentina (2008-2015)</mods:title>
               </mods:titleInfo>
               <mods:genre>article</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
