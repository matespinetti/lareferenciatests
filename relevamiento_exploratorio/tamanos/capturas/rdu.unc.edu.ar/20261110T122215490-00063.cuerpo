               </mods:subject>
               <mods:subject>
                  <mods:topic>Imágenes</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Uno hace lo que puede, ¿no? : visualidades en tiempos de pandemia</mods:title>
               </mods:titleInfo>
               <mods:genre>book</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
