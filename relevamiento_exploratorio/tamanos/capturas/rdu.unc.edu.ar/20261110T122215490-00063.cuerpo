                  <mods:topic>Control de calidad</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Gestión de calidad</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Metodología para cuantificar accesibilidad y conveniencia de un sistema de transporte público masivo de pasajeros : aplicación al caso de la ciudad de Córdoba</mods:title>
               </mods:titleInfo>
               <mods:genre>masterThesis</mods:genre>
            </mods:mods>
         </xmlData>
