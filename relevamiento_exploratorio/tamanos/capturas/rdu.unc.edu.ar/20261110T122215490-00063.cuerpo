</mets></metadata></record><record><header><identifier>oai:rdu.unc.edu.ar:11086/27405</identifier><datestamp>2022-07-22T05:05:12Z</datestamp><setSpec>com_11086_79</setSpec><setSpec>col_11086_15834</setSpec></header><metadata><mets xmlns="http://www.loc.gov/METS/" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" ID="&#xa;&#x9;&#x9;&#x9;&#x9;DSpace_ITEM_11086-27405" TYPE="DSpace ITEM" PROFILE="DSpace METS SIP Profile 1.0" xsi:schemaLocation="http://www.loc.gov/METS/ http://www.loc.gov/standards/mets/mets.xsd" OBJID="&#xa;&#x9;&#x9;&#x9;&#x9;hdl:11086/27405">
   <metsHdr CREATEDATE="2026-11-10T12:23:11Z">
