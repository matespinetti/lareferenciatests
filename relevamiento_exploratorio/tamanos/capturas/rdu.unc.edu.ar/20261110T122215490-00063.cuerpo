               <mods:subject>
                  <mods:topic>Patrimonio arquitectónico</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>El sistema de aguas de Santa Catalina. Legado y patrimonio.</mods:title>
               </mods:titleInfo>
               <mods:genre>conferenceObject</mods:genre>
            </mods:mods>
         </xmlData>
