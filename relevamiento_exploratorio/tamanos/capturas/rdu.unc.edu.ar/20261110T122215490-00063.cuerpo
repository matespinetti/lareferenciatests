                  <mods:topic>Queso blando</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Aceite de oliva</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Córdoba</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Argentina</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Utilización de aceites esenciales de variedades de orégano como conservante antimicrobiano, antioxidante y de las propiedades sensoriales de alimentos: quesos cottage, ricota y aceite de oliva</mods:title>
               </mods:titleInfo>
               <mods:genre>doctoralThesis</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
