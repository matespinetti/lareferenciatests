               </mods:subject>
               <mods:subject>
                  <mods:topic>SARS-CoV-2</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Pandemia</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Aislamiento social y obligatorio</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Pobreza</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Comunidades vulnerables</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Antropología Social</mods:topic>
