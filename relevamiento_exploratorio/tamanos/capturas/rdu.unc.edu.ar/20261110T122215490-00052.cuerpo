      <mdWrap MDTYPE="MODS">
         <xmlData xmlns:mods="http://www.loc.gov/mods/v3" xsi:schemaLocation="http://www.loc.gov/mods/v3 http://www.loc.gov/standards/mods/v3/mods-3-1.xsd">
            <mods:mods xsi:schemaLocation="http://www.loc.gov/mods/v3 http://www.loc.gov/standards/mods/v3/mods-3-1.xsd">
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">advisor</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Martínez Ramacciotti, Javier</mods:namePart>
               </mods:name>
               <mods:name>
                  <mods:role>
                     <mods:roleTerm type="text">author</mods:roleTerm>
                  </mods:role>
                  <mods:namePart>Piñero, Rocío Belén</mods:namePart>
               </mods:name>
               <mods:extension>
                  <mods:dateAccessioned encoding="iso8601">2019-10-10T13:46:10Z</mods:dateAccessioned>
               </mods:extension>
               <mods:extension>
                  <mods:dateAvailable encoding="iso8601">2019-10-10T13:46:10Z</mods:dateAvailable>
               </mods:extension>
               <mods:originInfo>
                  <mods:dateIssued encoding="iso8601">2017</mods:dateIssued>
               </mods:originInfo>
               <mods:identifier type="uri">http://hdl.handle.net/11086/12892</mods:identifier>
               <mods:abstract>The present study analyzes the conceptual frames of the phenomenon “femicide” underlying&#xd;
Facebook interactions. This study brings together Critical Discourse Studies (2008), Cognitive&#xd;
Semantics (Cienki, 2007; Dancygier &amp; Sweetser, 2014; Fillmore, 2006; Minsky, 1975; Ziem,&#xd;
2014) and Gender Studies (Bourdieu, 2001; Cabrera Ullivarri, 2011; Segato, 2010; Warner,&#xd;
1994). The corpus consists of a “polylogue” (Bou-Franch, 2013) made up of forty nine&#xd;
responses that appeared in the public Facebook event “Ni Una Menos Córdoba”, which invited&#xd;
to massive demonstrations on June 3rd, 2015 in Argentina.</mods:abstract>
               <mods:language>
                  <mods:languageTerm authority="rfc3066">eng</mods:languageTerm>
               </mods:language>
               <mods:accessCondition type="useAndReproduction">Attribution-NonCommercial-NoDerivatives 4.0 Internacional</mods:accessCondition>
               <mods:subject>
                  <mods:topic>Femicidio</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Discurso</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Conceptualización</mods:topic>
               </mods:subject>
               <mods:subject>
                  <mods:topic>Facebook</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>Ni una menos : the conceptualization of femicides on facebook</mods:title>
               </mods:titleInfo>
               <mods:genre>bachelorThesis</mods:genre>
            </mods:mods>
         </xmlData>
      </mdWrap>
   </dmdSec>
