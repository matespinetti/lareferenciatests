<mods:topic>Foucault, Michel, 1926-1984</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>PERSONA</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>CONOCIMIENTO</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>LENGUAJE</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>FILOSOFIA</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>La relación 'persona-lenguaje' en Tomás de Aquino y en la teoría discursiva de Michel Foucault : una ruptura inevitable</mods:title>
