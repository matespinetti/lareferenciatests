<mods:topic>Tomás de Aquino, Santo, 1225?-1274</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>Machiavelli, Niccolò, 1469-1527</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>La política en la actualidad : ¿más cerca de la virtud o del vicio?</mods:title>
</mods:titleInfo>
