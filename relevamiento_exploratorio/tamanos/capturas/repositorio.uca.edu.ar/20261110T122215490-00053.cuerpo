</mods:subject>
<mods:subject>
<mods:topic>FILOSOFIA DEL DERECHO</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>DERECHOS HUMANOS</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>CORTE SUPREMA DE JUSTICIA</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>JURISPRUDENCIA</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>El concepto de dignidad humana en la jurisprudencia de la Corte Suprema de Justicia de la Nación</mods:title>
</mods:titleInfo>
<mods:genre>Artículo</mods:genre>
</mods:mods>
</xmlData>
