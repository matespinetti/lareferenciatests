</mods:subject>
<mods:subject>
<mods:topic>CAPACIDAD JURIDICA</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>El concepto de capacidad en el matrimonio</mods:title>
</mods:titleInfo>
