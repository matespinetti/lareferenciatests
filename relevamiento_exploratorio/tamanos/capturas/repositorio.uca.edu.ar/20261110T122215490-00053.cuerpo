<mods:topic>Tomás de Aquino, Santo, 1225?-1274</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>Aristóteles, 384-322 a.C.</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>FILOSOFIA POLITICA</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>FILOSOFIA SOCIAL</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>ESTADO</mods:topic>
</mods:subject>
<mods:titleInfo>
