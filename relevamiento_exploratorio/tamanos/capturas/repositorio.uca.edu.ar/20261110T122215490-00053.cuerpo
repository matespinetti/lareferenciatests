</mods:subject>
<mods:subject>
<mods:topic>Agustín de Hipona, Santo, 354-430</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>Tomás de Aquino, Santo, 1225?-1274</mods:topic>
</mods:subject>
<mods:subject>
