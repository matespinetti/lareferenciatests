</mods:subject>
<mods:subject>
<mods:topic>SOCIEDAD</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>ECONOMIA</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>¿Cuál es y cómo se caracteriza la demanda potencial de microcréditos en la Argentina? : nuevas estimaciones</mods:title>
</mods:titleInfo>
<mods:genre>Artículo</mods:genre>
</mods:mods>
</xmlData>
</mdWrap>
</dmdSec>
