</mods:subject>
<mods:subject>
<mods:topic>LITERATURA MEDIEVAL</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>POESIA ESPAÑOLA</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>TEOLOGIA MISTICA</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>Teología mística de Gonzalo de Berceo</mods:title>
</mods:titleInfo>
