</mods:subject>
<mods:subject>
<mods:topic>SECTOR PRODUCTIVO</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>EQUIDAD</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>ANALISIS COMPARATIVO</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>Sistema tributario argentino : un análisis comparativo de la contribución por sectores productivos y de la equidad sectorial (primera parte)</mods:title>
</mods:titleInfo>
<mods:genre>Documento de trabajo</mods:genre>
</mods:mods>
</xmlData>
</mdWrap>
</dmdSec>
