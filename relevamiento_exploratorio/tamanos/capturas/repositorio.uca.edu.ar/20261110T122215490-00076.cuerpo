<mods:topic>NEUROCIENCIA</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>NEUROETICA</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>DESARROLLO COGNITIVO</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>BIOETICA</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>Estado de situación de los estudios de neurobioética en relación al neurocognitive enhancement en Argentina y el mundo</mods:title>
</mods:titleInfo>
<mods:genre>Artículo</mods:genre>
</mods:mods>
</xmlData>
