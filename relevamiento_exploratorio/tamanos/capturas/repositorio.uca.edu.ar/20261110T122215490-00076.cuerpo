<mods:titleInfo>
<mods:title>Inteligencias múltiples en sectores en condición de vulnerabilidad : aportes a la reflexión pedagógico-didáctica</mods:title>
</mods:titleInfo>
<mods:genre>Tesis de grado</mods:genre>
