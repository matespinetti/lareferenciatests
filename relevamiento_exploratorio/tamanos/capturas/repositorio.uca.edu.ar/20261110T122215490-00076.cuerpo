</mods:subject>
<mods:subject>
<mods:topic>BIEN COMUN</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>Democracia, bien común y bienes comunes</mods:title>
</mods:titleInfo>
<mods:genre>Artículo</mods:genre>
</mods:mods>
</xmlData>
</mdWrap>
</dmdSec>
