<mods:topic>ENFERMEDAD DE ALZHEIMER</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>DETERIORO COGNITIVO</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>SISTEMA LIMBICO</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>INMUNOLOGIA</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>Failure to recover from proactive semantic interference and abnormal limbic connectivity in asymptomatic, middle-aged offspring of patients with late-onset Alzheimer’s disease</mods:title>
</mods:titleInfo>
<mods:genre>Artículo</mods:genre>
</mods:mods>
