</mods:subject>
<mods:subject>
<mods:topic>MUSICA DE CAMARA</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>COMPOSITORES</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>Apuntes para una historia de la música argentina</mods:title>
</mods:titleInfo>
