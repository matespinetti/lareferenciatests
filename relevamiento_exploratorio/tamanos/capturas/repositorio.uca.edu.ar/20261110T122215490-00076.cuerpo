<mods:topic>MELATONINA</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>EXPRESION GENICA</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>CORTICOSTERONA</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>Cadmium as an endocrine disruptor : correlation with anterior pituitary redox and circadian clock mechanisms and prevention by melatonin</mods:title>
</mods:titleInfo>
<mods:genre>Artículo</mods:genre>
</mods:mods>
</xmlData>
