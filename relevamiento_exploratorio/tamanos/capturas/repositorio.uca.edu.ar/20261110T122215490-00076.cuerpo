</mods:subject>
<mods:titleInfo>
<mods:title>La tesis de la brecha psicosocial : un modelo de causalidad psicosocial del malestar psicológico</mods:title>
</mods:titleInfo>
<mods:genre>Tesis doctoral</mods:genre>
</mods:mods>
</xmlData>
