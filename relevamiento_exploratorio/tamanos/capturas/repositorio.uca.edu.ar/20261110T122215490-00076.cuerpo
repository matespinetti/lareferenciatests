</mods:subject>
<mods:subject>
<mods:topic>HISTORIA DE LA MUSICA ARGENTINA</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>PUBLICACIONES PERIODICAS</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>Materiales para un historia de la música argentina : las revistas musicales : “Bibelot”</mods:title>
</mods:titleInfo>
<mods:genre>Artículo</mods:genre>
</mods:mods>
</xmlData>
