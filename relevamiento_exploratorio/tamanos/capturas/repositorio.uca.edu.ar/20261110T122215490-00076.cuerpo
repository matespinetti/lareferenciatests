</mods:subject>
<mods:subject>
<mods:topic>ANALISIS ECONOMICO</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>Economía del deporte : una revisión sobre el estudio de la participación en actividades físicas deportivas</mods:title>
</mods:titleInfo>
<mods:genre>Artículo</mods:genre>
</mods:mods>
</xmlData>
