<mods:topic>NACIONES UNIDAS</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>INDICES</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>MEDICION</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>Implicit assumptions when measuring in economics : the human development index (HDI) as a case study</mods:title>
</mods:titleInfo>
<mods:genre>Artículo</mods:genre>
</mods:mods>
</xmlData>
