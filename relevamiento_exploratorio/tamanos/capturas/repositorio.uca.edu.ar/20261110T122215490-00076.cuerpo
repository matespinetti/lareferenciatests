</mods:subject>
<mods:subject>
<mods:topic>MACROECONOMIA</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>POLITICA ECONOMICA</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>GASTO PUBLICO</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>Dealing with the dutch disease : fiscal rules and macro-prudential policies</mods:title>
</mods:titleInfo>
<mods:genre>Documento de trabajo</mods:genre>
</mods:mods>
</xmlData>
