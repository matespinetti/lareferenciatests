<mods:topic>MUSICA</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>Ayestarán Fernández, Lauro Sebastián, 1913-1966</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>Lauro Ayestarán</mods:title>
</mods:titleInfo>
<mods:genre>Artículo</mods:genre>
</mods:mods>
</xmlData>
