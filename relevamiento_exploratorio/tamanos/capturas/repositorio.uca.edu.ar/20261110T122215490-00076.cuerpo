<mods:topic>BIOLOGIA</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>MEDICINA</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>TUMORES</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>GLANDULA TIROIDES</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>HORMONAS</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>Integrin avB3 acting as membrane receptor for thyroid hormones mediates angiogenesis in malignant T cells</mods:title>
</mods:titleInfo>
<mods:genre>Artículo</mods:genre>
</mods:mods>
</xmlData>
