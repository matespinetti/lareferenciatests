</mods:subject>
<mods:subject>
<mods:topic>BIEN COMUN</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>CARITAS IN VERITATE</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>ENCICLICAS</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>CULTURA</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>La responsabilidad social empresaria (RSE) a la luz de Caritas in veritate</mods:title>
</mods:titleInfo>
