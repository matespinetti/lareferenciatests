</mods:subject>
<mods:titleInfo>
<mods:title>Efectos dinámicos de la política fiscal : una aplicación al caso uruguayo</mods:title>
</mods:titleInfo>
<mods:genre>Tesis doctoral</mods:genre>
</mods:mods>
</xmlData>
