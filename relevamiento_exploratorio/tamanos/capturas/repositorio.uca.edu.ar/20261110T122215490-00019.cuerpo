</mods:subject>
<mods:titleInfo>
<mods:title>Acciones de clase y derechos del consumidor : análisis del derecho argentino y legislaciones comparadas</mods:title>
</mods:titleInfo>
<mods:genre>Tesis de maestría</mods:genre>
