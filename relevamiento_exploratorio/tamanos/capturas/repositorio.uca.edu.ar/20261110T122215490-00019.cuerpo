</mods:subject>
<mods:subject>
<mods:topic>DERECHO CONSTITUCIONAL</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>PROGRESO</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>CONGRESO</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>El desarrollo humano como tarea del Congreso de la Nación : la noción actual de prosperidad en la Constitución Nacional</mods:title>
</mods:titleInfo>
<mods:genre>Tesis doctoral</mods:genre>
</mods:mods>
</xmlData>
</mdWrap>
</dmdSec>
