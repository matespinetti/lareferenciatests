<mods:topic>CURIA DIOCESANA</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>La aplicación del principio de subsidiariedad como un criterio de buen gobierno del obispo diocesano</mods:title>
</mods:titleInfo>
