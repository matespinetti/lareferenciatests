</mods:subject>
<mods:subject>
<mods:topic>CONDICIONES DE TRABAJO</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>Llamada perdida detrás del “0800” : normas, control y estrés laboral en los Call Center</mods:title>
</mods:titleInfo>
<mods:genre>Tesis de maestría</mods:genre>
</mods:mods>
