<mods:subject>
<mods:topic>LEGITIMA</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>DERECHO CONSTITUCIONAL</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>La flexibilización de la legítima hereditaria</mods:title>
</mods:titleInfo>
