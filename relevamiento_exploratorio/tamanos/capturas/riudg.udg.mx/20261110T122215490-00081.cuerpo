<mods:subject>
<mods:topic>Multifuncionalidad De Los Sistemas De Produccion Agricola</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>MULTIFUNCIONALIDAD DE LOS SISTEMAS DE PRODUCCIÓN AGRÍCOLA: UNA CONTRIBUCIÓN METODOLÓGICA</mods:title>
</mods:titleInfo>
<mods:genre>Tesis de Doctorado</mods:genre>
</mods:mods>
