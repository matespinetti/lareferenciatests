<mods:topic>Holonomicas</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>Robots</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>Redes</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>Cinematico</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>Consenso de redes de robots con restricciones no-holonómicas</mods:title>
</mods:titleInfo>
<mods:genre>Tesis de Maestria</mods:genre>
</mods:mods>
</xmlData>
