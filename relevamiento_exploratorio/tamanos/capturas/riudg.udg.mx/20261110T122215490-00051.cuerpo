<mods:titleInfo>
<mods:title>De Revolvtionibvs Orbium Coeleftium</mods:title>
</mods:titleInfo>
<mods:genre>Libro</mods:genre>
</mods:mods>
</xmlData>
</mdWrap>
</dmdSec>
