</mods:subject>
<mods:titleInfo>
<mods:title>La información en la construcción de la sociedad y la ciudadanía</mods:title>
</mods:titleInfo>
<mods:genre>Memorias</mods:genre>
</mods:mods>
</xmlData>
</mdWrap>
