</mods:subject>
<mods:titleInfo>
<mods:title>De la biblioteca al usuario, del usuario a la biblioteca: puntos de encuentro</mods:title>
</mods:titleInfo>
<mods:genre>Memorias</mods:genre>
</mods:mods>
