</mods:subject>
<mods:titleInfo>
<mods:title>Gestión, estrategias y cambios en los espacios bibliotecarios en el nuevo siglo</mods:title>
</mods:titleInfo>
<mods:genre>Memorias</mods:genre>
</mods:mods>
