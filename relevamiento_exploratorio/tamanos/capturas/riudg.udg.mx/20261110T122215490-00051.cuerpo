</mods:subject>
<mods:titleInfo>
<mods:title>La biblioteca: memoria documental de la humanidad</mods:title>
</mods:titleInfo>
<mods:genre>Memorias</mods:genre>
</mods:mods>
</xmlData>
</mdWrap>
