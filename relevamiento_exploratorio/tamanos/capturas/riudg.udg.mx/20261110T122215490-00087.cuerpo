</mods:subject>
<mods:titleInfo>
<mods:title>Restitución Fotogramétrica de Sta. María Huatulco, Oaxaca.</mods:title>
</mods:titleInfo>
<mods:genre>Informe de practicas profesionales</mods:genre>
</mods:mods>
