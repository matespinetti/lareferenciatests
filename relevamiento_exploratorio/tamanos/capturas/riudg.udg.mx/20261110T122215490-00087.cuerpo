<mods:topic>Habilidades Blandas</mods:topic>
</mods:subject>
<mods:subject>
<mods:topic>Inteligencia Artificial</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>Análisis y Diagnóstico de Habilidades Blandas en Estudiantes de Mercadotecnia de la Universidad de Guadalajara: Hacia un Marco de Referencia para el Desempeño Profesional.</mods:title>
</mods:titleInfo>
<mods:genre>Tesis de Maestría</mods:genre>
</mods:mods>
</xmlData>
</mdWrap>
</dmdSec>
