</mods:subject>
<mods:subject>
<mods:topic>Mexico</mods:topic>
</mods:subject>
<mods:titleInfo>
<mods:title>Variación espacio-temporal de los ensambles de arañas edáficas (Arachnida: Araneae) a lo largo del gradiente de elevación del Volcán de Tequila, Jalisco, México</mods:title>
</mods:titleInfo>
<mods:genre>Tesis de Maestría</mods:genre>
</mods:mods>
</xmlData>
</mdWrap>
