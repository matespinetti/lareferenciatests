                        <premis:objectIdentifierValue>https://rephip.unr.edu.ar/bitstreams/398e0cc2-6712-4e0a-b004-48a4a086d98e/download</premis:objectIdentifierValue>
                     </premis:objectIdentifier>
                     <premis:objectCategory>File</premis:objectCategory>
                     <premis:objectCharacteristics>
                        <premis:fixity>
                           <premis:messageDigestAlgorithm>MD5</premis:messageDigestAlgorithm>
                           <premis:messageDigest>6fa654ed09dda7db4c6c522b11d283b3</premis:messageDigest>
                        </premis:fixity>
                        <premis:size>3851598</premis:size>
                        <premis:format>
