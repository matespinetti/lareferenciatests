               </mods:subject>
               <mods:subject>
                  <mods:topic>Repositorio Acceso Abierto</mods:topic>
               </mods:subject>
               <mods:titleInfo>
                  <mods:title>El Modo Interactivo del Dispositivo Hipermedial Dinámico</mods:title>
               </mods:titleInfo>
               <mods:genre>Thesis</mods:genre>
            </mods:mods>
         </xmlData>
