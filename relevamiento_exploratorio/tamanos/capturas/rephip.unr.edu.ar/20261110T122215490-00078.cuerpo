</metadata></record><record><header><identifier>oai:rephip.unr.edu.ar:2133/27521</identifier><datestamp>2024-09-04T15:38:25Z</datestamp><setSpec>com_2133_6746</setSpec><setSpec>com_2133_6733</setSpec><setSpec>com_2133_6720</setSpec><setSpec>com_2133_1159</setSpec><setSpec>col_2133_25004</setSpec></header><metadata><mets xmlns="http://www.loc.gov/METS/" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:doc="http://www.lyncode.com/xoai" ID="&#xa;&#x9;&#x9;&#x9;&#x9;DSpace_ITEM_2133-27521" TYPE="DSpace ITEM" PROFILE="DSpace METS SIP Profile 1.0" xsi:schemaLocation="http://www.loc.gov/METS/ http://www.loc.gov/standards/mets/mets.xsd" OBJID="&#xa;&#x9;&#x9;&#x9;&#x9;hdl:2133/27521">
