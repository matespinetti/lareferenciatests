               </mods:subject>
               <mods:titleInfo>
                  <mods:title>EL CAMPUS VIRTUAL UNR COMO UN DISPOSITIVO HIPERMEDIAL DINÁMICO PARA EDUCAR E INVESTIGAR.</mods:title>
               </mods:titleInfo>
               <mods:genre>Presentation</mods:genre>
            </mods:mods>
         </xmlData>
