	<dc:format>application/pdf</dc:format>
	<dc:identifier>https://archivo.revistas.ucr.ac.cr/index.php/rbt/article/view/2185</dc:identifier>
	<dc:identifier>10.15517/rbt.v60i4.2185</dc:identifier>
	<dc:source xml:lang="en-US">Revista de Biología Tropical; Vol. 60 No. 4 (2012): Volume 60 – Regular number 4 – December 2012; 1847–1856</dc:source>
