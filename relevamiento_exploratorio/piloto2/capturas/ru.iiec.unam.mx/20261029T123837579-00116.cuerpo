    <metadata>
      <oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
        <dc:relation>http://ru.iiec.unam.mx/2144/</dc:relation>
        <dc:title>Nuevas tendencias en los flujos internacionales de capital. El caso de la inversión norteamericana</dc:title>
        <dc:creator>Amador Zamora, Edgar</dc:creator>
        <dc:subject>F21 - Inversión internacional ; Movimientos de capital a largo plazo</dc:subject>
        <dc:subject>G15 - Mercados financieros internacionales</dc:subject>
        <dc:subject>O16 - Mercados financieros ; Ahorro e inversión de capital</dc:subject>
        <dc:subject>O51 - Estados Unidos ; Canadá</dc:subject>
        <dc:description>Estados Unidos continúa siendo el país que más invierte en el exterior y, junto al crecimiento de la inversión directa, ha continuado su proceso de diversificación territorial e industrial, lidereando en muchos casos las nuevas formas de internacionalización productiva. Es por esto que el estudio  de la inversión exterior norteamericana, a pesar de la pérdida relativa de su importancia, constituye un componente fundamental de la economía internacional.</dc:description>
        <dc:publisher>Instituto de Investigaciones Económicas, UNAM</dc:publisher>
        <dc:date>1991-03</dc:date>
        <dc:type>Artículo</dc:type>
        <dc:type>PeerReviewed</dc:type>
        <dc:format>application/pdf</dc:format>
        <dc:language>es</dc:language>
        <dc:identifier>http://ru.iiec.unam.mx/2144/1/Amador%20Zamora%2C%20Edgar.pdf</dc:identifier>
        <dc:identifier>   Amador Zamora, Edgar   (1991): Nuevas tendencias en los flujos internacionales de capital. El caso de la inversión norteamericana.  Momento Económico (54).  pp. 10-17.  ISSN 0186-2901     </dc:identifier></oai_dc:dc></metadata></record>
