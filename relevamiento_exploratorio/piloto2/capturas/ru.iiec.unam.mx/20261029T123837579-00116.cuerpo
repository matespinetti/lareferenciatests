    <metadata>
      <oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
        <dc:relation>http://ru.iiec.unam.mx/2235/</dc:relation>
        <dc:title>¿Quién dirige la educación en México?</dc:title>
        <dc:creator>Imaz Gispert, Carlos</dc:creator>
        <dc:subject>H52 - Gasto público de la administración y educación</dc:subject>
        <dc:subject>I21 - Análisis de la educación</dc:subject>
        <dc:subject>I28 - Política pública</dc:subject>
        <dc:description>Conocer las líneas generales de la actual política educativa del gobierno federal en Estados Unidos y los resultados que de ella están a la vista, parece un elemento indispensable para el análisis de la política educativa del gobierno mexicano y sus consecuencias. No sólo la adopción de una misma tendencia ideológica indica que ello es pertinente, sino también la adopción, por parte del gobierno mexicano, del programa de política educativa estadounidense.</dc:description>
        <dc:publisher>Instituto de Investigaciones Económicas, UNAM</dc:publisher>
        <dc:date>1992-05</dc:date>
        <dc:type>Artículo</dc:type>
        <dc:type>PeerReviewed</dc:type>
        <dc:format>application/pdf</dc:format>
        <dc:language>es</dc:language>
        <dc:identifier>http://ru.iiec.unam.mx/2235/1/Imaz%20Gispert%2C%20Carlos.pdf</dc:identifier>
        <dc:identifier>   Imaz Gispert, Carlos   (1992): ¿Quién dirige la educación en México?  Momento Económico (61).  pp. 2-4.  ISSN 0186-2901     </dc:identifier></oai_dc:dc></metadata></record>
