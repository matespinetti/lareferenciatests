      <setSpec>74797065733D61727469636C65</setSpec>
      <setSpec>63726561746F72733D4F726E656C6173204265726E616C3A5261C3BA6C3A3A</setSpec></header>
    <metadata>
      <oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
        <dc:relation>http://ru.iiec.unam.mx/2159/</dc:relation>
        <dc:title>¿Cómo recibir al capital extranjero?</dc:title>
        <dc:creator>Ornelas Bernal, Raúl</dc:creator>
        <dc:subject>E22 - Capital ; Inversión (incluidas existencias) ; Capacidad</dc:subject>
        <dc:subject>F21 - Inversión internacional ; Movimientos de capital a largo plazo</dc:subject>
        <dc:subject>O16 - Mercados financieros ; Ahorro e inversión de capital</dc:subject>
        <dc:description>Durante la reciente reunión del Consejo Económico para la Cuenca del Pacífico se señaló la necesidad de establecer mayores ventajas para estimular el flujo de capital extranjero hacia los países de menor desarrollo, México en particular. En el mismo sentido se expresaron legisladores estadounidenses en la reunión interparlamentaria de mayo, en Baja California, al demandar cambios en la Ley que regula la inversión extranjera directa en el país. En este artículo el autor plantea algunos aspectos de la relación entre el flujo de capitales extranjeros y la legislación mexicana, con el fin de evaluar las pertinencia y el significado de un posible cambio en la Ley para promover la inversión mexicana  y regular la inversión  extranjera, principal obstáculo que ve el gran capital para invertir en México.</dc:description>
        <dc:publisher>Instituto de Investigaciones Económicas, UNAM</dc:publisher>
        <dc:date>1991-07</dc:date>
        <dc:type>Artículo</dc:type>
        <dc:type>PeerReviewed</dc:type>
        <dc:format>application/pdf</dc:format>
        <dc:language>es</dc:language>
        <dc:identifier>http://ru.iiec.unam.mx/2159/1/Ornelas%20Bernal%2C%20Ra%C3%BAl.pdf</dc:identifier>
        <dc:identifier>   Ornelas Bernal, Raúl   (1991): ¿Cómo recibir al capital extranjero?  Momento Económico (56).  pp. 14-21.  ISSN 0186-2901     </dc:identifier></oai_dc:dc></metadata></record>
