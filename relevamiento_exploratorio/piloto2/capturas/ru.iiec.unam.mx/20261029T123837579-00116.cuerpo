      <oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:dc="http://purl.org/dc/elements/1.1/" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
        <dc:relation>http://ru.iiec.unam.mx/2240/</dc:relation>
        <dc:title>Notas sobre el Tratado de Libre Comercio</dc:title>
        <dc:creator>González Ruiz, José Enrique</dc:creator>
        <dc:subject>F12 - Modelos de comercio con competencia imperfecta y economías de escala</dc:subject>
        <dc:subject>F16 - Interacciones entre el comercio y el mercado laboral</dc:subject>
        <dc:subject>F55 - Acuerdos institucionales internacionales</dc:subject>
        <dc:subject>Q18 - Política agraria ; Política alimentaria</dc:subject>
        <dc:description>Desde la perspectiva del autor, la negociación del Tratado de Libre Comercio debe incluir: 1) La igualación hacia arriba de las condiciones laborales en los tres países; Medidas para asegurar la autosuficiencia alimentaria, que es componente nodal de la soberanía; 3) Libre tránsito de la fuerza de trabajo, que es el elemento que mayor interés representa para México; 4) Pasos razonables para avanzar gradualmente en la integración de aquellos sectores que pueden ser barridos por la competencia estadounidense y canadiense.</dc:description>
        <dc:publisher>Instituto de Investigaciones Económicas, UNAM</dc:publisher>
        <dc:date>1992-05</dc:date>
        <dc:type>Artículo</dc:type>
        <dc:type>PeerReviewed</dc:type>
        <dc:format>application/pdf</dc:format>
        <dc:language>es</dc:language>
        <dc:identifier>http://ru.iiec.unam.mx/2240/1/Gonz%C3%A1lez%20Ru%C3%ADz%2C%20Jos%C3%A9%20Enrique.pdf</dc:identifier>
        <dc:identifier>   González Ruiz, José Enrique   (1992): Notas sobre el Tratado de Libre Comercio.  Momento Económico (61).  pp. 29-30.  ISSN 0186-2901     </dc:identifier></oai_dc:dc></metadata></record>
