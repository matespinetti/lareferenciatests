	<dc:creator>Fernández, Silvana Noelí</dc:creator>
	<dc:creator>Chiacchio, Cecilia</dc:creator>
	<dc:creator>Vernet, Mercedes</dc:creator>
	<dc:subject xml:lang="en-US"></dc:subject>
	<dc:subject xml:lang="es-ES">Literatura</dc:subject>
	<dc:description xml:lang="en-US"></dc:description>
	<dc:description xml:lang="es-ES">Literatura en lengua inglesa. Lecturas desde el sur propone un trayecto o recorrido literario, cultural y estético que comprende obras, autores y movimientos provenientes de un amplio territorio que no se limita a la noción monolítica y hegemónica del inglés, sino que además la interpela y cuestiona a partir del aporte de distintas teorías críticas. </dc:description>
