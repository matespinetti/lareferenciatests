<oai_dc:dc
	xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/"
	xmlns:dc="http://purl.org/dc/elements/1.1/"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/
	http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
	<dc:title xml:lang="en-US"></dc:title>
	<dc:title xml:lang="es-ES">Metáfora, verdad ficcional y conocimiento</dc:title>
	<dc:creator>Belén, Paola Sabrina</dc:creator>
	<dc:creator>Delle Donne, Sofía</dc:creator>
	<dc:creator>Cabra, Guillermina</dc:creator>
	<dc:subject xml:lang="en-US"></dc:subject>
	<dc:subject xml:lang="es-ES">Artes</dc:subject>
	<dc:description xml:lang="en-US"></dc:description>
	<dc:description xml:lang="es-ES">Este libro busca aportar reflexiones a la construcción de miradas múltiples y renovadas sobre la imagen y su potencia epistémica. Para ello, parte de un enfoque relacional y situacional, articulador de nociones de diversas disciplinas, que considera los procesos globales y los rasgos particulares de la cultura latinoamericana. Ofrece, en definitiva, herramientas teóricas y estrategias metodológicas para abordar la producción de imágenes, así como su investigación y enseñanza en las artes y las humanidades. </dc:description>
	<dc:publisher xml:lang="en-US">Portal de Libros de la Universidad Nacional de La Plata</dc:publisher>
	<dc:publisher xml:lang="es-ES">Portal de Libros de la Universidad Nacional de La Plata</dc:publisher>
	<dc:date>2026-10-01</dc:date>
	<dc:type xml:lang="es-ES">##rt.metadata.pkp.dctype##</dc:type>
