<oai_dc:dc
	xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/"
	xmlns:dc="http://purl.org/dc/elements/1.1/"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/
	http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
	<dc:title xml:lang="en-US"></dc:title>
	<dc:title xml:lang="es-ES">Estudios sobre comunicación y política: investigación de campo y análisis en tiempos de redes sociales e inteligencia artificial</dc:title>
	<dc:creator>González, Gustavo Fabián</dc:creator>
	<dc:subject xml:lang="en-US"></dc:subject>
	<dc:subject xml:lang="es-ES">Comunicación Social</dc:subject>
	<dc:description xml:lang="en-US"></dc:description>
	<dc:description xml:lang="es-ES">Las investigaciones desarrolladas por el Centro de Investigación y Capacitación en Estudios de Opinión Pública (CICEOP) dialogan con algunos de los principales desafíos de nuestra época. La expansión de las plataformas digitales, el protagonismo creciente de la inteligencia artificial, la circulación acelerada de información y desinformación, la reconfiguración de los liderazgos políticos, las nuevas formas de participación ciudadana y las tensiones que atraviesan a las democracias contemporáneas exigen marcos teóricos sólidos y, al mismo tiempo, investigaciones empíricas capaces de observar con precisión fenómenos volátiles. </dc:description>
	<dc:publisher xml:lang="en-US">Portal de Libros de la Universidad Nacional de La Plata</dc:publisher>
