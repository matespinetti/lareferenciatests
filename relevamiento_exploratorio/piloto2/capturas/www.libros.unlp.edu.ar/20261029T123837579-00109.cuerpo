<oai_dc:dc
	xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/"
	xmlns:dc="http://purl.org/dc/elements/1.1/"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/
	http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
	<dc:title xml:lang="en-US"></dc:title>
	<dc:title xml:lang="es-ES">Métodos y técnicas arqueológicas</dc:title>
	<dc:creator>Ratto, Norma</dc:creator>
	<dc:creator>Ramos van Raap, María Agustina</dc:creator>
	<dc:creator>Di Prado, Violeta Soledad</dc:creator>
	<dc:creator>Leipus, Marcela Sandra</dc:creator>
	<dc:subject xml:lang="en-US"></dc:subject>
	<dc:subject xml:lang="es-ES">Ciencias Naturales</dc:subject>
	<dc:description xml:lang="en-US"></dc:description>
	<dc:description xml:lang="es-ES">Este libro de cátedra ofrece un recorrido integral por los métodos y las técnicas de la investigación arqueológica, articulando fundamentos teóricos con prácticas analíticas concretas. A lo largo de siete capítulos se abordan el diseño de investigación, los procesos de formación del registro arqueológico y el estudio de diversas materialidades -cerámica, lítico, restos arqueobotánicos, biomateriales y evidencias minero-metalúrgicas-, mediante enfoques tecnológicos, arqueométricos e interdisciplinarios. La obra está orientada a la formación de estudiantes avanzados y propone criterios para la construcción, análisis e interpretación del dato arqueológico en contextos académicos y profesionales </dc:description>
	<dc:publisher xml:lang="en-US">Portal de Libros de la Universidad Nacional de La Plata</dc:publisher>
	<dc:publisher xml:lang="es-ES">Portal de Libros de la Universidad Nacional de La Plata</dc:publisher>
