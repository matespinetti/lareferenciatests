<oai_dc:dc
	xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/"
	xmlns:dc="http://purl.org/dc/elements/1.1/"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/
	http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
	<dc:title xml:lang="en-US"></dc:title>
	<dc:title xml:lang="es-ES">Vacunas en rumiantes domésticos</dc:title>
	<dc:creator>Mórtola, Eduardo Carlos</dc:creator>
	<dc:creator>Larsen, Alejandra Edith</dc:creator>
	<dc:subject xml:lang="en-US"></dc:subject>
	<dc:subject xml:lang="es-ES">Ciencias Veterinarias</dc:subject>
	<dc:description xml:lang="en-US"></dc:description>
	<dc:description xml:lang="es-ES">En esta segunda edición nos proponemos de manera ordenada, concisa y práctica establecer los conceptos básicos de las vacunas y vacunaciones en bovinos y ovinos, enfocada al contexto de nuestro país. Los estudiantes contarán con un material bibliográfico que concentre e interrelacione los aspectos epidemiológicos de la enfermedad, con los lineamientos de la respuesta inmune, el diagnóstico y la producción, uso y aplicación de vacunas veterinarias.</dc:description>
	<dc:publisher xml:lang="en-US">Portal de Libros de la Universidad Nacional de La Plata</dc:publisher>
