</oai_dc:dc></metadata></record><record><header><identifier>oai:sedici.unlp.edu.ar:10915/26197</identifier><datestamp>2026-10-21T14:02:35Z</datestamp><setSpec>com_10915_26193</setSpec><setSpec>com_10915_51</setSpec><setSpec>col_10915_26194</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:doc="http://www.lyncode.com/xoai" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://purl.org/dc/elements/1.1/" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
