</oai_dc:dc></metadata></record><record><header><identifier>oai:sedici.unlp.edu.ar:10915/14934</identifier><datestamp>2026-10-08T20:12:22Z</datestamp><setSpec>com_10915_853</setSpec><setSpec>com_10915_51</setSpec><setSpec>col_10915_894</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:doc="http://www.lyncode.com/xoai" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://purl.org/dc/elements/1.1/" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
<dc:identifier>https://sedici.unlp.edu.ar/handle/10915/14934</dc:identifier>
<dc:title>Sarmiento en sus contactos culturales con los Estados Unidos</dc:title>
<dc:creator>Cirigliano, Gustavo F. J.</dc:creator>
<dc:date>1961</dc:date>
<dc:date>2009-09-17T03:00:00Z</dc:date>
<dc:language>es</dc:language>
<dc:subject>Humanidades</dc:subject>
<dc:subject>Historia argentina</dc:subject>
<dc:subject>D. F. Sarmiento</dc:subject>
<dc:subject>Educación</dc:subject>
<dc:subject>Estados Unidos</dc:subject>
<dc:description>Sabido es que Sarmiento estuvo dos veces en los Estados Unidos. Su primer viaje, realizado en 1847, lo hizo enviado por el gobierno de Chile para estudiar la situación educativa en Europa y los Estados Unidos. Este viaje de estudios, que duró más de dos años, fue el más importante que realizara político argentino alguno por aquella época. Sarmiento sabía qué quería ver en los Estados Unidos, pues ya sabía de Horace Mann, a través de sus libros. En esta oportunidad establece un contacto duradero con éste y su esposa.</dc:description>
<dc:description>Facultad de Humanidades y Ciencias de la Educación</dc:description>
<dc:type>Articulo</dc:type>
<dc:type>Articulo</dc:type>
<dc:rights>http://creativecommons.org/licenses/by-nc-sa/4.0/</dc:rights>
<dc:rights>Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0)</dc:rights>
<dc:format>application/pdf</dc:format>
<dc:format>171-180</dc:format>
<dc:source>&lt;a href="http://www.memoria.fahce.unlp.edu.ar" target="_blank">Memoria académica&lt;/a></dc:source>
</oai_dc:dc></metadata></record><record><header><identifier>oai:sedici.unlp.edu.ar:10915/14935</identifier><datestamp>2026-10-08T20:12:23Z</datestamp><setSpec>com_10915_853</setSpec><setSpec>com_10915_51</setSpec><setSpec>col_10915_894</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/" xmlns:doc="http://www.lyncode.com/xoai" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://purl.org/dc/elements/1.1/" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
