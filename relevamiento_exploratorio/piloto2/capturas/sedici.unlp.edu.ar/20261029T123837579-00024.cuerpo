<dc:title>Del orden al desborde : Apropiaciones del paradigma de la complejidad y sus implicaciones para los conceptos de orden y cambio en las ciencias sociales</dc:title>
<dc:creator>Benitez, Joaquín</dc:creator>
<dc:date>2012-12</dc:date>
