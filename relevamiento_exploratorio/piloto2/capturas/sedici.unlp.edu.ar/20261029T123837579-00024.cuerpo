<dc:title>El mar y los ríos en la vida de Sarmiento : 1833-1852</dc:title>
<dc:creator>Craviotto, José Alcides</dc:creator>
<dc:date>1961</dc:date>
<dc:date>2009-09-17T03:00:00Z</dc:date>
