mail" required="" type="email" class="form-control form-control-lg position-relative ng-tns-c138-7 ng-untouched ng-pristine ng-invalid" placeholder="Correo electrónico" aria-label="Correo electrónico" value=""><input _ngcontent-sc138="" autocomplete="current-password" formcontrolname="password" required="" type="password" class="form-control form-control-lg position-relative mb-3 ng-tns-c138-7 ng-untouched ng-pristine ng-invalid" placeholder="Contraseña" aria-label="Contraseña" value=""><!----><!----><button _ngcontent-sc138="" type="submit" role="button" tabindex="0" class="btn btn-lg btn-primary btn-block mt-3 ng-tns-c138-7 disabled" aria-disabled="true"><i _ngcontent-sc138="" class="fas fa-sign-in-alt ng-tns-c138-7"></i> Iniciar sesión</button></form><div _ngcontent-sc138="" class="mt-2 ng-tns-c138-7"><a _ngcontent-sc138="" tabindex="0" class="dropdown-item ng-tns-c138-7 ng-star-inserted" href="/register"> ¿Nuevo Usuario? Pulse aquí para registrarse </a><!----><a _ngcontent-sc138="" tabindex="0" class="dropdown-item ng-tns-c138-7" href="/forgot"> ¿Has olvidado tu contraseña? </a></div></ds-log-in-password><!----></ds-log-in-container><!----><!----><!----></div><!----></ds-log-in><!----></ds-themed-log-in></div></div></div><!----><!----></div><!----><!----></ds-auth-nav-menu><!----></ds-themed-auth-nav-menu></div></div></div></div><h1 _ngcontent-sc250="" class="titulo-home">Repositorio Digital Universitario</h1><div _ngcontent-sc250="" class="texto-repositorio"><p _ngcontent-sc250="">El Repositorio Digital de la Universidad Nacional de Córdoba (RDU), es un espacio donde se almacena, organiza, preserva, provee acceso libre y procura dar visibilidad a nivel nacional e internacional, a la producción científica, académica y cultural en formato digital, generada por las personas que integran su comunidad universitaria.</p></div><div _ngcontent-sc250="" class="input-search"><ds-search-form _ngcontent-sc250="" _nghost-sc76=""><form _ngcontent-sc76="" novalidate="" action="/search" class="ng-untouched ng-pristine ng-valid"><div _ngcontent-sc76=""><div _ngcontent-sc76="" class="form-group input-group"><!----><input _ngcontent-sc76="" type="text" name="query" class="form-control buscador ng-untouched ng-pristine ng-valid" placeholder="Buscar en el repositorio ..." aria-label="Buscar en el repositorio ..." value=""><span _ngcontent-sc76="" class="input-group-append"><button _ngcontent-sc76="" type="submit" role="button" tabindex="0" class="btn btn-primary search-button"><i _ngcontent-sc76="" class="fas fa-search"></i> Buscar</button></span></div></div></form></ds-search-form></div><ds-botones-home _ngcontent-sc250="" _nghost-sc248=""><div _ngcontent-sc248="" class="mt-ncs"><div _ngcontent-sc248="" class="container"><div _ngcontent-sc248="" class="jumbotron jumbotron-fluid"><div _ngcontent-sc248="" class="row d-flex justify-content-between"><div _ngcontent-sc248="" class="col-6 col-md-2 mb-2"><div _ngcontent-sc248="" class="rectangulo" style="background-color: #8abe42;"><a _ngcontent-sc248="" routerlink="/community-list" href="/community-list">Comunidades y colecciones</a></div></div><div _ngcontent-sc248="" class="col-6 col-md-2 mb-2"><div _ngcontent-sc248="" class="rectangulo" style="background-color: #52abca;"><a _ngcontent-sc248="" routerlink="/browse/subject" href="/browse/subject">Temas</a></div></div><div _ngcontent-sc248="" class="col-6 col-md-2 mb-2"><div _ngcontent-sc248="" class="rectangulo" style="background-color: #a6a6a6;"><a _ngcontent-sc248="" routerlink="/browse/author" href="/browse/author">Autores</a></div></div><div _ngcontent-sc248="" class="col-6 col-md-2 mb-2"><div _ngcontent-sc248="" class="rectangulo" style="background-color: #ef7e26;"><a _ngcontent-sc248="" routerlink="/browse/dateissued" href="/browse/dateissued">Fecha de publicación</a></div></div><div _ngcontent-sc248="" class="col-6 col-md-2 mb-2"><div _ngcontent-sc248="" class="rectangulo" style="background-color: #e4201c;"><a _ngcontent-sc248="" routerlink="/statistics" href="/statistics">Estadísticas</a></div></div></div></div></div></div></ds-botones-home><ds-colecciones-destacadas _ngcontent-sc250="" _nghost-sc249=""><div _ngcontent-sc249="" class="jumbotron jumbotron-fluid colecciones-dest"><div _ngcontent-sc249="" class="separator my-4"></div><h2 _ngcontent-sc249="" class="mb-4">Colecciones Destacadas</h2><div _ngcontent-sc249="" class="d-flex flex-column"><div _ngcontent-sc249="" class="mb-3 links"><a _ngcontent-sc249="" class="d-block" href="/communities/d078a191-d4bc-4a6e-9c8c-9afcc1e58829"><p _ngcontent-sc249="" class="lead">Datos de Investigación</p><p _ngcontent-sc249="" class="sublead">Los datos de investigación son la información recopilada durante un estudio o experimento, que sirve para analizar y responder preguntas o hipótesis planteadas.</p></a></div><div _ngcontent-sc249="" class="mb-3 links"><a _ngcontent-sc249="" class="d-block" href="/proyectoCienciaCiudadana"><p _ngcontent-sc249="" class="lead">Proyectos sobre Ciencia Ciudadana</p><p _ngcontent-sc249="" class="sublead">Los Proyectos sobre Ciencia Ciudadana vinculan la ciencia con la sociedad, fomentando la educación científica y la producción de conocimiento colaborativo orientado a abordar problemáticas locales y globales.</p></a></div><div _ngcontent-sc249="" class="mb-3 links"><a _ngcontent-sc249="" class="d-block" href="/communities/1d3738e2-750e-4368-b61c-7df4980623f7"><p _ngcontent-sc249="" class="lead">Colección del Herbario del Museo Botánico de Córdoba</p><p _ngcontent-sc249="" class="sublead">El Herbario CORD (de la Universidad Nacional de Córdoba) reúne colecciones de plantas secas, principalmente de la flora de Argentina y regiones cercanas.</p></a></div><div _ngcontent-sc249="" class="mb-3 links"><a _ngcontent-sc249="" class="d-block" href="/collections/36620a05-080a-44cb-86b8-7269a0ef065c"><p _ngcontent-sc249="" class="lead">Jornadas de Inteligencia Artificial en la Universidad Nacional de Córdoba</p><p _ngcontent-sc249="" class="sublead">Colección de artículos presentados en las Segundas Jornadas de Inteligencia Artificial “Conviviendo con la IA”, organizadas por la Universidad Nacional de Córdoba en 2024. Reúne aportes de especialistas y referentes que abordan, desde una perspectiva interdisciplinaria, el ciclo de vida, los desafíos y el impacto de la inteligencia artificial.</p></a></div></div></div></ds-colecciones-destacadas></div></div></div></ds-home-news><!----></ds-themed-home-news><div _ngcontent-sc464="" class="container"><ds-recent-item-list _ngcontent-sc464="" _nghost-sc463="" class="ng-tns-c463-2 ng-star-inserted"><div _ngcontent-sc463="" class="mt-4 ng-tns-c463-2 ng-trigger ng-trigger-fadeIn hide-placeholder-text ng-star-inserted" style=""><div _ngcontent-sc463="" class="d-flex flex-row border-bottom mb-4 pb-4 ng-tns-c463-2"></div><h2 _ngcontent-sc463="" class="ng-tns-c463-2"> Envíos recientes</h2><ul _ngcontent-sc463="" class="list-unstyled m-0 p-0 ng-tns-c463-2"><li _ngcontent-sc463="" class="my-4 ng-tns-c463-2 ng-star-inserted" style=""><ds-listable-object-component-loader _ngcontent-sc463="" class="pb-4 ng-tns-c463-2" _nghost-sc39=""><ds-item-list-element _nghost-sc55="" class="ng-star-inserted"><ds-listable-object-component-loader _ngcontent-sc55="" _nghost-sc39=""><ds-item-search-result-list-element _nghost-sc134="" class="ng-star-inserted"><div _ngcontent-sc134="" class="row"><div _ngcontent-sc134="" class="col-3 col-md-2 ng-star-inserted"><a _ngcontent-sc134="" role="link" tabindex="-1" class="dont-break-out ng-star-inserted" href="/items/0291a579-b392-4d77-a187-32f4b0a43de3" target="_self"><ds-thumbnail _ngcontent-sc134="" _nghost-sc74=""><div _ngcontent-sc74="" class="thumbnail limit-width"><div _ngcontent-sc74="" class="thumbnail-content outer ng-star-inserted"><div _ngcontent-sc74="" class="inner"><div _ngcontent-sc74="" class="centered"><ds-themed-loading _ngcontent-sc74="" data-used-theme="base"><ds-loading _nghost-sc73="" class="ng-star-inserted"><!----><div _ngcontent-sc73="" role="status" aria-live="polite" class="spinner spinner-border ng-star-inserted"><span _ngcontent-sc73="" class="sr-only">Cargando...</span></div><!----></ds-loading><!----></ds-themed-loading></div></div></div><!----><img _ngcontent-sc74="" class="thumbnail-content img-fluid d-none ng-star-inserted" src="" alt="Miniatura"><!----><!----></div></ds-thumbnail></a><!----><!----></div><!----><div _ngcontent-sc134="" class="col-9"><div _ngcontent-sc134="" class="d-flex"><ds-themed-badges _ngcontent-sc134="" class="ng-star-inserted" data-used-theme="base"><ds-badges _nghost-sc168="" class="ng-star-inserted"><ds-themed-status-badge _ngcontent-sc168="" data-used-theme="base"><ds-status-badge class="ng-star-inserted"><!----><!----></ds-status-badge><!----></ds-themed-status-badge><!----><div _ngcontent-sc168=""><ds-themed-type-badge _ngcontent-sc168="" class="pr-1" data-used-theme="base"><ds-type-badge class="ng-star-inserted"><span class="ng-star-inserted"><span class="badge badge-info"><span class="sr-only">Item type:</span> Ítem <span class="sr-only">, </span></span></span><!----></ds-type-badge><!----></ds-themed-type-badge><ds-themed-access-status-badge _ngcontent-sc168="" class="ng-star-inserted" data-used-theme="base"><ds-access-status-badge _nghost-sc132="" class="ng-star-inserted"><!----></ds-access-status-badge><!----></ds-themed-access-status-badge><!----><!----></div></ds-badges><!----></ds-themed-badges><!----></div><ds-truncatable _ngcontent-sc134="" _nghost-sc85="" class="ng-star-inserted"><div _ngcontent-sc85=""><a _ngcontent-sc134="" role="link" tabindex="0" class="lead item-list-title dont-break-out ng-star-inserted" href="/items/0291a579-b392-4d77-a187-32f4b0a43de3" target="_self">Relación entre variables y sequías meteorológicas e hidrológicas en la cuenca del río Carcarañá, Argentina</a><!----><!----><span _ngcontent-sc134="" class="text-muted"><ds-truncatable-part _ngcontent-sc134="" _nghost-sc86=""><div _ngcontent-sc86="" class="clamp-default-1 min-1"><div _ngcontent-sc86="" class="content dont-break-out preserve-line-breaks removeFaded"> (<!----><!----><span _ngcontent-sc134="" class="item-list-date ng-star-inserted">2018</span><!---->) <!----><!----><span _ngcontent-sc134="" class="item-list-authors ng-star-inserted"><span _ngcontent-sc134="" class="ng-star-inserted"><span _ngcontent-sc134="">Vicario, Leticia</span><span _ngcontent-sc134="" class="ng-star-inserted">; </span><!----></span><span _ngcontent-sc134="" class="ng-star-inserted"><span _ngcontent-sc134="">García, Carlos M.</span><!----></span><!----></span><!----></div><button _ngcontent-sc86="" dsdragclick="" role="button" tabindex="0" class="btn btn-link expandButton p-0" aria-expanded="false"><i _ngcontent-sc86="" class="fa-angle-down fas"></i><span _ngcontent-sc86="" class="ml-1">Más...</span></button></div></ds-truncatable-part></span><div _ngcontent-sc134="" class="item-list-abstract ng-star-inserted"><ds-truncatable-part _ngcontent-sc134="" _nghost-sc86=""><div _ngcontent-sc86="" class="clamp-default-3 min-3"><div _ngcontent-sc86="" class="content dont-break-out preserve-line-breaks removeFaded"><span _ngcontent-sc134="">La escasez de precipitaciones en un área y en un período de tiempo determinado constituye un procesohidrológico extremo denominado ?sequía?. Las sequías se clasifican según la variable utilizada o elobjetivo de estudio. Específicamente en la Región Centro de Argentina, los antecedentes sobre larelación entre distintos tipos de sequías, son escasos. Dado la importancia socioeconómica de dicharegión dentro del país, el análisis y evaluación de las relaciones temporales entre las variablesrepresentativas lluvia y caudal adquiere gran relevancia en el plano de los Recursos Hídricos, ademásde su relevancia en el estudio de los fenómenos hidrológicos extremos, tales como los distintos tiposde sequía. Debido a esto, el presente estudio evalúa la relación entre variables e índicesrepresentativos de sequías meteorológicas e hidrológicas en una cuenca de gran tamaño y de llanura,denominada cuenca del río Carcarañá, dentro de la mencionada región. Con el fin de lograr una mejorcobertura espacial de los datos de precipitación se utilizaron valores estimados a través de la TRMMy datos observados de caudales en una estación hidrométrica en la cuenca. Se utilizaron los índicesde sequías meteorológica (SPI) e hidrológica (SDI) y para establecer la relación entre las variables eíndices se utilizó el coeficiente de correlación. En la cuenca del río Carcarañá se observaron algunasparticularidades y correlaciones aceptables.</span></div><button _ngcontent-sc86="" dsdragclick="" role="button" tabindex="0" class="btn btn-link expandButton p-0" aria-expanded="false"><i _ngcontent-sc86="" class="fa-angle-down fas"></i><span _ngcontent-sc86="" class="ml-1">Más...</span></button></div></ds-truncatable-part></div><!----></div></ds-truncatable><!----></div></div></ds-item-search-result-list-element><!----></ds-listable-object-component-loader></ds-item-list-element><!----></ds-listable-object-component-loader></li><li _ngcontent-sc463="" class="my-4 ng-tns-c463-2 ng-star-inserted" style=""><ds-listable-object-component-loader _ngcontent-sc463="" class="pb-4 ng-tns-c463-2" _nghost-sc39=""><ds-item-list-element _nghost-sc55="" class="ng-star-inserted"><ds-listable-object-component-loader _ngcontent-sc55="" _nghost-sc39=""><ds-item-search-result-list-element _nghost-sc134="" class="ng-star-inserted"><div _ngcontent-sc134="" class="row"><div _ngcontent-sc134="" class="col-3 col-md-2 ng-star-inserted"><a _ngcontent-sc134="" role="link" tabindex="-1" class="dont-break-out ng-star-inserted" href="/items/d0d0f8bc-dde6-4d65-bb4e-59aeb7f61935" target="_self"><ds-thumbnail _ngcontent-sc134="" _nghost-sc74=""><div _ngcontent-sc74="" class="thumbnail limit-width"><div _ngcontent-sc74="" class="thumbnail-content outer ng-star-inserted"><div _ngcontent-sc74="" class="inner"><div _ngcontent-sc74="" class="centered"><ds-themed-loading _ngcontent-sc74="" data-used-theme="base"><ds-loading _nghost-sc73="" class="ng-star-inserted"><!----><div _ngcontent-sc73="" role="status" aria-live="polite" class="spinner spinner-border ng-star-inserted"><span _ngcontent-sc73="" class="sr-only">Cargando...</span></div><!----></ds-loading><!----></ds-themed-loading></div></div></div><!----><img _ngcontent-sc74="" class="thumbnail-content img-fluid d-none ng-star-inserted" src="" alt="Miniatura"><!----><!----></div></ds-thumbnail></a><!----><!----></div><!----><div _ngcontent-sc134="" class="col-9"><div _ngcontent-sc134="" class="d-flex"><ds-themed-badges _ngcontent-sc134="" class="ng-star-inserted" data-used-theme="base"><ds-badges _nghost-sc168="" class="ng-star-inserted"><ds-themed-status-badge _ngcontent-sc168="" data-used-theme="base"><ds-status-badge class="ng-star-inserted"><!----><!----></ds-status-badge><!----></ds-themed-status-badge><!----><div _ngcontent-sc168=""><ds-themed-type-badge _ngcontent-sc168="" class="pr-1" data-used-theme="base"><ds-type-badge class="ng-star-inserted"><span class="ng-star-inserted"><span class="badge badge-info"><span class="sr-only">Item type:</span> Ítem <span class="sr-only">, </span></span></span><!----></ds-type-badge><!----></ds-themed-type-badge><ds-themed-access-status-badge _ngcontent-sc168="" class="ng-star-inserted" data-used-theme="base"><ds-access-status-badge _nghost-sc132="" class="ng-star-inserted"><!----></ds-access-status-badge><!----></ds-themed-access-status-badge><!----><!----></div></ds-badges><!----></ds-themed-badges><!----></div><ds-truncatable _ngcontent-sc134="" _nghost-sc85="" class="ng-star-inserted"><div _ngcontent-sc85=""><a _ngcontent-sc134="" role="link" tabindex="0" class="lead item-list-title dont-break-out ng-star-inserted" href="/items/d0d0f8bc-dde6-4d65-bb4e-59aeb7f61935" target="_self">La Longitud de Arco Afín</a><!----><!----><span _ngcontent-sc134="" class="text-muted"><ds-truncatable-part _ngcontent-sc134="" _nghost-sc86=""><div _ngcontent-sc86="" class="clamp-default-1 min-1"><div _ngcontent-sc86="" class="content dont-break-out preserve-line-breaks removeFaded"> (<!----><!----><span _ngcontent-sc134="" class="item-list-date ng-star-inserted">2018</span><!---->) <!----><!----><span _ngcontent-sc134="" class="item-list-authors ng-star-inserted"><span _ngcontent-sc134="" class="ng-star-inserted"><span _ngcontent-sc134="">Gigena, Salvador D. R.</span><span _ngcontent-sc134="" class="ng-star-inserted">; </span><!----></span><span _ngcontent-sc134="" class="ng-star-inserted"><span _ngcontent-sc134="">Abud, Daniel J.A.</span><!----></span><!----></span><!----></div><button _ngcontent-sc86="" dsdragclick="" role="button" tabindex="0" class="btn btn-link expandButton p-0" aria-expanded="false"><i _ngcontent-sc86="" class="fa-angle-down fas"></i><span _ngcontent-sc86="" class="ml-1">Más...</span></button></div></ds-truncatable-part></span><div _ngcontent-sc134="" class="item-list-abstract ng-star-inserted"><ds-truncatable-part _ngcontent-sc134="" _nghost-sc86=""><div _ngcontent-sc86="" class="clamp-default-3 min-3"><div _ngcontent-sc86="" class="content dont-break-out preserve-line-breaks removeFaded"><span _ngcontent-sc134="">En la geometría tradicional, la geometría afín se considera un tópico de estudio que se ubica entrela geometría euclidiana y la geometría proyectiva. Este trabajo propone introducir a lectores poco habituadosen geometrías no euclidianas, especialmente a los Ingenieros, en el estudio de estas geometrías (las que nonecesariamente son euclidianas). Específicamente, en el alcance y en las aplicaciones que tiene la GeometríaAfín en Ingeniería. Es un artículo de aplicación a la Ingeniería de la Matemática. Partiendo del concepto deLongitud de Arco Afín y su utilización en las mismas aplicaciones, particularmente, en la digitalización deimágenes planas. Posteriormente, estos conceptos serán ampliados para su utilización en la Teoría deCáscaras Afines, desarrollada por nosotros mismos en trabajos anteriores. Se sugiere la incorporación deconceptos de geometría diferencial en el curriculum de las carreras de Ingeniería.</span></div><button _ngcontent-sc86="" dsdragclick="" role="button" tabindex="0" class="btn btn-link expandButton p-0" aria-expanded="false"><i _ngcontent-sc86="" class="fa-angle-down fas"></i><span _ngcontent-sc86="" class="ml-1">Más...</span></button></div></ds-truncatable-part></div><!----></div></ds-truncatable><!----></div></div></ds-item-search-result-list-element><!----></ds-listable-object-component-loader></ds-item-list-element><!----></ds-listable-object-component-loader></li><li _ngcontent-sc463="" class="my-4 ng-tns-c463-2 ng-star-inserted" style=""><ds-listable-object-component-loader _ngcontent-sc463="" class="pb-4 ng-tns-c463-2" _nghost-sc39=""><ds-item-list-element _nghost-sc55="" class="ng-star-inserted"><ds-listable-object-component-loader _ngcontent-sc55="" _nghost-sc39=""><ds-item-search-result-list-element _nghost-sc134="" class="ng-star-inserted"><div _ngcontent-sc134="" class="row"><div _ngcontent-sc134="" class="col-3 col-md-2 ng-star-inserted"><a _ngcontent-sc134="" role="link" tabindex="-1" class="dont-break-out ng-star-inserted" href="/items/38f20cc6-f018-4982-89dd-e3f7d236370a" target="_self"><ds-thumbnail _ngcontent-sc134="" _nghost-sc74=""><div _ngcontent-sc74="" class="thumbnail limit-width"><div _ngcontent-sc74="" class="thumbnail-content outer ng-star-inserted"><div _ngcontent-sc74="" class="inner"><div _ngcontent-sc74="" class="centered"><ds-themed-loading _ngcontent-sc74="" data-used-theme="base"><ds-loading _nghost-sc73="" class="ng-star-inserted"><!----><div _ngcontent-sc73="" role="status" aria-live="polite" class="spinner spinner-border ng-star-inserted"><span _ngcontent-sc73="" class="sr-only">Cargando...</span></div><!----></ds-loading><!----></ds-themed-loading></div></div></div><!----><img _ngcontent-sc74="" class="thumbnail-content img-fluid d-none ng-star-inserted" src="" alt="Miniatura"><!----><!----></div></ds-thumbnail></a><!----><!----></div><!----><div _ngcontent-sc134="" class="col-9"><div _ngcontent-sc134="" class="d-flex"><ds-themed-badges _ngcontent-sc134="" class="ng-star-inserted" data-used-theme="base"><ds-badges _nghost-sc168="" class="ng-star-inserted"><ds-themed-status-badge _ngcontent-sc168="" data-used-theme="base"><ds-status-badge class="ng-star-inserted"><!----><!----></ds-status-badge><!----></ds-themed-status-badge><!----><div _ngcontent-sc168=""><ds-themed-type-badge _ngcontent-sc168="" class="pr-1" data-used-theme="base"><ds-type-badge class="ng-star-inserted"><span class="ng-star-inserted"><span class="badge badge-info"><span class="sr-only">Item type:</span> Ítem <span class="sr-only">, </span></span></span><!----></ds-type-badge><!----></ds-themed-type-badge><ds-themed-access-status-badge _ngcontent-sc168="" class="ng-star-inserted" data-used-theme="base"><ds-access-status-badge _nghost-sc132="" class="ng-star-inserted"><!----></ds-access-status-badge><!----></ds-themed-access-status-badge><!----><!----></div></ds-badges><!----></ds-themed-badges><!----></div><ds-truncatable _ngcontent-sc134="" _nghost-sc85="" class="ng-star-inserted"><div _ngcontent-sc85=""><a _ngcontent-sc134="" role="link" tabindex="0" class="lead item-list-title dont-break-out ng-star-inserted" href="/items/38f20cc6-f018-4982-89dd-e3f7d236370a" target="_self">Tropospheric degradation of long-chain aldehydes initiated by cl atoms and their atmospheric implications</a><!----><!----><span _ngcontent-sc134="" class="text-muted"><ds-truncatable-part _ngcontent-sc134="" _nghost-sc86=""><div _ngcontent-sc86="" class="clamp-default-1 min-1"><div _ngcontent-sc86="" class="content dont-break-out preserve-line-breaks removeFaded"> (<!----><!----><span _ngcontent-sc134="" class="item-list-date ng-star-inserted">2022</span><!---->) <!----><!----><span _ngcontent-sc134="" class="item-list-authors ng-star-inserted"><span _ngcontent-sc134="" class="ng-star-inserted"><span _ngcontent-sc134="">Aguirre, Fabricio </span><span _ngcontent-sc134="" class="ng-star-inserted">; </span><!----></span><span _ngcontent-sc134="" class="ng-star-inserted"><span _ngcontent-sc134="">Blanco, María Belén</span><span _ngcontent-sc134="" class="ng-star-inserted">; </span><!----></span><span _ngcontent-sc134="" class="ng-star-inserted"><span _ngcontent-sc134="">Teruel, Mariano Andrés</span><!----></span><!----></span><!----></div><button _ngcontent-sc86="" dsdragclick="" role="button" tabindex="0" class="btn btn-link expandButton p-0" aria-expanded="false"><i _ngcontent-sc86="" class="fa-angle-down fas"></i><span _ngcontent-sc86="" class="ml-1">Más...</span></button></div></ds-truncatable-part></span><div _ngcontent-sc134="" class="item-list-abstract ng-star-inserted"><ds-truncatable-part _ngcontent-sc134="" _nghost-sc86=""><div _ngcontent-sc86="" class="clamp-default-3 min-3"><div _ngcontent-sc86="" class="content dont-break-out preserve-line-breaks removeFaded"><span _ngcontent-sc134="">Los aldehídos son constituyentes químicos gaseosos omnipresentes en la atmósfera y provienen de diversas fuentes. Se originan, por ejemplo, a partir de la combustión incompleta de combustibles fósiles; también son emitidos por la vegetación y producidos durante la quema de biomasa. Asimismo, la oxidación fotoquímica de la mayoría de los compuestos orgánicos volátiles (COV) en la atmósfera da lugar, en cierta medida, a la formación de aldehídos. Los aldehídos pueden sufrir fotólisis y/o reaccionar con oxidantes atmosféricos típicos, como los radicales OH y NO3; además, en la capa límite marina y en regiones costeras, pueden reaccionar con átomos de cloro (Cl). Objetivos: Estudiar las constantes de velocidad en fase gaseosa de las reacciones de tres aldehídos saturados con átomos de Cl y estimar sus tiempos de vida en la troposfera. Los compuestos estudiados fueron heptanal (C7H14O), octanal (C8H16O) y nonanal (C9H18O). Materiales y métodos: Los experimentos se llevaron a cabo utilizando una cámara de simulación atmosférica («smog chamber») de 405 L, acoplada a un sistema de cromatografía de gases con detección por ionización de llama (GC-FID), para monitorear la disminución de la concentración de los aldehídos en relación con diversos compuestos de referencia, empleando el método relativo. Resultados: Se obtuvieron los siguientes valores para las constantes de velocidad de las reacciones estudiadas (cm³ molécula⁻¹ s⁻¹): k1 (Cl + CH3(CH2)5C(O)H) = (3,0 ± 0,5) × 10⁻¹⁰; k2 (Cl + CH3(CH2)6C(O)H) = (2,9 ± 0,5) × 10⁻¹⁰; k3 (Cl + CH3(CH2)7C(O)H) = (3,2 ± 0,6) × 10⁻¹⁰. Además, se calcularon los tiempos de vida troposféricos de los aldehídos mediante la siguiente ecuación: τCl = 1/(kCl [Cl]). Donde [Cl] = 1×10⁴ moléculas/cm³. Los tiempos de vida atmosféricos estimados fueron de 93, 96 y 87 horas para el heptanal, el octanal y el nonanal, respectivamente. Conclusiones: Se presenta el primer estudio cinético de las reacciones del octanal y el nonanal con Cl. No se observó fotólisis de los aldehídos bajo las condiciones experimentales empleadas. Los tiempos de vida troposféricos de estos aldehídos, de entre 3 y 4 días, indican que podrían ser transportados a otros lugares, generando un impacto a nivel local y regional.</span></div><button _ngcontent-sc86="" dsdragclick="" role="button" tabindex="0" class="btn btn-link expandButton p-0" aria-expanded="false"><i _ngcontent-sc86="" class="fa-angle-down fas"></i><span _ngcontent-sc86="" class="ml-1">Más...</span></button></div></ds-truncatable-part></div><!----></div></ds-truncatable><!----></div></div></ds-item-search-result-list-element><!----></ds-listable-object-component-loader></ds-item-list-element><!----></ds-listable-object-component-loader></li><li _ngcontent-sc463="" class="my-4 ng-tns-c463-2 ng-star-inserted" style=""><ds-listable-object-component-loader _ngcontent-sc463="" class="pb-4 ng-tns-c463-2" _nghost-sc39=""><ds-item-list-element _nghost-sc55="" class="ng-star-inserted"><ds-listable-object-component-loader _ngcontent-sc55="" _nghost-sc39=""><ds-item-search-result-list-element _nghost-sc134="" class="ng-star-inserted"><div _ngcontent-sc134="" class="row"><div _ngcontent-sc134="" class="col-3 col-md-2 ng-star-inserted"><a _ngcontent-sc134="" role="link" tabindex="-1" class="dont-break-out ng-star-inserted" href="/items/aaaa1f43-a8f3-4563-90fa-24768aa7b144" target="_self"><ds-thumbnail _ngcontent-sc134="" _nghost-sc74=""><div _ngcontent-sc74="" class="thumbnail limit-width"><div _ngcontent-sc74="" class="thumbnail-content outer ng-star-inserted"><div _ngcontent-sc74="" class="inner"><div _ngcontent-sc74="" class="centered"><ds-themed-loading _ngcontent-sc74="" data-used-theme="base"><ds-loading _nghost-sc73="" class="ng-star-inserted"><!----><div _ngcontent-sc73="" role="status" aria-live="polite" class="spinner spinner-border ng-star-inserted"><span _ngcontent-sc73="" class="sr-only">Cargando...</span></div><!----></ds-loading><!----></ds-themed-loading></div></div></div><!----><img _ngcontent-sc74="" class="thumbnail-content img-fluid d-none ng-star-inserted" src="" alt="Miniatura"><!----><!----></div></ds-thumbnail></a><!----><!----></div><!----><div _ngcontent-sc134="" class="col-9"><div _ngcontent-sc134="" class="d-flex"><ds-themed-badges _ngcontent-sc134="" class="ng-star-inserted" data-used-theme="base"><ds-badges _nghost-sc168="" class="ng-star-inserted"><ds-themed-status-badge _ngcontent-sc168="" data-used-theme="base"><ds-status-badge class="ng-star-inserted"><!----><!----></ds-status-badge><!----></ds-themed-status-badge><!----><div _ngcontent-sc168=""><ds-themed-type-badge _ngcontent-sc168="" class="pr-1" data-used-theme="base"><ds-type-badge class="ng-star-inserted"><span class="ng-star-inserted"><span class="badge badge-info"><span class="sr-only">Item type:</span> Ítem <span class="sr-only">, </span></span></span><!----></ds-type-badge><!----></ds-themed-type-badge><ds-themed-access-status-badge _ngcontent-sc168="" class="ng-star-inserted" data-used-theme="base"><ds-access-status-badge _nghost-sc132="" class="ng-star-inserted"><!----></ds-access-status-badge><!----></ds-themed-access-status-badge><!----><!----></div></ds-badges><!----></ds-themed-badges><!----></div><ds-truncatable _ngcontent-sc134="" _nghost-sc85="" class="ng-star-inserted"><div _ngcontent-sc85=""><a _ngcontent-sc134="" role="link" tabindex="0" class="lead item-list-title dont-break-out ng-star-inserted" href="/items/aaaa1f43-a8f3-4563-90fa-24768aa7b144" target="_self">Contribución al estudio de las cicatrizaciones pulpares (aspectos clínicos, radiológicos, histológicos e histoquímicos)</a><!----><!----><span _ngcontent-sc134="" class="text-muted"><ds-truncatable-part _ngcontent-sc134="" _nghost-sc86=""><div _ngcontent-sc86="" class="clamp-default-1 min-1"><div _ngcontent-sc86="" class="content dont-break-out preserve-line-breaks removeFaded"> (<!----><!----><span _ngcontent-sc134="" class="item-list-date ng-star-inserted">1967</span><!---->) <!----><!----><span _ngcontent-sc134="" class="item-list-authors ng-star-inserted"><span _ngcontent-sc134="" class="ng-star-inserted"><span _ngcontent-sc134="">Fonseca, Miguel Mario</span><!----></span><!----></span><!----></div><button _ngcontent-sc86="" dsdragclick="" role="button" tabindex="0" class="btn btn-link expandButton p-0" aria-expanded="false"><i _ngcontent-sc86="" class="fa-angle-down fas"></i><span _ngcontent-sc86="" class="ml-1">Más...</span></button></div></ds-truncatable-part></span><div _ngcontent-sc134="" class="item-list-abstract ng-star-inserted"><ds-truncatable-part _ngcontent-sc134="" _nghost-sc86=""><div _ngcontent-sc86="" class="clamp-default-3 min-3"><div _ngcontent-sc86="" class="content dont-break-out preserve-line-breaks removeFaded"><span _ngcontent-sc134="">Se estudiaron 29 casos de heridas pulpares, algunas consecuentes a una simple exposición, y otras con amputaciones parciales a diferentes niveles. Se comprobó en la casi totalidad de los casos la cicatrización por dentina reparativa. La técnica empleada no difiere mucho de la convencional o clásica, pero ofrece ligeras varientes que han sido descriptas en el capítulo de material y métodos. Los casos utilizados fueron previamente diagnosticados desde el punto de vista elínico y radiográfico, con el objeto de conocer perfectamente los cuadros pulpares que enfrentamos. La formación de dentina reparativa, después de tratar la herida con suero fisiológico e hidróxido de calcio, en todos los usos fue corroborada por al estudio radiográfico e histológico. Estos últimos, más los estudios histoquímicos, han permitido extraer conclusiones interesantes entre las que podemos destacar que toda herida pulpar convenientemente tratada, puede cicatrizar favorablemente.</span></div><button _ngcontent-sc86="" dsdragclick="" role="button" tabindex="0" class="btn btn-link expandButton p-0" aria-expanded="false"><i _ngcontent-sc86="" class="fa-angle-down fas"></i><span _ngcontent-sc86="" class="ml-1">Más...</span></button></div></ds-truncatable-part></div><!----></div></ds-truncatable><!----></div></div></ds-item-search-result-list-element><!----></ds-listable-object-component-loader></ds-item-list-element><!----></ds-listable-object-component-loader></li><li _ngcontent-sc463="" class="my-4 ng-tns-c463-2 ng-star-inserted" style=""><ds-listable-object-component-loader _ngcontent-sc463="" class="pb-4 ng-tns-c463-2" _nghost-sc39=""><ds-item-list-element _nghost-sc55="" class="ng-star-inserted"><ds-listable-object-component-loader _ngcontent-sc55="" _nghost-sc39=""><ds-item-search-result-list-element _nghost-sc134="" class="ng-star-inserted"><div _ngcontent-sc134="" class="row"><div _ngcontent-sc134="" class="col-3 col-md-2 ng-star-inserted"><a _ngcontent-sc134="" role="link" tabindex="-1" class="dont-break-out ng-star-inserted" href="/items/bb93afc7-58aa-47ca-a111-4c9af30944ad" target="_self"><ds-thumbnail _ngcontent-sc134="" _nghost-sc74=""><div _ngcontent-sc74="" class="thumbnail limit-width"><div _ngcontent-sc74="" class="thumbnail-content outer ng-star-inserted"><div _ngcontent-sc74="" class="inner"><div _ngcontent-sc74="" class="centered"><ds-themed-loading _ngcontent-sc74="" data-used-theme="base"><ds-loading _nghost-sc73="" class="ng-star-inserted"><!----><div _ngcontent-sc73="" role="status" aria-live="polite" class="spinner spinner-border ng-star-inserted"><span _ngcontent-sc73="" class="sr-only">Cargando...</span></div><!----></ds-loading><!----></ds-themed-loading></div></div></div><!----><img _ngcontent-sc74="" class="thumbnail-content img-fluid d-none ng-star-inserted" src="" alt="Miniatura"><!----><!----></div></ds-thumbnail></a><!----><!----></div><!----><div _ngcontent-sc134="" class="col-9"><div _ngcontent-sc134="" class="d-flex"><ds-themed-badges _ngcontent-sc134="" class="ng-star-inserted" data-used-theme="base"><ds-badges _nghost-sc168="" class="ng-star-inserted"><ds-themed-status-badge _ngcontent-sc168="" data-used-theme="base"><ds-status-badge class="ng-star-inserted"><!----><!----></ds-status-badge><!----></ds-themed-status-badge><!----><div _ngcontent-sc168=""><ds-themed-type-badge _ngcontent-sc168="" class="pr-1" data-used-theme="base"><ds-type-badge class="ng-star-inserted"><span class="ng-star-inserted"><span class="badge badge-info"><span class="sr-only">Item type:</span> Ítem <span class="sr-only">, </span></span></span><!----></ds-type-badge><!----></ds-themed-type-badge><ds-themed-access-status-badge _ngcontent-sc168="" class="ng-star-inserted" data-used-theme="base"><ds-access-status-badge _nghost-sc132="" class="ng-star-inserted"><!----></ds-access-status-badge><!----></ds-themed-access-status-badge><!----><!----></div></ds-badges><!----></ds-themed-badges><!----></div><ds-truncatable _ngcontent-sc134="" _nghost-sc85="" class="ng-star-inserted"><div _ngcontent-sc85=""><a _ngcontent-sc134="" role="link" tabindex="0" class="lead item-list-title dont-break-out ng-star-inserted" href="/items/bb93afc7-58aa-47ca-a111-4c9af30944ad" target="_self">CAVAR, SONDEAR, TAPAR : experiencias laborales de los operarios de la construcción que trabajan en el Centro Histórico de la ciudad de Córdoba, en el marco del Plan Integral de Recuperación del Área Central (PRIAC)</a><!----><!----><span _ngcontent-sc134="" class="text-muted"><ds-truncatable-part _ngcontent-sc134="" _nghost-sc86=""><div _ngcontent-sc86="" class="clamp-default-1 min-1"><div _ngcontent-sc86="" class="content dont-break-out preserve-line-breaks removeFaded"> (<!----><!----><span _ngcontent-sc134="" class="item-list-date ng-star-inserted">2025-10-15</span><!---->) <!----><!----><span _ngcontent-sc134="" class="item-list-authors ng-star-inserted"><span _ngcontent-sc134="" class="ng-star-inserted"><span _ngcontent-sc134="">Pérez, María Sol</span><!----></span><!----></span><!----></div><button _ngcontent-sc86="" dsdragclick="" role="button" tabindex="0" class="btn btn-link expandButton p-0" aria-expanded="false"><i _ngcontent-sc86="" class="fa-angle-down fas"></i><span _ngcontent-sc86="" class="ml-1">Más...</span></button></div></ds-truncatable-part></span><div _ngcontent-sc134="" class="item-list-abstract ng-star-inserted"><ds-truncatable-part _ngcontent-sc134="" _nghost-sc86=""><div _ngcontent-sc86="" class="clamp-default-3 min-3"><div _ngcontent-sc86="" class="content dont-break-out preserve-line-breaks removeFaded"><span _ngcontent-sc134="">El presente trabajo pretende indagar en las experiencias laborales de los operarios de la construcción que trabajan en el Centro Histórico de la ciudad de Córdoba, en el marco del Plan Integral de Recuperación del Área Central (PRIAC) siendo éste parte de Respira Córdoba, un proyecto de impacto socio-ambiental. 
El punto de partida de este proyecto de trabajo final de licenciatura, reconoce la confluencia de problemáticas relacionadas con la gestión del espacio urbano, el mundo del trabajo, las esferas de las políticas públicas y las dinámicas particulares de la multiplicidad de agentes que intervienen en la construcción cotidiana del patrimonio. Procuraré acercarme a los aportes de una antropología del trabajo, centrándome en el estudio de las relaciones laborales y las prácticas para pensar las diversas formas en que el trabajo contribuye a forjar identidades individuales y colectivas, así como estructuras sociales más amplias.
Interesa, en última instancia, comprender cómo se dirimen las relaciones de poder en el mundo laboral y las interacciones cotidianas desde el punto de vista de los hombres que trabajan como operarios en el PRIAC.
En este contexto se tejen intrincadamente los pliegues de mi problema de investigación: ¿Cómo se configuran las experiencias laborales de los operarios de la construcción en relación al 'patrimonio', en el marco del Plan Integral de Recuperación del Área Central (PRIAC), en el Centro Histórico de Córdoba, en la actualidad?.</span></div><button _ngcontent-sc86="" dsdragclick="" role="button" tabindex="0" class="btn btn-link expandButton p-0" aria-expanded="false"><i _ngcontent-sc86="" class="fa-angle-down fas"></i><span _ngcontent-sc86="" class="ml-1">Más...</span></button></div></ds-truncatable-part></div><!----></div></ds-truncatable><!----></div></div></ds-item-search-result-list-element><!----></ds-listable-object-component-loader></ds-item-list-element><!----></ds-listable-object-component-loader></li><!----></ul><button _ngcontent-sc463="" role="link" tabindex="0" class="btn btn-primary search-button mt-4 ng-tns-c463-2"> Cargar más ... </button></div><!----><!----><!----><!----><!----></ds-recent-item-list><!----></div></ds-home-page><!----></ds-themed-home-page><!----></div></main><ds-themed-footer _ngcontent-sc221="" class="ng-tns-c221-0" data-used-theme="rdu"><ds-footer _nghost-sc200="" class="ng-star-inserted"><footer _ngcontent-sc200="" class="text-lg-start"><div _ngcontent-sc200="" class="top-footer"><div _ngcontent-sc200="" class="container p-4"><div _ngcontent-sc200="" class="row"><div _ngcontent-sc200="" class="col-lg-4 col-md-6 mb-4 mb-lg-0 col-6"><img _ngcontent-sc200="" src="assets/images/Logo-UNC-01.webp" class="img-unc" alt="footer.image.logo"></div><div _ngcontent-sc200="" class="col-lg-4 col-md-6 mb-4 mb-lg-0 bg col-6"><img _ngcontent-sc200="" src="assets/images/oca.webp" class="img-oca" alt="footer.image.logo"></div><div _ngcontent-sc200="" class="col-lg-4 col-md-12 mb-4 mb-md-0"><div _ngcontent-sc200="" class="bottom-footer p-1 d-flex justify-content-center align-items-center text-white"><div _ngcontent-sc200="" class="content-container"><ul _