ore/items/aaaa1f43-a8f3-4563-90fa-24768aa7b144/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://rdu.unc.edu.ar/server/api/core/items/aaaa1f43-a8f3-4563-90fa-24768aa7b144/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://rdu.unc.edu.ar/server/api/core/items/aaaa1f43-a8f3-4563-90fa-24768aa7b144/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://rdu.unc.edu.ar/server/api/core/items/aaaa1f43-a8f3-4563-90fa-24768aa7b144/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://rdu.unc.edu.ar/server/api/core/items/aaaa1f43-a8f3-4563-90fa-24768aa7b144/thumbnail&q;},&q;self&q;:{&q;href&q;:&q;https://rdu.unc.edu.ar/server/api/core/items/aaaa1f43-a8f3-4563-90fa-24768aa7b144&q;}},&q;_name&q;:&q;Contribución al estudio de las cicatrizaciones pulpares (aspectos clínicos, radiológicos, histológicos e histoquímicos)&q;,&q;id&q;:&q;aaaa1f43-a8f3-4563-90fa-24768aa7b144&q;,&q;uuid&q;:&q;aaaa1f43-a8f3-4563-90fa-24768aa7b144&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.advisor&q;:[{&q;uuid&q;:&q;2c978db7-f69c-4c6e-82ea-d7348de5dd23&q;,&q;language&q;:null,&q;value&q;:&q;Gendelman, Héctor&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;f326cfb4-39d4-4593-965b-60aef682bac8&q;,&q;language&q;:null,&q;value&q;:&q;Fonseca, Miguel Mario&q;,&q;place&q;:0,&q;authority&q;:&q;cbb2f8ad-92f0-489a-9aba-80087395fec9&q;,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;f0c92588-eddc-417e-88d4-fdf2b0defaf9&q;,&q;language&q;:null,&q;value&q;:&q;2026-10-27T16:24:04Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;7f9dc654-e4c0-41d3-8eba-a76c7040fbf7&q;,&q;language&q;:null,&q;value&q;:&q;2026-10-27T16:24:04Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;e72fd9d3-78b1-48db-a306-44dbd235160e&q;,&q;language&q;:null,&q;value&q;:&q;1967&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;1173b71b-e539-4798-8eea-374d775ecdc3&q;,&q;language&q;:null,&q;value&q;:&q;Se estudiaron 29 casos de heridas pulpares, algunas consecuentes a una simple exposición, y otras con amputaciones parciales a diferentes niveles. Se comprobó en la casi totalidad de los casos la cicatrización por dentina reparativa. La técnica empleada no difiere mucho de la convencional o clásica, pero ofrece ligeras varientes que han sido descriptas en el capítulo de material y métodos. Los casos utilizados fueron previamente diagnosticados desde el punto de vista elínico y radiográfico, con el objeto de conocer perfectamente los cuadros pulpares que enfrentamos. La formación de dentina reparativa, después de tratar la herida con suero fisiológico e hidróxido de calcio, en todos los usos fue corroborada por al estudio radiográfico e histológico. Estos últimos, más los estudios histoquímicos, han permitido extraer conclusiones interesantes entre las que podemos destacar que toda herida pulpar convenientemente tratada, puede cicatrizar favorablemente.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:0}],&q;dc.description.fil&q;:[{&q;uuid&q;:&q;609173f2-692f-4e30-a5d6-abcceb319ff4&q;,&q;language&q;:null,&q;value&q;:&q;Fil: Fonseca, Miguel Mario. Universidad Nacional de Córdoba. Facultad de Odontología; Argentina.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;62c8829f-b806-417e-8767-724ae49f00c3&q;,&q;language&q;:null,&q;value&q;:&q;http://hdl.handle.net/11086/563581&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;03852147-8f5f-4d5b-bd4e-697dbbf3961e&q;,&q;language&q;:null,&q;value&q;:&q;spa&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights&q;:[{&q;uuid&q;:&q;91a1db40-ddf0-4dee-b90b-7334d7df876a&q;,&q;language&q;:null,&q;value&q;:&q;Atribución-NoComercial-CompartirIgual 4.0 Internacional&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.subject&q;:[{&q;uuid&q;:&q;2e5693e9-6a40-4aa3-9d5f-05320a0f3165&q;,&q;language&q;:null,&q;value&q;:&q;Cicatrizaciones pulpares&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;56f3a72e-088e-457b-a131-fb391a491374&q;,&q;language&q;:null,&q;value&q;:&q;Contribución al estudio de las cicatrizaciones pulpares (aspectos clínicos, radiológicos, histológicos e histoquímicos)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;8516203e-0fe8-484c-b48c-f50d0b3e8634&q;,&q;language&q;:null,&q;value&q;:&q;doctoralThesis&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}]}},&q;timeCompleted&q;:1793275756053,&q;msToLive&q;:900000,&q;requestUUIDs&q;:[&q;client/10e7f835-708a-4a6d-8c74-a4d9dc7ed6a8&q;],&q;dependentRequestUUIDs&q;:[],&q;isDirty&q;:false,&q;patches&q;:[],&q;alternativeLinks&q;:[]},&q;https://rdu.unc.edu.ar/server/api/core/bitstreams/c2ba1aeb-e8cf-4a32-a120-8c9fa9036614&q;:{&q;data&q;:{&q;sizeBytes&q;:310718,&q;bundleName&q;:&q;THUMBNAIL&q;,&q;_links&q;:{&q;content&q;:{&q;href&q;:&q;https://rdu.unc.edu.ar/server/api/core/bitstreams/c2ba1aeb-e8cf-4a32-a120-8c9fa9036614/content&q;},&q;bundle&q;:{&q;href&q;:&q;https://rdu.unc.edu.ar/server/api/core/bitstreams/c2ba1aeb-e8cf-4a32-a120-8c9fa9036614/bundle&q;},&q;format&q;:{&q;href&q;:&q;https://rdu.unc.edu.ar/server/api/core/bitstreams/c2ba1aeb-e8cf-4a32-a120-8c9fa9036614/format&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://rdu.unc.edu.ar/server/api/core/bitstreams/c2ba1aeb-e8cf-4a32-a120-8c9fa9036614/thumbnail&q;},&q;self&q;:{&q;href&q;:&q;https://rdu.unc.edu.ar/server/api/core/bitstreams/c2ba1aeb-e8cf-4a32-a120-8c9fa9036614&q;}},&q;_name&q;:&q;Tesis Sol Perez-1_page-0001.jpg&q;,&q;id&q;:&q;c2ba1aeb-e8cf-4a32-a120-8c9fa9036614&q;,&q;uuid&q;:&q;c2ba1aeb-e8cf-4a32-a120-8c9fa9036614&q;,&q;type&q;:&q;bitstream&q;,&q;metadata&q;:{&q;dc.title&q;:[{&q;uuid&q;:&q;9da843de-39b4-44d9-b1a7-aee707f1c7f8&q;,&q;language&q;:nul